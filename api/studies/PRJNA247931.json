{"study_accession":"PRJNA247931","secondary_study_accession":"SRP042027","title":"Noninvasive in vivo monitoring of tissue-specific global gene expression in humans","description":"Circulating cell-free RNA in the blood provides a potential window into the health, phenotype, and developmental programs of a variety of human organs. We used high-throughput methods of RNA analysis such as microarrays and next-generation sequencing to characterize the global landscape of circulating RNA in human subjects. By focusing on tissue-specific genes, we were able to identify the relative contributions of these tissues to circulating RNA and monitor changes during tissue development and neurodegenerative disease states.","pubmed":"24799715","geo_series":"","n_samples":48,"samples":[{"sample_accession":"SAMN02781381","study_accession":"PRJNA247931","blood_class":"whole_blood","class_from":"sample","title":"Human sample from Homo sapiens","description":"Human sample from Homo sapiens","sex":"female","geo_sample":"","access":"open","dbgap":"","n_runs":1,"first_public":"2014-08-11","attributes":[["isolate","Patient 2"],["age","Trimester 1"],["biomaterial_provider","Stephen Quake"],["sex","female"],["tissue","Blood"]],"runs":[{"run_accession":"SRR1296036","experiment_accession":"SRX544923","library_layout":"SINGLE","library_selection":"RANDOM","instrument_model":"Illumina Genome Analyzer II","read_count":26862136,"base_count":725277672,"first_public":"2014-08-11","experiment_title":"Illumina Genome Analyzer II sequencing: RNA-seq of Patient 2 : Trimester 1"}],"labels":[]},{"sample_accession":"SAMN02781382","study_accession":"PRJNA247931","blood_class":"whole_blood","class_from":"sample","title":"Human sample from Homo sapiens","description":"Human sample from Homo sapiens","sex":"female","geo_sample":"","access":"open","dbgap":"","n_runs":1,"first_public":"2014-08-11","attributes":[["isolate","Patient 2"],["age","Trimester 2"],["biomaterial_provider","Stephen Quake"],["sex","female"]