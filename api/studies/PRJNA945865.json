{"study_accession":"PRJNA945865","secondary_study_accession":"SRP427936","title":"Effects of Dexamethasone in COVID-19 patients","description":"Dexamethasone improves the survival of COVID-19 patients in need of supplemental oxygen therapy. Hospitalized COVID-19 patients eligible for dexamethasone therapy were recruited from the general care ward in several centers in Greece and the Netherlands and whole blood transcriptomic analysis was performed before and after starting dexamethasone treatment. Peripheral blood mononuclear cells (PBMCs) were isolated from healthy individuals and COVID-19 patients and stimulated with inactivated SARS-CoV-2 ex vivo in the presence or absence of dexamethasone and their transcriptome was assessed. Overall design: 114 samples","pubmed":"37614228","geo_series":"","n_samples":57,"samples":[{"sample_accession":"SAMN33799373","study_accession":"PRJNA945865","blood_class":"pbmc","class_from":"sample","title":"HC059, DEX_SARS","description":"HC059, DEX_SARS","sex":"","geo_sample":"GSM7103558","access":"open","dbgap":"","n_runs":1,"first_public":"2023-08-27","attributes":[["source_name","PBMC"],["cell_type","PBMC"],["treatment","Dexamethasone + Sars-Cov-2"],["geo_loc_name","missing"],["collection_date","missing"]],"runs":[{"run_accession":"SRR23900203","experiment_accession":"SRX19712025","library_layout":"PAIRED","library_selection":"cDNA","instrument_model":"DNBSEQ-G400","read_count":35536841,"base_count":7107368200,"first_public":"2023-08-27","experiment_title":"DNBSEQ-G400 sequencing: GSM7103558: HC059, DEX_SARS Homo sapiens RNA-Seq"}],"labels":[],"single_cell":false},{"sample_accession":"SAMN33799374","study_accession":"PRJNA945865","blood_class":"pbmc","class_from":"sample","title":"HC044, DEX_SARS","description":"HC044, DEX_SARS","sex":"","geo_sample":"GSM7103557","access":"open","dbgap":"","n_runs":1,"first_public":"2023-08-27","attributes":[["source_name","PBMC"],["cell_type","PBMC"],["treatment","Dexamethasone + Sars-Cov-2"],["geo_