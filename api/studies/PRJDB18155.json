{"study_accession":"PRJDB18155","secondary_study_accession":"DRP011694","title":"RNA sequencing and analysis of human eosinophils stimulated with interferons","description":"Activated eosinophils is a major cell type to be involved in allergic diseases. Type 2 cytokines (IL-4 and IL-5) are important to establish and augment its inflammatory process. In addition, type 1, 2, and 3 interferons (interferon-alpha/beta, gamma, lambda) regulate allergic inflammation. However, their direct effects on human eosinophils remain fully uncovered. The aim of this study is to clarify the role of these cytokines as direct regulators for human eosinophils.","pubmed":"38958441","geo_series":"","n_samples":16,"samples":[{"sample_accession":"SAMD00787826","study_accession":"PRJDB18155","blood_class":"blood_cells","class_from":"sample","title":"DK22231_01","description":"HP1 Human eosinophils, non-stimulated","sex":"not collected","geo_sample":"","access":"open","dbgap":"","n_runs":1,"first_public":"2024-06-30","attributes":[["collection_date","2023-04-13"],["health_state","healthy"],["INSDC secondary accession","DRS391645"],["aliquot","1"],["ethnicity","Japanese"],["organism","Homo sapiens"],["race","Asian"],["sex","not collected"],["tissue","blood"],["sample_type","primary cell"],["isolate","Keio University"],["NCBI submission package","Human.1.0"],["geo_loc_name","Japan:Tokyo, Shinjuku-ku, Shinanomachi"],["cell_subtype","white blood cell"],["cell_type","eosinophil"],["age","not collected"],["biomaterial_provider","Keio University"],["sample_name","I-Medium-1"],["BioSampleModel","Human"],["ENA-FIRST-PUBLIC","2024-06-20"],["ENA-LAST-UPDATE","2024-06-23"]],"runs":[{"run_accession":"DRR568476","experiment_accession":"DRX551943","library_layout":"SINGLE","library_selection":"cDNA","instrument_model":"NextSeq 500","read_count":2787231,"base_count":211829556,"first_public":"2024-06-30","experiment_title":"NextSeq 500 sequencing: NextSeq 500 sequencing of SAMD00787826"}],"labels":[],"single_