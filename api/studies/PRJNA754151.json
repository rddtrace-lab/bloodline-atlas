{"study_accession":"PRJNA754151","secondary_study_accession":"SRP332281","title":"RNA-seq of Lin-CD34+ cord-blood cells expressing shRNA against PLAG1 or control [KD]","description":"To characterize transcriptional changes associated with loss of the transcription factor PLAG1-S that could contribute to PLAG1 essentiality in long-term human HSC we performed RNA-seq of 2 pools of Lin-CD34+ cord-blood derived hematopoietic stem and progenitor cells 72 hours following lentiviral introduction of shRNA against PLAG1 or non-targeting control. Overall design: Lin-CD34+ samples from 2 biologically distinct pools of CB were transduced to express shPLAG1 or shControl, and 72 hours following viral introduction transduction marker positive cells were FACS-isolated for bulk RNA-seq.","pubmed":"35639948","geo_series":"","n_samples":4,"samples":[{"sample_accession":"SAMN20745971","study_accession":"PRJNA754151","blood_class":"cord_blood","class_from":"sample","title":"PLAG1 knockdown-1","description":"PLAG1 knockdown-1","sex":"","geo_sample":"GSM5515754","access":"open","dbgap":"","n_runs":1,"first_public":"2022-12-06","attributes":[["source_name","Human Cord Blood"],["cell_type","Lin-CD34+ HSPCs"],["shRNA","PLAG1 knockdown"]],"runs":[{"run_accession":"SRR15427735","experiment_accession":"SRX11729101","library_layout":"PAIRED","library_selection":"cDNA","instrument_model":"Illumina HiSeq 2000","read_count":23487733,"base_count":4697546600,"first_public":"2022-12-06","experiment_title":"Illumina HiSeq 2000 sequencing: GSM5515754: PLAG1 knockdown-1 Homo sapiens RNA-Seq"}],"labels":[]},{"sample_accession":"SAMN20745972","study_accession":"PRJNA754151","blood_class":"cord_blood","class_from":"sample","title":"PLAG1 knockdown-2","description":"PLAG1 knockdown-2","sex":"","geo_sample":"GSM5515755","access":"open","dbgap":"","n_runs":1,"first_public":"2022-12-06","attributes":[["source_name","Human Cord Blood"],["cell_type","Lin-CD34+ HSPCs"],["shRNA","PLAG1 knockdown"]],"runs":[{"run_ac