{"study_accession":"PRJNA1471713","secondary_study_accession":"SRP704513","title":"An Exploratory Integrative Analysis of Plasma Transcriptomic and Proteomic Predictors of Response to Total Neoadjuvant Therapy in Locally Advanced Rectal Cancer","description":"Aims to screen and identify plasma biomarkers associated with treatment response to TNT in patients with locally advanced rectal cancer (LARC) to predict pathological complete response (pCR). Pre-treatment plasma RNA sequencing and functional annotation were performed in six patients with LARC (three pCR and three non-pCR) to identify differentially expressed genes (DEGs) associated with TNT response. Compared to the non-pCR group, 365 DEGs were upregulated, and 198 were downregulated in the pCR group. These genes are involved in pathways related to cell growth and death, signal transduction, metabolism, the immune system, insulin secretion, mitophagy, and neutrophil extracellular trap formation.","pubmed":"42339115","geo_series":"","n_samples":6,"samples":[{"sample_accession":"SAMN60463600","study_accession":"PRJNA1471713","blood_class":"plasma_serum_cfrna","class_from":"sample","title":"CP1806","description":"CP1806","sex":"","geo_sample":"GSM9770110","access":"open","dbgap":"","n_runs":1,"first_public":"2026-06-10","attributes":[["source_name","plasma"],["tissue","plasma"],["genotype","non-pCR"],["treatment","untreated"],["geo_loc_name","missing"],["collection_date","missing"]],"runs":[{"run_accession":"SRR38883008","experiment_accession":"SRX33647473","library_layout":"PAIRED","library_selection":"cDNA","instrument_model":"Illumina NovaSeq 6000","read_count":19666812,"base_count":5900043600,"first_public":"2026-06-10","experiment_title":"Illumina NovaSeq 6000 sequencing: GSM9770110: CP1806 Homo sapiens RNA-Seq"}],"labels":[],"single_cell":false},{"sample_accession":"SAMN60463601","study_accession":"PRJNA1471713","blood_class":"plasma_serum_cfrna","class_from":"sample","title":"CP1436","description":"CP1436"