{"study_accession":"PRJNA1229092","secondary_study_accession":"SRP566614","title":"RNA-Sequencing in a patient with autoinflammatory disease","description":"Type I interferonopathies are a group of inherited autoinflammatory disorders characterized by dysregulation of type I interferon (IFN-I) signaling pathways. ISG15, a unique Ubiquitin-like (Ubl) modifier in the interferon-stimulated genes (ISGs) family, plays a critical role in innate immune responses induced by IFN-I. In this study, we identified a novel homozygous missense variant in ISG15 gene in a 4-month-old patient with Type I interferonopathy. RNA-sequencing was used to explore the expression levels of IFN pathway genes in this patient.","pubmed":"","geo_series":"","n_samples":12,"samples":[{"sample_accession":"SAMN47120272","study_accession":"PRJNA1229092","blood_class":"whole_blood","class_from":"sample","title":"Human sample from Homo sapiens","description":"Human sample from Homo sapiens","sex":"male","geo_sample":"","access":"open","dbgap":"","n_runs":1,"first_public":"2025-12-21","attributes":[["isolate","KYC1"],["age","4 months"],["biomaterial_provider","McKusick-Zhang Center for Genetic Medicine"],["collection_date","2024-04-15"],["geo_loc_name","China: Beijing"],["sex","male"],["tissue","Peripheral blood"]],"runs":[{"run_accession":"SRR32503410","experiment_accession":"SRX27815827","library_layout":"PAIRED","library_selection":"cDNA","instrument_model":"Illumina NovaSeq 6000","read_count":27421545,"base_count":8226463500,"first_public":"2025-12-21","experiment_title":"Illumina NovaSeq 6000 sequencing: RNA-Seq of Homo sapiens: KYC Peripheral blood"}],"labels":[],"single_cell":false},{"sample_accession":"SAMN47120273","study_accession":"PRJNA1229092","blood_class":"whole_blood","class_from":"sample","title":"Human sample from Homo sapiens","description":"Human sample from Homo sapiens","sex":"male","geo_sample":"","access":"open","dbgap":"","n_runs":1,"first_public":"2025-12-21","attributes":[["iso