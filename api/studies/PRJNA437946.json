{"study_accession":"PRJNA437946","secondary_study_accession":"SRP134953","title":"Molecular and Functional Characterization of Disease-Propagating Stem Cells in Juvenile Myelomonocytic Leukemia [FACS sorted populations]","description":"We report on the characterization of JMML hematopoietic stem and progenitor cells (HSPCs). In order to molecularly characterize these populations we preformed bulk RNA-seq on purified cord blood and JMML HSCs, GMPs, and JMML double positives (+/+). We identified a conserved molecular hierarchy in JMML with high stem cell gene expression in HSCs, high progenitor and cell cycle gene expression in GMPs. We identified enriched gene sets in JMML HSCs vs CB HSCs, and find a number of potential therapeutic targets expressed in JMML. Overall design: mRNA sequencing of human cord blood and JMML HSPC populations","pubmed":"33416891","geo_series":"","n_samples":10,"study_labels":[],"samples":[{"sample_accession":"SAMN08687213","study_accession":"PRJNA437946","blood_class":"cord_blood","class_from":"sample","title":"CB_CBD_HSC","description":"CB_CBD_HSC","sex":"","geo_sample":"GSM3037836","access":"open","dbgap":"","n_runs":1,"first_public":"2021-01-04","attributes":[["source_name","CB_HSC"],["tissue","cord blood (CB)"],["cell_type","hematopoietic stem and progenitor cells (HSPCs)"],["facs purified population","HSC"]],"runs":[{"run_accession":"SRR6826140","experiment_accession":"SRX3782429","library_layout":"SINGLE","library_selection":"cDNA","instrument_model":"NextSeq 500","read_count":12513704,"base_count":921807509,"first_public":"2021-01-04","experiment_title":"NextSeq 500 sequencing: GSM3037836: CB_CBD_HSC Homo sapiens RNA-Seq"}],"labels":[],"single_cell":false},{"sample_accession":"SAMN08687214","study_accession":"PRJNA437946","blood_class":"cord_blood","class_from":"sample","title":"CB_CBD_GMP","description":"CB_CBD_GMP","sex":"","geo_sample":"GSM3037835","access":"open","dbgap":"","n_runs":1,"first_public":"2021-01-04","attributes":[["so