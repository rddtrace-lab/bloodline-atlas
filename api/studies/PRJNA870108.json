{"study_accession":"PRJNA870108","secondary_study_accession":"SRP392545","title":"Effect of oscillating shear stress on gene expression of endothelial progenitor cells","description":"To investigate the function of oscillating shear stress in the regulation of endothelial progenitor cell (EPCs) differentiation, we used EPCs derived from the umbilical cord blood loaded with OSS for 12h. OSS (±3.5 dynes/cm2, 1 Hz frequency) was loaded using a Flexcell flow STR-4000 parallel plate flow chamber system. Overall design: We then performed gene expression profiling analysis using data obtained from RNA-seq of 3 different cells after EPCs loaded with OSS for 12h compared with the static EPCs as the control.","pubmed":"","geo_series":"","n_samples":6,"samples":[{"sample_accession":"SAMN30351276","study_accession":"PRJNA870108","blood_class":"cord_blood","class_from":"sample","title":"EPCs, oscillating shear stress, 12h [Sample_OS3]","description":"EPCs, oscillating shear stress, 12h [Sample_OS3]","sex":"","geo_sample":"GSM6469541","access":"open","dbgap":"","n_runs":2,"first_public":"2022-08-20","attributes":[["source_name","umbilical cord blood"],["tissue","umbilical cord blood"],["cell_type","endothelial progenitor cells"],["genotype","WT"],["treatment","oscillating shear stress"]],"runs":[{"run_accession":"SRR21091944","experiment_accession":"SRX17106375","library_layout":"PAIRED","library_selection":"cDNA","instrument_model":"Illumina NovaSeq 6000","read_count":23638969,"base_count":7091690700,"first_public":"2022-08-20","experiment_title":"Illumina NovaSeq 6000 sequencing: GSM6469541: EPCs, oscillating shear stress, 12h [Sample_OS3] Homo sapiens RNA-Seq"},{"run_accession":"SRR21091945","experiment_accession":"SRX17106375","library_layout":"PAIRED","library_selection":"cDNA","instrument_model":"Illumina NovaSeq 6000","read_count":35163033,"base_count":10548909900,"first_public":"2022-08-20","experiment_title":"Illumina NovaSeq 6000 sequencing: GSM6469541: EPCs, oscillatin