{"study_accession":"PRJNA1523008","secondary_study_accession":"SRP733509","title":"Transcriptomic profiling of BCMA chimeric antigen receptor marrow-infiltrating lymphocytes for multiple myeloma","description":"This study investigated B-cell maturation antigen (BCMA)-specific chimeric antigen receptor marrow-infiltrating lymphocytes (BCMA CAR-MILs) as a cellular immunotherapy platform for multiple myeloma. BCMA CAR-MILs were generated using marrow-infiltrating lymphocytes, which contain memory-rich and polyclonal T-cell populations, and were engineered with a dual-epitope BCMA-targeting chimeric antigen receptor. Transcriptomic sequencing was performed to characterize the molecular features of the engineered cell products and to support evaluation of their biological and functional properties. The resulting sequence data are provided as part of a preclinical investigation of BCMA CAR-MILs for multiple myeloma.","pubmed":"","geo_series":"","n_samples":20,"samples":[{"sample_accession":"SAMN62924736","study_accession":"PRJNA1523008","blood_class":"bone_marrow","class_from":"sample","title":"BCMA CAR-MIL, day 7, replicate 1","description":"BCMA CAR-MIL, day 7, replicate 1","sex":"not collected","geo_sample":"","access":"open","dbgap":"","n_runs":1,"first_public":"2026-09-04","attributes":[["isolate","RNA-1"],["age","not collected"],["biomaterial_provider","CNUHH"],["collection_date","not collected"],["geo_loc_name","South Korea"],["sex","not collected"],["tissue","bone marrow"]],"runs":[{"run_accession":"SRR40513749","experiment_accession":"SRX35104901","library_layout":"PAIRED","library_selection":"Inverse rRNA","instrument_model":"Illumina NovaSeq X","read_count":38026539,"base_count":7644457341,"first_public":"2026-09-04","experiment_title":"Illumina NovaSeq X sequencing: RNA-Seq of Homo sapiens: BCMA CAR-MIL day 7 replicate 1"}],"labels":[],"single_cell":false},{"sample_accession":"SAMN62924737","study_accession":"PRJNA1523008","blood_class":"bone_marrow","class_fr