{"study_accession":"PRJEB101389","secondary_study_accession":"ERP182795","title":"TP53 allelic state-induced changes in the transcriptome of hematopoietic stem and progenitor cells derived from umbilical cord blood","description":"TP53 mutations in hematopoietic stem and progenitor cells are associated with an increased risk of developing blood disorders such as MDS and AML. The TP53 allelic state, implying whether one or both alleles are mutated, remains uncertain in terms of its impact on prognosis. To clarify the biological impact of these differences, we introduced defined TP53 alterations via a CRISPR/Cas9 gene editing into umbilical cord blood–derived hematopoietic stem and progenitor cells and investigated changes in the transcriptome by performing RNA-sequencing.\n","pubmed":"42613433","geo_series":"","n_samples":21,"study_labels":[],"samples":[{"sample_accession":"SAMEA120424305","study_accession":"PRJEB101389","blood_class":"cord_blood","class_from":"sample","title":"HSPC_rep1 R175H WT","description":"02_HSPC_61_R175H_WT","sex":"","geo_sample":"","access":"open","dbgap":"","n_runs":1,"first_public":"2026-08-31","attributes":[["ENA-CHECKLIST","ERC000011:1.3"],["organism","Homo sapiens"],["collection date","2020-01-09"],["scientific_name","Homo sapiens"],["common name","human"],["cell_type","Hematopoietic stem and progenitor cells"],["tissue_type","Umbilical cord blood"],["geographic location (country and/or sea)","Austria"]],"runs":[{"run_accession":"ERR15761872","experiment_accession":"ERX15165935","library_layout":"PAIRED","library_selection":"RANDOM","instrument_model":"Illumina NovaSeq 6000","read_count":102794436,"base_count":10279443600,"first_public":"2026-08-31","experiment_title":"Illumina NovaSeq 6000 sequencing"}],"labels":[],"single_cell":false},{"sample_accession":"SAMEA120424306","study_accession":"PRJEB101389","blood_class":"cord_blood","class_from":"sample","title":"HSPC_rep1 R175H KO","description":"03_HSPC_61_R175H_KO","sex":"","geo_sample