{"study_accession":"PRJNA1193991","secondary_study_accession":"SRP549239","title":"secukinumab treanment","description":"Thirteen adult patients with moderate to severe psoriasis were recruited into the study and injected with secukinumab 300 mg in two subcutaneous doses of 150 mg at weeks 0, 1, 2, 3, 4, 8, and 12. This dose was then maintained every 4 weeks for a treatment cycle of at least 16 weeks. Patients were clinically evaluated before and during treatment using the Psoriasis Area Severity Index (PASI) score. Blood was obtained from all patients before and after 16 weeks of treatment for assessment via the proximity extension assay (Target 96 Inflammation Panel) and transcriptomics analysis.","pubmed":"","geo_series":"","n_samples":26,"samples":[{"sample_accession":"SAMN44849746","study_accession":"PRJNA1193991","blood_class":"whole_blood","class_from":"sample","title":"Human sample from Homo sapiens","description":"Human sample from Homo sapiens","sex":"male","geo_sample":"","access":"open","dbgap":"","n_runs":1,"first_public":"2024-12-05","attributes":[["isolate","A1,jiang feng,pre-treanment"],["age","39"],["biomaterial_provider","Institute of Dermatology, Anhui Medical University, Hefei, Anhui China"],["collection_date","not collected"],["geo_loc_name","China: Anhui"],["sex","male"],["tissue","blood"]],"runs":[{"run_accession":"SRR31596230","experiment_accession":"SRX26961030","library_layout":"PAIRED","library_selection":"PolyA","instrument_model":"BGISEQ-500","read_count":22156814,"base_count":6647044200,"first_public":"2024-12-05","experiment_title":"BGISEQ-500 sequencing: abc"}],"labels":[]},{"sample_accession":"SAMN44849747","study_accession":"PRJNA1193991","blood_class":"whole_blood","class_from":"sample","title":"Human sample from Homo sapiens","description":"Human sample from Homo sapiens","sex":"male","geo_sample":"","access":"open","dbgap":"","n_runs":1,"first_public":"2024-12-05","attributes":[["isolate","zhou xiumu,pre-treanment"],["age","39"],