{"study_accession":"PRJNA894477","secondary_study_accession":"SRP404616","title":"Generation of megakaryocytes and functional platelets from human embryonic stem cells","description":"We developed a novel differentiation system that directionally induces hESCs into megakaryocytes and functional platelet in vitro by highly mimicking the in vivo developmental process of megakaryocytes and platelets. We then performed gene expression profiling analysis using data obtained by RNA-seq at different stages of differentiation during the differentiation of hESCs into megakaryocyte lineages. Overall design: Cell spheres or suspension cells were collected for RNA-seq on days 0, 2, 6, 9, 9+0, 9+2, and 9+6 of differentiation during the directed differentiation of hESCs towards megakaryocytes.","pubmed":"39609933","geo_series":"","n_samples":18,"samples":[{"sample_accession":"SAMN31456385","study_accession":"PRJNA894477","blood_class":"platelet","class_from":"study","title":"MKs, Day 9+6, C [MKD9+6C]","description":"MKs, Day 9+6, C [MKD9+6C]","sex":"","geo_sample":"GSM6681026","access":"open","dbgap":"","n_runs":1,"first_public":"2024-08-15","attributes":[["source_name","human embryonic stem cells"],["source cell type","human embryonic stem cells"],["genotype","WT"],["treatment","Megakaryocytic differentiation"],["timepoint","Day 9+6"]],"runs":[{"run_accession":"SRR22047944","experiment_accession":"SRX18029041","library_layout":"PAIRED","library_selection":"cDNA","instrument_model":"Illumina NovaSeq 6000","read_count":23712497,"base_count":7113749100,"first_public":"2024-08-15","experiment_title":"Illumina NovaSeq 6000 sequencing: GSM6681026: MKs, Day 9+6, C [MKD9+6C] Homo sapiens RNA-Seq"}],"labels":[],"single_cell":false},{"sample_accession":"SAMN31456386","study_accession":"PRJNA894477","blood_class":"platelet","class_from":"study","title":"MKs, Day 9+6, B [MKD9+6B]","description":"MKs, Day 9+6, B [MKD9+6B]","sex":"","geo_sample":"GSM6681025","access":"open","dbgap":"","n_runs