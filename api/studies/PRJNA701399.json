{"study_accession":"PRJNA701399","secondary_study_accession":"SRP305819","title":"RNA-sequencing analysis of effect of miR-155 overexpression in human CD14+ monocytes","description":"We report the application of bulk RNA-Sequencing to assess the effect of miR-155 overexpression by profiling gene expression following transfection of miR-155 mimic compared against negative control mimic in human peripheral blood CD14+ monocytes. Isolated human CD14+ monocytes were transfected for 24 hours and mRNA profiles of miR-155 and negative control mimic were generated by bulk RNA-Sequencing in 5 donors. The sequence reads passed quality checks and were analysed using DeSeq2. We mapped the sequence reads to the human genome (build hg38) and identified 16,014 transcripts. Overall design: Comparing gene expression in human peripheral blood CD14+ monocytes transfected with a miR-155 or negative control mimic","pubmed":"35020867","geo_series":"","n_samples":10,"samples":[{"sample_accession":"SAMN17865178","study_accession":"PRJNA701399","blood_class":"blood_cells","class_from":"sample","title":"D5 CD14 miR-155","description":"D5 CD14 miR-155","sex":"female","geo_sample":"GSM5076152","access":"open","dbgap":"","n_runs":1,"first_public":"2022-02-16","attributes":[["source_name","Human peripheral blood CD14+ monocyte_miR-155 mimic"],["sex","female"],["age","31"],["cell_type","Peripheral blood CD14+ monocyte"],["treatment","miR-155 mimic"]],"runs":[{"run_accession":"SRR13686001","experiment_accession":"SRX10075338","library_layout":"PAIRED","library_selection":"cDNA","instrument_model":"Illumina MiSeq","read_count":51573892,"base_count":13951442352,"first_public":"2022-02-16","experiment_title":"Illumina MiSeq sequencing: GSM5076152: D5 CD14 miR-155 Homo sapiens RNA-Seq"}],"labels":[],"single_cell":false},{"sample_accession":"SAMN17865179","study_accession":"PRJNA701399","blood_class":"blood_cells","class_from":"sample","title":"D5 CD14 Neg C","description":"D5 CD14 Neg C","sex":"female