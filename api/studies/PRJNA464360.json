{"study_accession":"PRJNA464360","secondary_study_accession":"SRP144748","title":"Expression profiles of RNA during osteogenic differentiation of human mesenchymal stem cells under normal ground condition and simulated microgravity","description":"In this study, hMSCs were osteogenically induced for 0, 2, 7 and 14 days under normal ground gravity and simulated microgravity, followed by analysis of the differences in transcriptome expression during osteogenic differentiation by RNA sequencing. Overall design: The 3rd passage of hMSCs were cultured in T12.5 flasks and filled with osteogenic medium and fixed on a cell culture vessel for RPM exposure, while hMSCs grown in NG condition were also filled with osteogenic medium and were statically placed in the same CO2 incubator. The medium was changed twice a week. Cells induced for 0, 2, 7, and 14 days were used to study the effects of SMG.","pubmed":"30397970","geo_series":"","n_samples":7,"study_labels":[],"samples":[{"sample_accession":"SAMN09081401","study_accession":"PRJNA464360","blood_class":"bone_marrow","class_from":"sample","title":"g2","description":"g2","sex":"","geo_sample":"GSM3133036","access":"open","dbgap":"","n_runs":1,"first_public":"2020-03-26","attributes":[["source_name","osteogenesis for 2 days under normal ground condition"],["cell_type","human bone marrow mesenchymal stem cells"],["passages","3"],["differentiation status","osteogenic differentiation day 2"],["gravity status","normal ground gravity"],["tissue","bone"]],"runs":[{"run_accession":"SRR7126652","experiment_accession":"SRX4047664","library_layout":"PAIRED","library_selection":"cDNA","instrument_model":"HiSeq X Ten","read_count":25584633,"base_count":7675389900,"first_public":"2020-03-26","experiment_title":"HiSeq X Ten sequencing: GSM3133036: g2 Homo sapiens RNA-Seq"}],"labels":[],"single_cell":false},{"sample_accession":"SAMN09081402","study_accession":"PRJNA464360","blood_class":"bone_marrow","class_from":"sample","title":"mg2","descr