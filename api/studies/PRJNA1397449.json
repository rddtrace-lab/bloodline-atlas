{"study_accession":"PRJNA1397449","secondary_study_accession":"SRP659464","title":"Integrated mRNA and Extrachromosomal Circular DNA Profiling Reveals Novel Biomarkers for Liver Fibrosis","description":"This study aims to characterize eccDNAs in hepatitis B virus-related liver fibrosis and identify potential diagnostic biomarkers. EccDNA-chr12:120232112-120232244, eccDNA-chr12:115607016-124806916, and mRNA-paxillin were significantly upregulated in liver fibrosis. Moreover, three candidate biomarkers demonstrated high diagnostic accuracy, with area under curve values of 0.821 , 0.807, and 0.820 , respectively. We offer a comprehensive characterization of eccDNAs in human liver fibrosis and have identified that mRNA-paxillin-containing eccDNAs are potential biomarkers in liver fibrosis.","pubmed":"","geo_series":"","n_samples":15,"study_labels":[],"samples":[{"sample_accession":"SAMN54423550","study_accession":"PRJNA1397449","blood_class":"plasma_serum_cfrna","class_from":"sample","title":"group0-1","description":"group0-1","sex":"male","geo_sample":"","access":"open","dbgap":"","n_runs":1,"first_public":"2026-01-11","attributes":[["isolate","serum from liver fibrosis"],["age","25"],["biomaterial_provider","Haijun Huang"],["collection_date","2020-10"],["geo_loc_name","China:Hangzhou"],["sex","male"],["tissue","serum"]],"runs":[{"run_accession":"SRR36663264","experiment_accession":"SRX31674029","library_layout":"PAIRED","library_selection":"RANDOM","instrument_model":"Illumina NovaSeq 6000","read_count":54838604,"base_count":16451581200,"first_public":"2026-01-11","experiment_title":"Illumina NovaSeq 6000 sequencing: RNA-Seq of Homo sapiens serum: liver fibrosis"}],"labels":[],"single_cell":false},{"sample_accession":"SAMN54423551","study_accession":"PRJNA1397449","blood_class":"plasma_serum_cfrna","class_from":"sample","title":"group0-1","description":"group0-1","sex":"female","geo_sample":"","access":"open","dbgap":"","n_runs":1,"first_public":"2026-01-11","attribut