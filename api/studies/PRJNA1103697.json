{"study_accession":"PRJNA1103697","secondary_study_accession":"SRP503551","title":"Transcriptome profiles characteristics of peripheral immune in Severe Fever with Thrombocytopenia Syndrome patients","description":"To investigate the response mechanisms of Severe fever with thrombocytopenia syndrome (SFTS) patients, we conducted transcriptomic analysis of peripheral immunity in 14 SFTS patients, ranging from modal infection to severe and fatal disease. Our results observed the potential mechanism for the heterogeneity of clinical symptoms, which can further elucidate the interaction between viruses and hosts and contribute to clinical treatment. Overall design: we conducted transcriptomic analysis of peripheral immunity in 6 healthy individuals and 14 SFTS patients, ranging from modal infection to severe and fatal disease.","pubmed":"39530000","geo_series":"","n_samples":20,"samples":[{"sample_accession":"SAMN41059087","study_accession":"PRJNA1103697","blood_class":"pbmc","class_from":"sample","title":"PBMCs, D3","description":"PBMCs, D3","sex":"","geo_sample":"GSM8224327","access":"open","dbgap":"","n_runs":1,"first_public":"2024-12-01","attributes":[["source_name","PBMC"],["cell_type","PBMC"],["disease","SFTS"],["disease severity","fatal"],["geo_loc_name","missing"],["collection_date","missing"]],"runs":[{"run_accession":"SRR28779893","experiment_accession":"SRX24344560","library_layout":"PAIRED","library_selection":"cDNA","instrument_model":"NextSeq 2000","read_count":29276811,"base_count":8453685494,"first_public":"2024-12-01","experiment_title":"NextSeq 2000 sequencing: GSM8224327: PBMCs, D3 Homo sapiens RNA-Seq"}],"labels":[]},{"sample_accession":"SAMN41059088","study_accession":"PRJNA1103697","blood_class":"pbmc","class_from":"sample","title":"PBMCs, D2","description":"PBMCs, D2","sex":"","geo_sample":"GSM8224326","access":"open","dbgap":"","n_runs":1,"first_public":"2024-12-01","attributes":[["source_name","PBMC"],["cell_type","PBMC"],["disease","SFTS"],["di