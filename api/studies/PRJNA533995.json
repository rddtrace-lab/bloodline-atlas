{"study_accession":"PRJNA533995","secondary_study_accession":"SRP193280","title":"The Evolving Immune Microenvironment of B-cell Acute Lymphoblastic Leukemia [human bone marrow dataset]","description":"Single-cell RNA-seq analysis of primary human bone marrow immune populations isolated from B-ALL patient samples (matched diagnosis, remission and relapse), and healthy bone marrow donor samples. Overall design: Single-cell RNA-sequencing libraries of primary human bone marrow immune populations. B-ALL patient bone marrow samples were separated into CD19+ B cell and CD19-CD45+ non-B cell fractions by flow-based sorting and then mixed at a ratio of 1:5 CD19+:CD19-CD45+ followed by scRNA-Seq. Total CD45+ bone marrow cells were sequenced from healthy donors.","pubmed":"32470390","geo_series":"","n_samples":24,"samples":[{"sample_accession":"SAMN11475294","study_accession":"PRJNA533995","blood_class":"bone_marrow","class_from":"sample","title":"ETV001_NYU_DIAGNOSIS","description":"ETV001_NYU_DIAGNOSIS","sex":"male","geo_sample":"GSM3732336","access":"open","dbgap":"","n_runs":1,"first_public":"2020-06-10","attributes":[["source_name","bone marrow"],["disease","B-ALL"],["Stage","Diagnosis"],["cell_type","ratio of 1:5 CD19+:CD19-CD45+ bone marrow cells"],["sex","male"],["source","KM"],["source institute","NYU"]],"runs":[{"run_accession":"SRR8936585","experiment_accession":"SRX5717218","library_layout":"SINGLE","library_selection":"cDNA","instrument_model":"Illumina HiSeq 4000","read_count":240009109,"base_count":23520892682,"first_public":"2020-06-10","experiment_title":"Illumina HiSeq 4000 sequencing: GSM3732336: ETV001_NYU_DIAGNOSIS Homo sapiens RNA-Seq"}],"labels":[]},{"sample_accession":"SAMN11475295","study_accession":"PRJNA533995","blood_class":"bone_marrow","class_from":"sample","title":"PH002_SJ_REMISSION","description":"PH002_SJ_REMISSION","sex":"female","geo_sample":"GSM3732359","access":"open","dbgap":"","n_runs":1,"first_public":"2020-06-10","attributes":[["sour