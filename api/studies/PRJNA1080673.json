{"study_accession":"PRJNA1080673","secondary_study_accession":"SRP491858","title":"Effect of ablation of CEACAM1 on gene expression in human regulatory T cells","description":"To study the contribution of CEACAM1 in human Tregs, CEACAM1 was knocked out in ex-vivo expanded human Tregs by Crispr/Cas9. Tregs transfected with scramble gRNAs were used as controls. After electroporation, scramble or CEACAM1KO Tregs were subcultured with IL-2 for 7 days and RNA was isolated for genome-wide RNA-seq. Gene expression profiling analysis was performed using data obtained from RNA-seq of two replicates of CEACAM1KO and control cells. Overall design: Comparative gene expression profiling analysis of RNA-seq data for CEACAM1KO and scramble control human Tregs.","pubmed":"40773294","geo_series":"","n_samples":4,"samples":[{"sample_accession":"SAMN40147084","study_accession":"PRJNA1080673","blood_class":"blood_cells","class_from":"sample","title":"Tregs, CEACAM1 knockout, biol repl 2","description":"Tregs, CEACAM1 knockout, biol repl 2","sex":"","geo_sample":"GSM8114033","access":"open","dbgap":"","n_runs":1,"first_public":"2025-07-24","attributes":[["source_name","blood"],["tissue","blood"],["cell_type","regulatory T cells"],["genotype","CEACAM1 knockout"],["treatment","culture with IL-2 for 7 days"],["geo_loc_name","missing"],["collection_date","missing"]],"runs":[{"run_accession":"SRR28108211","experiment_accession":"SRX23753276","library_layout":"PAIRED","library_selection":"cDNA","instrument_model":"Illumina NovaSeq 6000","read_count":22042812,"base_count":6612843600,"first_public":"2025-07-24","experiment_title":"Illumina NovaSeq 6000 sequencing: GSM8114033: Tregs, CEACAM1 knockout, biol repl 2 Homo sapiens RNA-Seq"}],"labels":[]},{"sample_accession":"SAMN40147085","study_accession":"PRJNA1080673","blood_class":"blood_cells","class_from":"sample","title":"Tregs, CEACAM1 knockout, biol repl 1","description":"Tregs, CEACAM1 knockout, biol repl 1","sex":"","geo_sample":"GSM811403