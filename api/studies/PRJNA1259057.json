{"study_accession":"PRJNA1259057","secondary_study_accession":"SRP583174","title":"Effect of fatty acid binding protein 7 in transcriptomic changes in monocytes.","description":"Multiple sclerosis (MS) is an autoimmune mediated disease of central nervous system. It involves dysregulation of peripheral immune cells including monocytes. Fatty acid binding proteins (FABP) are essential in transporting and metabolism of fatty acids. FABP7, a bran lipid binding protein, is expressed in brain specifically in astrocytes and neural stem cells. FABP7 expression is increased during the astrocyte activation and inflammation. FABP7 may get secreted in the inflammatory microenvironment of central nervous system during MS progression and may interact with the infiltrated monocytes or macrophages. The goal of this study is to analyze the effect of FABP7 on monocytes. Here, we first isolated monocytes from healthy controls and treated with recombinant FABP7 protein at the dose of 300 ng/ml for 24 hours. This was followed by washing and lysing the cells and performing bulk RNA sequencing.","pubmed":"","geo_series":"","n_samples":12,"study_labels":[],"samples":[{"sample_accession":"SAMN48349466","study_accession":"PRJNA1259057","blood_class":"blood_cells","class_from":"sample","title":"Control 1","description":"Control 1","sex":"male","geo_sample":"","access":"open","dbgap":"","n_runs":1,"first_public":"2025-05-10","attributes":[["isolate","HC1"],["age","34"],["biomaterial_provider","Chitnis Lab"],["collection_date","2022-09-27"],["geo_loc_name","USA"],["sex","male"],["tissue","Peripheral blood"],["cell_type","Monocyte"],["source_material_identifier","GTAGAGGA-TAAGGCTC"]],"runs":[{"run_accession":"SRR33438456","experiment_accession":"SRX28679287","library_layout":"PAIRED","library_selection":"PCR","instrument_model":"NextSeq 500","read_count":1993505,"base_count":151506380,"first_public":"2025-05-10","experiment_title":"NextSeq 500 sequencing: Bulk RNA seq of monocytes Control-1"}],"