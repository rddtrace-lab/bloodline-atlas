{"study_accession":"PRJNA445839","secondary_study_accession":"SRP136539","title":"Time-series of human LPS stimulated-monocyte derived macrophages","description":"We studied the lipidome (236 individual lipid species including sphingolipids, ceramides, cholesterol, gangliosides, phosphatidylethanolamines) in basal and LPS-stimulated human monocyte derived macrophages (MDMs) over a time-course by LC-MS (30min, 3h, 8h, 16h; n=12 human donors). In order to explore how transcriptomic changes induced by LPS stimulation can correlate with changes in the lipidome, we performed RNAsequencing on MDMs from 4 donors over a time-course (30min, 3h, 8h, 16h) Overall design: We carried out RNA-sequencing in MDMs from 4 donors at 4 time-points (30min, 3h, 8h, 16h).","pubmed":"35844525","geo_series":"","n_samples":19,"samples":[{"sample_accession":"SAMN08800028","study_accession":"PRJNA445839","blood_class":"bone_marrow","class_from":"sample","title":"T0_2","description":"T0_2","sex":"","geo_sample":"GSM3068890","access":"open","dbgap":"","n_runs":1,"first_public":"2021-03-29","attributes":[["source_name","Bone marrow derived macrophage"],["compound","CONTROL"],["donor","2"],["time","0 hr"],["cell_type","Bone marrow derived macrophage"]],"runs":[{"run_accession":"SRR6903232","experiment_accession":"SRX3852020","library_layout":"PAIRED","library_selection":"cDNA","instrument_model":"Illumina HiSeq 2500","read_count":31761795,"base_count":6352359000,"first_public":"2021-03-29","experiment_title":"Illumina HiSeq 2500 sequencing: GSM3068890: T0_2 Homo sapiens RNA-Seq"}],"labels":[],"single_cell":false},{"sample_accession":"SAMN08800029","study_accession":"PRJNA445839","blood_class":"bone_marrow","class_from":"sample","title":"T0_1","description":"T0_1","sex":"","geo_sample":"GSM3068889","access":"open","dbgap":"","n_runs":1,"first_public":"2021-03-29","attributes":[["source_name","Bone marrow derived macrophage"],["compound","CONTROL"],["donor","1"],["time","0 hr"],["cell_type","Bone ma