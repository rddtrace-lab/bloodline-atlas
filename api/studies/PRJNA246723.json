{"study_accession":"PRJNA246723","secondary_study_accession":"SRP041955","title":"Homo sapiens Transcriptome or Gene expression","description":"The use of low quality RNA samples in whole-genome gene expression profiling remains controversial. It is unclear if transcript degradation in low quality RNA samples occurs uniformly, in which case the effects of degradation can be normalized, or whether different transcripts are degraded at different rates, potentially biasing measurements of expression levels. This concern has rendered the use of low quality RNA samples in whole-genome expression profiling problematic. Yet, low quality samples are at times the sole means of addressing specific questions – e.g., samples collected in the course of fieldwork.","pubmed":"","geo_series":"","n_samples":20,"samples":[{"sample_accession":"SAMN02769865","study_accession":"PRJNA246723","blood_class":"pbmc","class_from":"sample","title":"Human sample from Homo sapiens","description":"Individual 1 0h","sex":"male","geo_sample":"","access":"open","dbgap":"","n_runs":2,"first_public":"2014-08-11","attributes":[["isolate","1"],["age","adult"],["biomaterial_provider","Research Blood Components LLC (Boston, MA)"],["sex","male"],["tissue","PBMCs"],["hours","0"]],"runs":[{"run_accession":"SRR1300791","experiment_accession":"SRX554541","library_layout":"SINGLE","library_selection":"RANDOM","instrument_model":"Illumina HiSeq 2000","read_count":10774190,"base_count":538709500,"first_public":"2014-08-11","experiment_title":"Illumina HiSeq 2000 sequencing: RNA-seq of human PBMCs: 0h"},{"run_accession":"SRR1300792","experiment_accession":"SRX554541","library_layout":"SINGLE","library_selection":"RANDOM","instrument_model":"Illumina HiSeq 2000","read_count":10618506,"base_count":530925300,"first_public":"2014-08-11","experiment_title":"Illumina HiSeq 2000 sequencing: RNA-seq of human PBMCs: 0h"}],"labels":[],"single_cell":false},{"sample_accession":"SAMN02769866","study_accession":"PRJNA246723","b