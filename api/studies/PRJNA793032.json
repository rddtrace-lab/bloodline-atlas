{"study_accession":"PRJNA793032","secondary_study_accession":"SRP353995","title":"Phase 1 Trial With Challenge to Assess the Safety and Biomarkers of Protection in Malaria-naive Adults of Immunization Via Mosquito Bite With Radiation-Attenuated Plasmodium Falciparum Sporozoites (IMRAS) - Day 140-147","description":"This study is to assess the safety, tolerability, and biomarkers of protection in healthy malaria-naive adults, who will receive bites from Anopheles stephensi mosquitoes either infected with Plasmodium falciparum Sporozoites (PfRAS) (true-immunization) or noninfected (mock-immunization). Overall design: Comparison of RNAseq results from two cohorts each with two treatments, true-immunization and mock-immunization, across multiple timepoints from challenge to post-challenge (Day 140, 141, 147) to assess biomarkers of clinically-defined protection. This Series includes the data from Cohort 1.","pubmed":"","geo_series":"","n_samples":42,"samples":[{"sample_accession":"SAMN09576838","study_accession":"PRJNA793032","blood_class":"whole_blood","class_from":"sample","title":"Subject 062 VisitDay 140 Cohort IMRAS_Cohort 1_Mock Immunized","description":"Subject 062 VisitDay 140 Cohort IMRAS_Cohort 1_Mock Immunized","sex":"","geo_sample":"GSM3244086","access":"open","dbgap":"","n_runs":1,"first_public":"2021-07-04","attributes":[["source_name","Whole Blood"],["cohort","Cohort 1"],["subject","62"],["tissue","Whole Blood"],["treatment","Mock Immunized"],["visit day","140"]],"runs":[{"run_accession":"SRR7469461","experiment_accession":"SRX4339229","library_layout":"PAIRED","library_selection":"cDNA","instrument_model":"Illumina HiSeq 2000","read_count":31076522,"base_count":4661478300,"first_public":"2021-07-04","experiment_title":"Illumina HiSeq 2000 sequencing: GSM3244086: Subject 062 VisitDay 140 Cohort IMRAS_Cohort 1_True Immunized Homo sapiens RNA-Seq"}],"labels":[],"single_cell":false},{"sample_accession":"SAMN09576842","study_accession":"PRJNA793032","blood_cl