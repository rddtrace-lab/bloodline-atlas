{"study_accession":"PRJNA290475","secondary_study_accession":"SRP061372","title":"Homo sapiens Transcriptome or Gene expression","description":"The goal of this project is, firstly, to characterize the mRNA contents of two extravesicle (EV) fractions, exosomes and large oncosomes, along with the mRNA contents of the source cell line. After mRNA quantification, the next goal is to characterize what attributes of the mRNAs determine their enrichment in, or depletion from, the EV fractions compared to the whole cells. The second part of the project is the sequencing of mRNA in the EV fractions of breast cancer patients and healthy women, to see if patterns observed in the cell line are recapitulated in circulating EVs. This project is relevant in understanding the source of EV mRNA, and the potential use of EVs as biomarkers.","pubmed":"","geo_series":"","n_samples":6,"samples":[{"sample_accession":"SAMN03892269","study_accession":"PRJNA290475","blood_class":"whole_blood","class_from":"sample","title":"ILC_1","description":"EV mRNA from an ILC patient","sex":"female","geo_sample":"","access":"open","dbgap":"","n_runs":1,"first_public":"2016-07-22","attributes":[["isolate","not applicable"],["age","not collected"],["biomaterial_provider","Cedars-Sinai Medical Center"],["sex","female"],["tissue","blood"],["cell_line","not applicable"],["cell_subtype","not applicable"],["cell_type","not applicable"],["culture_collection","not applicable"],["dev_stage","Adult"],["disease","invasive lobular carcinoma"],["disease_stage","not collected"],["ethnicity","not collected"],["health_state","disease"],["karyotype","not collected"],["phenotype","disease"],["population","not collected"],["race","not collected"],["sample_type","mRNA"],["treatment","not collected"],["index","ILC_1"]],"runs":[{"run_accession":"SRR2121861","experiment_accession":"SRX1114113","library_layout":"PAIRED","library_selection":"other","instrument_model":"Illumina HiSeq 2000","read_count":62483531,"base_count":619