{"study_accession":"PRJNA756371","secondary_study_accession":"SRP333393","title":"Transcriptional analysis of DENV-elicited inflammation following experimental human DENV-1 challenge","description":"The objective of this analysis was to determine the transcriptional signature associated with experimental DENV-1 infection in human volunteers. Nine flavivirus naive volunteers were challenged with an attenuated DENV-1 strain - 45AZ5 - and blood collected for RNA extraction and transcriptional analysis on days 0, 8, 10, 14, and 28 post challenge using PAXgene collection tubes. Total RNA was isolated from the collection tubes and subjected to RNAseq analysis to identify genes and gene sets that were differentially expressed across the infection time course. Overall design: Whole blood was collected at days 0, 8, 10, 14, and 28 post DENV-1 infection 9 subjects using Paxgene tubes.","pubmed":"36288280","geo_series":"","n_samples":45,"samples":[{"sample_accession":"SAMN20864068","study_accession":"PRJNA756371","blood_class":"whole_blood","class_from":"sample","title":"whole blood, 201_D0","description":"whole blood, 201_D0","sex":"","geo_sample":"GSM5529970","access":"open","dbgap":"","n_runs":1,"first_public":"2022-11-12","attributes":[["source_name","whole blood"],["tissue","whole blood"],["individual","201"],["infection","control"],["time","day 0"]],"runs":[{"run_accession":"SRR15530512","experiment_accession":"SRX11828847","library_layout":"PAIRED","library_selection":"cDNA","instrument_model":"Illumina NovaSeq 6000","read_count":51987413,"base_count":15700198726,"first_public":"2022-11-12","experiment_title":"Illumina NovaSeq 6000 sequencing: GSM5529970: whole blood, 201_D0 Homo sapiens RNA-Seq"}],"labels":[],"single_cell":false},{"sample_accession":"SAMN20864069","study_accession":"PRJNA756371","blood_class":"whole_blood","class_from":"sample","title":"whole blood, 202_D14","description":"whole blood, 202_D14","sex":"","geo_sample":"GSM5529971","access":"open","dbgap"