{"study_accession":"PRJNA1008686","secondary_study_accession":"SRP456811","title":"Evaluation of transcriptional changes following stimulation of naive, TCM, TEM and TEMRA CD8+ T cell subsets with AB248 compared to IL-2","description":"Evaluation of transcriptional changes following stimulation of naive, TCM, TEM and TEMRA CD8+ T cell subsets confirmed that AB248 recapitulated the expected IL-2 signature with high fidelity. Human PBMCs from 3 donors were sorted into the following subsets based on the expression of CD45RO and CD62L markers: CD8+ naive T cells (CD62L+CD45RO-), CD8+ central memory T cells (CD62L+CD45RO+), CD8+ effector memory T cells (CD62L-CD45RO+), and CD8+ effector cells (CD62L-CD45RO-). Briefly, cells were stained with antibodies to sort the individual CD8+ T cell subsets, sorted via FACS, and treated at concentrations corresponding to the EC99 by pSTAT5 of rhIL-2 or AB248 for 24 h. At the end of stimulation, cells were pelleted, and RNA isolated per manufacturer's instructions and sent for sequencing using Ultra-Low Input RNA-Seq protocol (detects greater than 10 pg RNA).","pubmed":"","geo_series":"","n_samples":36,"study_labels":[],"samples":[{"sample_accession":"SAMN37124821","study_accession":"PRJNA1008686","blood_class":"whole_blood","class_from":"sample","title":"CD8_Naive_Media_68","description":"CD8_Naive_Media_68","sex":"not applicable","geo_sample":"","access":"open","dbgap":"","n_runs":1,"first_public":"2025-01-02","attributes":[["isolate","W070521014668"],["age","24 hours"],["biomaterial_provider","Asher Biotherapeutics"],["collection_date","2021"],["geo_loc_name","USA"],["sex","not applicable"],["tissue","paired-end"],["cell_subtype","Naive"],["cell_type","peripheral blood"],["treatment","Media"]],"runs":[{"run_accession":"SRR25750519","experiment_accession":"SRX21473915","library_layout":"PAIRED","library_selection":"unspecified","instrument_model":"Illumina HiSeq 1500","read_count":43337612,"base_count":13001283600,"first_public":"20