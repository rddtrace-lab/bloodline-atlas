{"study_accession":"PRJNA1294245","secondary_study_accession":"SRP602382","title":"Transcriptomic Profiling of Peripheral Blood Mononuclear Cells from Minipigs, Humans, and Nonhuman Primates Under Tofacitinib Treatment","description":"This dataset contains RNA-Seq data from peripheral blood mononuclear cells (PBMCs) derived from minipigs, humans, and nonhuman primates (NHPs), generated as part of a comparative transcriptomic study. The goal was to assess species-specific gene expression profiles and identify gene regulation patterns induced by the JAK inhibitor tofacitinib. PBMCs were isolated and either left untreated or exposed to tofacitinib, followed by transcriptome sequencing. The dataset enables cross-species comparisons of immune response modulation and provides insights into the translational relevance of animal models for immunomodulatory drug evaluation.","pubmed":"","geo_series":"","n_samples":32,"samples":[{"sample_accession":"SAMN50285546","study_accession":"PRJNA1294245","blood_class":"pbmc","class_from":"sample","title":"Human sample from Homo sapiens","description":"Human sample from Homo sapiens","sex":"female","geo_sample":"","access":"open","dbgap":"","n_runs":1,"first_public":"2026-08-05","attributes":[["isolate","10 ex vivo"],["age","adult"],["biomaterial_provider","Red Cross Austria, Vienna"],["collection_date","2022"],["geo_loc_name","Austria: Vienna"],["sex","female"],["tissue","PBMC"]],"runs":[{"run_accession":"SRR34777440","experiment_accession":"SRX29910774","library_layout":"PAIRED","library_selection":"PolyA","instrument_model":"Illumina NovaSeq 6000","read_count":39551600,"base_count":11865480000,"first_public":"2026-08-05","experiment_title":"Illumina NovaSeq 6000 sequencing: 211333_10 ex vivo"}],"labels":[]},{"sample_accession":"SAMN50285547","study_accession":"PRJNA1294245","blood_class":"pbmc","class_from":"sample","title":"Human sample from Homo sapiens","description":"Human sample from Homo sapiens","sex":"female","geo_sample":""