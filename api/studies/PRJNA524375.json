{"study_accession":"PRJNA524375","secondary_study_accession":"SRP186937","title":"IFNα inhibits allergic memory Th2 cells","description":"Memory Th2 cells play an important role in allergic disease persistence and recurrence. We previously found Type I Interferon (IFN-α/β) suppressed Th2 development and stability in CD4+ T cells from healthy subjects. The aim of this study was to investigate the role of IFN-α on allergic memory Th2 cells. We recruited allergic and nonallergic subjects. Memory T cells (CD4+CD45RO+, Tm) were isolated from blood and treated with ± IFN-α for 7 days in vitro. RNASeq analysis was performed to identify differences in transcriptome profiles between nonallergic and allergic Tm activated with IFN-α","pubmed":"","geo_series":"","n_samples":16,"study_labels":[],"samples":[{"sample_accession":"SAMN11025504","study_accession":"PRJNA524375","blood_class":"blood_cells","class_from":"sample","title":"Human sample from Homo sapiens","description":"Human sample from Homo sapiens","sex":"female","geo_sample":"","access":"open","dbgap":"","n_runs":1,"first_public":"2020-03-26","attributes":[["isolate","healthy subject"],["age","35"],["biomaterial_provider","Farrar DJ, Room NA7.512 6000 Harry Hines Blvd. Dallas, TX 75390-9093"],["sex","female"],["tissue","Blood"]],"runs":[{"run_accession":"SRR8637544","experiment_accession":"SRX5436215","library_layout":"SINGLE","library_selection":"RT-PCR","instrument_model":"NextSeq 550","read_count":24434670,"base_count":2076946950,"first_public":"2020-03-26","experiment_title":"NextSeq 550 sequencing: RNA-Seq of H. Sapiens: healthy CD4+CD45RO+ cells"}],"labels":[],"single_cell":false},{"sample_accession":"SAMN11025505","study_accession":"PRJNA524375","blood_class":"blood_cells","class_from":"sample","title":"Human sample from Homo sapiens","description":"Human sample from Homo sapiens","sex":"female","geo_sample":"","access":"open","dbgap":"","n_runs":1,"first_public":"2020-03-26","attributes":[["isolate","healthy su