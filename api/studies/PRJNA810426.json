{"study_accession":"PRJNA810426","secondary_study_accession":"SRP361466","title":"Characterization of peripheral blood TCR in patients with Type 1 Diabetes Mellitus by BD Rhapsody™ VDJ CDR3 Assay","description":"We used the latest technology, BD Rhapsody, to analyze the pairing of α and β chains that constitute the TCR of PBMCs from patients with type 1 diabetes at the single-cell level. Overall design: We used single-cell VDJ sequencing using the latest technology, BD Rhapsody, to identify the TCR sequences of autoreactive T cells characteristic of Japanese type 1 diabetes mellitus (T1DM) and to clarify the pairing of TCR of peripheral blood mononuclear cells from four patients with T1DM at the single-cell level.","pubmed":"35626661","geo_series":"","n_samples":4,"study_labels":[],"samples":[{"sample_accession":"SAMN26257918","study_accession":"PRJNA810426","blood_class":"pbmc","class_from":"sample","title":"Sample 4","description":"Sample 4","sex":"male","geo_sample":"GSM5917904","access":"open","dbgap":"","n_runs":1,"first_public":"2022-03-03","attributes":[["source_name","PBMC"],["disease","Type 1 Diabetes Mellitus"],["sex","male"],["age","49"]],"runs":[{"run_accession":"SRR18141237","experiment_accession":"SRX14289257","library_layout":"PAIRED","library_selection":"cDNA","instrument_model":"HiSeq X Ten","read_count":80618757,"base_count":24346864614,"first_public":"2022-03-03","experiment_title":"HiSeq X Ten sequencing: GSM5917904: Sample 4 Homo sapiens RNA-Seq"}],"labels":[],"single_cell":true},{"sample_accession":"SAMN26257919","study_accession":"PRJNA810426","blood_class":"pbmc","class_from":"sample","title":"Sample 3","description":"Sample 3","sex":"male","geo_sample":"GSM5917903","access":"open","dbgap":"","n_runs":1,"first_public":"2022-03-03","attributes":[["source_name","PBMC"],["disease","Type 1 Diabetes Mellitus"],["sex","male"],["age","47"]],"runs":[{"run_accession":"SRR18141238","experiment_accession":"SRX14289256","library_layout":"PAIRED","library