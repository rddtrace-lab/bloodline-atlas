{"study_accession":"PRJNA766425","secondary_study_accession":"SRP338763","title":"T cell transriptome in chromosome 22q11.2 deletion syndrome","description":"We performed transcriptome analysis via RNA sequencing of T cells isolated from participants with and without 22qDS and T cells of 22qDS participants with low or normal number of T cells. Overall design: A single-centered study involving a convenience sample of participants along with retrospective chart review. This IRB approved study included patients referred to a multidisciplinary clinic for management of chromosome 22q11.2 deletion syndrome. Healthy controls were recruited by recruitment announcements in the hospital. Peripheral blood was collected from participants aged 5-8 years. Immune function testing was performed. RNA sequencing was completed on isolated T cells; and differential gene expression profiles of T cells between 22qDS and healthy controls were established.","pubmed":"35940635","geo_series":"","n_samples":19,"samples":[{"sample_accession":"SAMN21845816","study_accession":"PRJNA766425","blood_class":"blood_cells","class_from":"sample","title":"S1-Case-N","description":"S1-Case-N","sex":"","geo_sample":"GSM5597469","access":"open","dbgap":"","n_runs":1,"first_public":"2022-06-29","attributes":[["source_name","Peripheral blood T cells"],["tissue","Peripheral blood T cells"],["condition","22q11.2 Deletion Syndrome"],["t cell number","Normal"]],"runs":[{"run_accession":"SRR16077658","experiment_accession":"SRX12364151","library_layout":"PAIRED","library_selection":"cDNA","instrument_model":"Illumina HiSeq 1500","read_count":45192971,"base_count":8932811042,"first_public":"2022-06-29","experiment_title":"Illumina HiSeq 1500 sequencing: GSM5597469: S1-Case-N Homo sapiens RNA-Seq"}],"labels":[],"single_cell":false},{"sample_accession":"SAMN21845817","study_accession":"PRJNA766425","blood_class":"blood_cells","class_from":"sample","title":"S2-Case-N","description":"S2-Case-N","sex":"","geo_sample":"