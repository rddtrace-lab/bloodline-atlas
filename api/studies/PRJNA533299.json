{"study_accession":"PRJNA533299","secondary_study_accession":"SRP192867","title":"RNA-Seq analysis of the retinal pigment epithelial cell line, ARPE19, during a time course of serum deprivation.","description":"ARPE19 cells, derived from human retinal pigment epithelium (RPE), were cultured in serum supplemented media, then the serum was removed, and culture continued in serum free media. We use this culture system as a model for the early stages of Age-related macular degeneration. RNA-Seq was performed on RNAs from seven time points: day0 (serum supplemented), day1, 3, 4, 5, 6, and 9 serum deprived samples. Overall design: RNA sequencing was performed on samples from serum deprived ARPE19 cells from days 0, 1, 3, 4, 5, 6, and 9 with three biological replicates for each time point.","pubmed":"32160961;39325754","geo_series":"","n_samples":21,"samples":[{"sample_accession":"SAMN11456323","study_accession":"PRJNA533299","blood_class":"plasma_serum_cfrna","class_from":"study","title":"Repeat1_Serum_Starved_Day3","description":"Repeat1_Serum_Starved_Day3","sex":"","geo_sample":"GSM3728696","access":"open","dbgap":"","n_runs":3,"first_public":"2020-05-14","attributes":[["source_name","ARPE19 retinal pigment epithelial cells"],["serum starvation day","Day 3"]],"runs":[{"run_accession":"SRR8923244","experiment_accession":"SRX5704539","library_layout":"PAIRED","library_selection":"cDNA","instrument_model":"Illumina HiSeq 2000","read_count":18813669,"base_count":3800361138,"first_public":"2020-05-14","experiment_title":"Illumina HiSeq 2000 sequencing: GSM3728696: Repeat1_Serum_Starved_Day3 Homo sapiens RNA-Seq"},{"run_accession":"SRR8923245","experiment_accession":"SRX5704539","library_layout":"PAIRED","library_selection":"cDNA","instrument_model":"Illumina HiSeq 2000","read_count":19324692,"base_count":3903587784,"first_public":"2020-05-14","experiment_title":"Illumina HiSeq 2000 sequencing: GSM3728696: Repeat1_Serum_Starved_Day3 Homo sapiens RNA-Seq"},{"run_accession":"SR