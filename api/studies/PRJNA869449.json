{"study_accession":"PRJNA869449","secondary_study_accession":"SRP392095","title":"Vascular Surgery Patients with Elevated Neutrophil Lymphocyte Ratios Have Downregulated Neutrophil Complement RNA Expression","description":"Elevated NLR (neutrophil-lymphocyte ratio) in elective vascular surgery (EVS) patients is associated with increased mortality independent of perioperative surgical outcome. To understand why high NLR is associated with higher mortality, we investigated neutrophil and lymphocyte transcriptome expression in patients undergoing EVS.  Overall design: Blood samples were collected from patients undergoing EVS and healthy donors for NLR calculation. RNAs were isolated and from subjects’ isolated neutrophils and lymphocytes. Patients were divided into NLR_Low (<3) and NLR_High (≥3) groups (n=6 each). ","pubmed":"36006440","geo_series":"","n_samples":36,"samples":[{"sample_accession":"SAMN30307799","study_accession":"PRJNA869449","blood_class":"blood_cells","class_from":"sample","title":"055_Neutrophil_NLR_Low [NLR_Low_N_6]","description":"055_Neutrophil_NLR_Low [NLR_Low_N_6]","sex":"","geo_sample":"GSM6455791","access":"open","dbgap":"","n_runs":1,"first_public":"2022-08-18","attributes":[["source_name","blood"],["tissue","blood"],["cell_type","Neutrophil"],["nl ratio","NLR_Low"]],"runs":[{"run_accession":"SRR21046578","experiment_accession":"SRX17062005","library_layout":"SINGLE","library_selection":"cDNA","instrument_model":"NextSeq 550","read_count":31848030,"base_count":2420450280,"first_public":"2022-08-18","experiment_title":"NextSeq 550 sequencing: GSM6455791: 055_Neutrophil_NLR_Low [NLR_Low_N_6] Homo sapiens RNA-Seq"}],"labels":[],"single_cell":false},{"sample_accession":"SAMN30307800","study_accession":"PRJNA869449","blood_class":"blood_cells","class_from":"sample","title":"050_Neutrophil_NLR_Low [NLR_Low_N_5]","description":"050_Neutrophil_NLR_Low [NLR_Low_N_5]","sex":"","geo_sample":"GSM6455790","access":"open","dbgap":"","n_runs":1,"first_publ