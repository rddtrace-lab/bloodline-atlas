{"study_accession":"PRJNA490153","secondary_study_accession":"SRP160921","title":"mRNA-seq of the following human primary CD4 T cell subsets: GM-CSF producing, GM-CSF negative, bulk, memory and naive CD4 T cells.","description":"Above primary T cell subsets were isolated by magnetic isolation (including GM-CSF capture and secretion assay) from peripheral blood of 5 to 6 human healthy donors. Total RNA (and genomic DNA for an accompanying dataset) was extracted for transcriptome analysis. By integration of RNA-seq data with corresponding ATAC-seq data we generated a novel gene regulatory network of human GM-CSF producing and memory T helper cells. Overall design: Paired-end mRNA-seq analysis of 4-5 different CD4 T cell populations from 6 biological replicates (donors).","pubmed":"34285924","geo_series":"","n_samples":29,"study_labels":[],"samples":[{"sample_accession":"SAMN10026212","study_accession":"PRJNA490153","blood_class":"blood_cells","class_from":"sample","title":"F5","description":"F5","sex":"male","geo_sample":"GSM3381926","access":"open","dbgap":"","n_runs":1,"first_public":"2021-07-24","attributes":[["source_name","Peripheral Blood"],["tissue","Peripheral Blood"],["cell_type","Memory CD4 T cells"],["donor","F"],["sex","male"]],"runs":[{"run_accession":"SRR7814301","experiment_accession":"SRX4665871","library_layout":"PAIRED","library_selection":"cDNA","instrument_model":"Illumina HiSeq 2500","read_count":16187866,"base_count":2460555632,"first_public":"2021-07-24","experiment_title":"Illumina HiSeq 2500 sequencing: GSM3381926: F5 Homo sapiens RNA-Seq"}],"labels":[],"single_cell":false},{"sample_accession":"SAMN10026213","study_accession":"PRJNA490153","blood_class":"blood_cells","class_from":"sample","title":"F4","description":"F4","sex":"male","geo_sample":"GSM3381925","access":"open","dbgap":"","n_runs":1,"first_public":"2021-07-24","attributes":[["source_name","Peripheral Blood"],["tissue","Peripheral Blood"],["cell_type","Bulk CD4 T cells"],["donor","