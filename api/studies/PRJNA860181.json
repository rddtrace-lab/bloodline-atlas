{"study_accession":"PRJNA860181","secondary_study_accession":"SRP387110","title":"Risk assessment with gene expression markers in sepsis development","description":"We investigated the individual phenotypic predisposition to developing uncomplicated infection or sepsis in a large cohort of non-infected patients undergoing major elective surgery. We built machine learning classification models on preoperative transcriptomic signatures to predict postoperative outcomes including sepsis. To test the predictive capability of these models for ongoing infection, whole blood RNA sequencing analysis on 61 independent patients with COVID-19 (10 mild, 51 severe cases) was performed. Overall design: Whole blood RNA sequencing analysis was performed on 61 affected COVID-19 patients (10 mild, 51 severe cases).","pubmed":"39232497","geo_series":"","n_samples":61,"samples":[{"sample_accession":"SAMN29832846","study_accession":"PRJNA860181","blood_class":"whole_blood","class_from":"sample","title":"BX0279_069","description":"BX0279_069","sex":"","geo_sample":"GSM6354959","access":"open","dbgap":"","n_runs":1,"first_public":"2024-08-31","attributes":[["source_name","Whole blood"],["tissue","Whole blood"],["classification","Mild COVID-19"]],"runs":[{"run_accession":"SRR20314193","experiment_accession":"SRX16347529","library_layout":"PAIRED","library_selection":"cDNA","instrument_model":"Illumina NovaSeq 6000","read_count":21604116,"base_count":6481234800,"first_public":"2024-08-31","experiment_title":"Illumina NovaSeq 6000 sequencing: GSM6354959: BX0279_069 Homo sapiens RNA-Seq"}],"labels":[]},{"sample_accession":"SAMN29832847","study_accession":"PRJNA860181","blood_class":"whole_blood","class_from":"sample","title":"BX0279_068","description":"BX0279_068","sex":"","geo_sample":"GSM6354958","access":"open","dbgap":"","n_runs":1,"first_public":"2024-08-31","attributes":[["source_name","Whole blood"],["tissue","Whole blood"],["classification","Mild COVID-19"]],"runs":[{"run_accession":"