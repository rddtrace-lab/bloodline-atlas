{"study_accession":"PRJDB18159","secondary_study_accession":"DRP013473","title":"RNA sequencing and analysis of human eosinophils stimulated with aspergillus fumigatus extract and IL-5","description":"Activated eosinophils are a major cell type involved in allergic diseases. IL-5 primarily activates eosinophils and prolongs their survival. However, interactions between these cells and microorganisms, including fungi, are also important for further activation. Aspergillus fumigatus is a common indoor allergen for patients with allergic disorders who are often sensitized to it. The aim of this study is to clarify the role of this fungus as a direct activator of human eosinophils.","pubmed":"39307590","geo_series":"","n_samples":16,"study_labels":[{"level":"study","event_code":"FUNGAL_INFECTION","certainty":"history","delta_days":-60.0,"delta_bucket":"B_FAR","time_precision":"approx","stage":"teacher","confidence":1.0,"evidence":"Aspergillus fumigatus is a common indoor allergen for patients with allergic disorders who are often sensitized to it.","model_version":"teacher:mlx:mlx-community/Qwen2.5-14B-Instruct-4bit"}],"samples":[{"sample_accession":"SAMD00787858","study_accession":"PRJDB18159","blood_class":"blood_cells","class_from":"sample","title":"DK22231_01","description":"HP1 Human eosinophils, non-stimulated","sex":"not collected","geo_sample":"","access":"open","dbgap":"","n_runs":1,"first_public":"2025-06-23","attributes":[["collection_date","2023-04-13"],["health_state","healthy"],["INSDC secondary accession","DRS483463"],["aliquot","1"],["ethnicity","Japanese"],["organism","Homo sapiens"],["race","Asian"],["sex","not collected"],["tissue","blood"],["sample_type","primary cell"],["isolate","Keio University"],["NCBI submission package","Human.1.0"],["geo_loc_name","Japan:Tokyo, Shinjuku-ku, Shinanomachi"],["cell_subtype","white blood cell"],["cell_type","eosinophil"],["age","not collected"],["biomaterial_provider","Keio University"],["sample_name","H-Medium-1"