{"study_accession":"PRJNA414543","secondary_study_accession":"SRP120122","title":"Transcriptomic insights into human decidual and peripheral blood CD8 T cells","description":"We performed the analysis of transcriptional and alternative splicing landscapes for paired decidual and peripheral blood CD8 T cells at the first trimester of human healthy pregnancy by high-throughput mRNA sequencing. Overall design: Healthy women at the first trimester of pregnancy were recruited, and FACS was performed to isolate and purify the CD8+ T cells from the decidua and maternal peripheral blood. We sequenced the mRNA samples on an Illumina Hiseq 2500 platform.","pubmed":"29780389","geo_series":"","n_samples":6,"samples":[{"sample_accession":"SAMN07793195","study_accession":"PRJNA414543","blood_class":"blood_cells","class_from":"sample","title":"BA-2-CD8","description":"BA-2-CD8","sex":"","geo_sample":"GSM2817119","access":"open","dbgap":"","n_runs":1,"first_public":"2017-11-03","attributes":[["source_name","CD8 T cells"],["tissues","peripheral blood"],["dev_stage","early pregnancy"]],"runs":[{"run_accession":"SRR6179886","experiment_accession":"SRX3290516","library_layout":"PAIRED","library_selection":"cDNA","instrument_model":"Illumina HiSeq 2500","read_count":39413950,"base_count":9853487500,"first_public":"2017-11-03","experiment_title":"Illumina HiSeq 2500 sequencing: GSM2817119: BA-2-CD8 Homo sapiens RNA-Seq"}],"labels":[],"single_cell":false},{"sample_accession":"SAMN07793196","study_accession":"PRJNA414543","blood_class":"blood_cells","class_from":"sample","title":"7xue-CD8","description":"7xue-CD8","sex":"","geo_sample":"GSM2817118","access":"open","dbgap":"","n_runs":1,"first_public":"2017-11-03","attributes":[["source_name","CD8 T cells"],["tissues","peripheral blood"],["dev_stage","early pregnancy"]],"runs":[{"run_accession":"SRR6179885","experiment_accession":"SRX3290515","library_layout":"PAIRED","library_selection":"cDNA","instrument_model":"Illumina HiSeq 2500","read