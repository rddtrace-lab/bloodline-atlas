{"study_accession":"PRJNA646728","secondary_study_accession":"SRP272262","title":"Comprehensive analyses of B cell compartments across the human body reveal novel subsets and a gut resident memory phenotype","description":"A comprehensive analysis of B lineage cells in various tissues of multiple healthy organ donors reveals tissue-specific differences and lack of correspondence between blood and tissues. New, functionally distinct memory B cell subsets were discovered, including one subset specific to the gut that has unique surface markers and a unique gene expression signature. Overall design: RNA profiling of memory B cell subsets defined by CD45RB and CD69 expression in spleen and gut, spleen has 4 biological replicates, gut has 3 replicates","pubmed":"32750113","geo_series":"","n_samples":6,"samples":[{"sample_accession":"SAMN15559191","study_accession":"PRJNA646728","blood_class":"blood_cells","class_from":"sample","title":"NW41","description":"NW41","sex":"","geo_sample":"GSM4674977","access":"open","dbgap":"","n_runs":1,"first_public":"2020-07-27","attributes":[["source_name","blood"],["b cell type","MBC"],["cd69 status","CD69lo"],["cd45rb  status","CD45RBlo"],["labels","D4_B_M_DN"],["donor","D305"],["tissue","blood"]],"runs":[{"run_accession":"SRR12240117","experiment_accession":"SRX8748421","library_layout":"PAIRED","library_selection":"cDNA","instrument_model":"Illumina HiSeq 2500","read_count":29807802,"base_count":4471170300,"first_public":"2020-07-27","experiment_title":"Illumina HiSeq 2500 sequencing: GSM4674977: NW41 Homo sapiens RNA-Seq"}],"labels":[],"single_cell":false},{"sample_accession":"SAMN15559192","study_accession":"PRJNA646728","blood_class":"blood_cells","class_from":"sample","title":"NW40","description":"NW40","sex":"","geo_sample":"GSM4674976","access":"open","dbgap":"","n_runs":1,"first_public":"2020-07-27","attributes":[["source_name","blood"],["b cell type","MBC"],["cd69 status","CD69lo"],["cd45rb  status","CD45RBhi"],["labels","D4_