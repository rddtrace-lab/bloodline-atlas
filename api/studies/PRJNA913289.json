{"study_accession":"PRJNA913289","secondary_study_accession":"SRP413529","title":"Functional study of METTL16 on human Mesenchymal stem cells","description":"This study was try to investigate the function of METTL16 in extensive gene expression on human Mesenchymal stem cells (MSCs). Primary Bone marrow MSCs cultured in vitro was treated by Si-METTL16 to knock down METTL16 expression. Then, cells were conducted to RNA-Sequencing to test extensive gene expression. In addition, to further verify METTL16 regulated mRNAs, MSCs were co-cultured with CD14+ monocytes and set to METTL16 RIP-Sequencing.","pubmed":"","geo_series":"","n_samples":6,"study_labels":[],"samples":[{"sample_accession":"SAMN32289981","study_accession":"PRJNA913289","blood_class":"bone_marrow","class_from":"sample","title":"Human sample from Homo sapiens","description":"Human sample from Homo sapiens","sex":"male","geo_sample":"","access":"open","dbgap":"","n_runs":1,"first_public":"2022-12-18","attributes":[["isolate","healthy human"],["age","28.1"],["biomaterial_provider","Department of Stem Cell Therapy"],["sex","male"],["tissue","bone marrow"],["cell_subtype","Primary cell"]],"runs":[{"run_accession":"SRR22795895","experiment_accession":"SRX18755707","library_layout":"PAIRED","library_selection":"RANDOM PCR","instrument_model":"DNBSEQ-T7","read_count":59248004,"base_count":8887200600,"first_public":"2022-12-18","experiment_title":"DNBSEQ-T7 sequencing: RNA-Seq of homo sapiens: adult male MSCs"}],"labels":[],"single_cell":false},{"sample_accession":"SAMN32289982","study_accession":"PRJNA913289","blood_class":"bone_marrow","class_from":"sample","title":"Human sample from Homo sapiens","description":"Human sample from Homo sapiens","sex":"male","geo_sample":"","access":"open","dbgap":"","n_runs":1,"first_public":"2022-12-18","attributes":[["isolate","healthy human"],["age","23.1"],["biomaterial_provider","Department of Stem Cell Therapy"],["sex","male"],["tissue","bone marrow"],["cell_subtype","Prima