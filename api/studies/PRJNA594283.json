{"study_accession":"PRJNA594283","secondary_study_accession":"SRP235229","title":"Symmetric arginine dimethylation is selectively required for mRNA splicing and the initiation of type I and type III interferon signaling","description":"The goal of this study was to assess the extent of symmetric arginine dimethylation-dependent splicing and its associated signaling outcomes by using human T lymphocyte activation as a model system with a high rate of de novo transcription. Naïve human T lymphocytes were activated and treated with a selective inhibitor of PRMT5, PF-06829927, and investigated for changes in gene expression, alternative splicing, and chromatin accessibility. Overall design: Human naïve CD3+ (ATAC), CD4+ or CD8+ (expression and splicing) T lymphocytes were activated for 72 (expression and splicing) or 96 (ATAC) hours with platebound anti-CD3, anti-CD28, IL-2, and either DMSO or PF-06829927","pubmed":"32049022","geo_series":"","n_samples":18,"samples":[{"sample_accession":"SAMN13511182","study_accession":"PRJNA594283","blood_class":"blood_cells","class_from":"sample","title":"72h PF-9927 activated CD4+ rep 2","description":"72h PF-9927 activated CD4+ rep 2","sex":"","geo_sample":"GSM4210398","access":"open","dbgap":"","n_runs":1,"first_public":"2020-02-18","attributes":[["source_name","72h PF-9927 activated CD4+"],["tissue","peripheral blood"],["cell_type","Naive T lymphocytes"],["treatment","72h PF-9927"]],"runs":[{"run_accession":"SRR10611212","experiment_accession":"SRX7290484","library_layout":"PAIRED","library_selection":"cDNA","instrument_model":"Illumina HiSeq 4000","read_count":45066371,"base_count":9103406942,"first_public":"2020-02-18","experiment_title":"Illumina HiSeq 4000 sequencing: GSM4210398: 72h PF-9927 activated CD4+ rep 2 Homo sapiens RNA-Seq"}],"labels":[],"single_cell":false},{"sample_accession":"SAMN13511183","study_accession":"PRJNA594283","blood_class":"blood_cells","class_from":"sample","title":"72h PF-9927 activated CD4+ rep 1","