{"study_accession":"PRJNA545525","secondary_study_accession":"SRP199923","title":"Global gene expression profile of human peripheral blood-derived endothelial colony-forming cells is similar to coronary artery and umbilical vein endothelial cells","description":"We performed a transcriptome-wide study to compare gene expression profiles of ECFC, human coronary artery endothelial cells (HCAEC) and human umbilical vein endothelial cells (HUVEC) utilising subcutaneous adipose tissue-derived stromal vascular fraction (SAT-SVF) as a negative control population. Baseline gene expression in ECFC fully corresponds to their endothelial specification and may contribute to the basement membrane organisation, fulfilling the requirements for the suitable cell population for in vitro pre-endothelialisation of tubular scaffolds. Overall design: Comparison of gene expression in 4 cell types by Hiseq sequencing.","pubmed":"32260159","geo_series":"","n_samples":16,"study_labels":[],"samples":[{"sample_accession":"SAMN11895711","study_accession":"PRJNA545525","blood_class":"whole_blood","class_from":"study","title":"SAT-SVF_4","description":"SAT-SVF_4","sex":"","geo_sample":"GSM3834102","access":"open","dbgap":"","n_runs":1,"first_public":"2019-06-01","attributes":[["source_name","Cell culture"],["cell_type","stromal vascular fraction"],["strain","subcutaneous adipose tissue-derived stromal vascular fraction"]],"runs":[{"run_accession":"SRR9163322","experiment_accession":"SRX5936202","library_layout":"PAIRED","library_selection":"cDNA","instrument_model":"Illumina HiSeq 2000","read_count":8337414,"base_count":2201077296,"first_public":"2019-06-01","experiment_title":"Illumina HiSeq 2000 sequencing: GSM3834102: SAT-SVF_4 Homo sapiens RNA-Seq"}],"labels":[],"single_cell":false},{"sample_accession":"SAMN11895712","study_accession":"PRJNA545525","blood_class":"whole_blood","class_from":"study","title":"SAT-SVF_3","description":"SAT-SVF_3","sex":"","geo_sample":"GSM3834101","access":"open"