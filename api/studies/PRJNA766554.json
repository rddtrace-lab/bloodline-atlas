{"study_accession":"PRJNA766554","secondary_study_accession":"SRP338834","title":"Investigation of human peripheral T cells responsive to SARS-CoV-2 antigens","description":"To elucidate the T cell epitopes of SARS-CoV-2, we stimulated human PBMCs from healthy donors and convalescent COVID-19 patients with various SARS-CoV-2 antigens, sorted the activated T cells and performed sc-RNA and -TCR sequencing. We obtained thousands of T cell clonotypes that responded to SARS-CoV-2 antigens, and identified the epitopes and restricting HLAs of several clonotypes that were significantly expanded in the COVID-19 patients. Overall design: Determination of the TCR and mRNA expression of human T cells stimulated with SARS-CoV-2 antigens.","pubmed":"34647971","geo_series":"","n_samples":30,"samples":[{"sample_accession":"SAMN21850637","study_accession":"PRJNA766554","blood_class":"pbmc","class_from":"sample","title":"AIM sort T cell 1 GEX","description":"AIM sort T cell 1 GEX","sex":"","geo_sample":"GSM5597612","access":"open","dbgap":"","n_runs":2,"first_public":"2021-10-09","attributes":[["source_name","PBMC"],["cell_type","T cells"],["treatment","20 hrs stimulation"]],"runs":[{"run_accession":"SRR16081404","experiment_accession":"SRX12367847","library_layout":"PAIRED","library_selection":"cDNA","instrument_model":"Illumina NovaSeq 6000","read_count":238229961,"base_count":27872905437,"first_public":"2021-10-09","experiment_title":"Illumina NovaSeq 6000 sequencing: GSM5597612: AIM sort T cell 1 GEX Homo sapiens RNA-Seq"},{"run_accession":"SRR16081405","experiment_accession":"SRX12367847","library_layout":"PAIRED","library_selection":"cDNA","instrument_model":"Illumina NovaSeq 6000","read_count":28462493,"base_count":3330111681,"first_public":"2021-10-09","experiment_title":"Illumina NovaSeq 6000 sequencing: GSM5597612: AIM sort T cell 1 GEX Homo sapiens RNA-Seq"}],"labels":[]},{"sample_accession":"SAMN21850638","study_accession":"PRJNA766554","blood_class":"pbmc","class_from":"