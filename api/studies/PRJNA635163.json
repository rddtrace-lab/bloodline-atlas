{"study_accession":"PRJNA635163","secondary_study_accession":"SRP264838","title":"lncRNA expression alterations in mesothelial cells treated with exosomes","description":"To investigate whether exosomes from ovarian cancer cell lines could change lncRNA expression in mesothelial cells, exosomes from ovarian cancer cells (SKOV3 cells, A2780 cells) were added to MeT-5A cells, PBS treatment was set as blank control. Total RNAs of MeT-5A cells treated with exosomes were extracted, and then lncRNA sequencing was performed. Overall design: Treatment of exosomes from SKOV3 and A2780 cells induced lncRNA expression in human mesothelial cell lines was measured at 48 hours after exposure to dose of 50ug.","pubmed":"","geo_series":"","n_samples":3,"samples":[{"sample_accession":"SAMN15027806","study_accession":"PRJNA635163","blood_class":"plasma_serum_cfrna","class_from":"sample","title":"MeT-5A_A2780 Exos","description":"MeT-5A_A2780 Exos","sex":"","geo_sample":"GSM4568918","access":"open","dbgap":"","n_runs":1,"first_public":"2021-09-03","attributes":[["source_name","MeT-5A cells"],["cell_type","human mesothelial cells"],["treatment","treated with A2780 exosomes"]],"runs":[{"run_accession":"SRR11851847","experiment_accession":"SRX8401957","library_layout":"PAIRED","library_selection":"cDNA","instrument_model":"Illumina HiSeq 3000","read_count":56527716,"base_count":16958314800,"first_public":"2021-09-03","experiment_title":"Illumina HiSeq 3000 sequencing: GSM4568918: MeT-5A_A2780 Exos Homo sapiens RNA-Seq"}],"labels":[],"single_cell":false},{"sample_accession":"SAMN15027808","study_accession":"PRJNA635163","blood_class":"plasma_serum_cfrna","class_from":"sample","title":"MeT-5A_SKOV3 Exos","description":"MeT-5A_SKOV3 Exos","sex":"","geo_sample":"GSM4568917","access":"open","dbgap":"","n_runs":1,"first_public":"2021-09-03","attributes":[["source_name","MeT-5A cells"],["cell_type","human mesothelial cells"],["treatment","treated with SKOV3 exosomes"]],"runs":[{"run_accession":