{"study_accession":"PRJNA767405","secondary_study_accession":"SRP339349","title":"Gene expression of PBMC and isolated CD4 T cells from participants in Part A REDUC clinical trial","description":"REDUC Part A (NCT02092116) assessed the effect of romidepsin in ART-treated chronically HIV-1 infected individuals. Here, we studied the gene expression on PBMCs or isolated CD4 before and after the 3-cycle infusion of Romidepsin Overall design: Samples of PBMCs and isolated CD4 T cells from 6 participants in the part A REDUC clinical trial were taken before (v1) and 1 week after the 3 cycles of romidepsin infusion (v9). We identified differentially expressed genes between v9-v1. We did not include the only woman of the study in the analysis, but we upload the data for transparency","pubmed":"35325780","geo_series":"","n_samples":24,"study_labels":[],"samples":[{"sample_accession":"SAMN21901992","study_accession":"PRJNA767405","blood_class":"pbmc","class_from":"sample","title":"1107_v1_PBMC","description":"1107_v1_PBMC","sex":"male","geo_sample":"GSM5603586","access":"open","dbgap":"","n_runs":2,"first_public":"2022-04-01","attributes":[["source_name","PBMC"],["timepoint","v1"],["participant_id","1107"],["sex","male"],["age","60"]],"runs":[{"run_accession":"SRR16119537","experiment_accession":"SRX12405029","library_layout":"PAIRED","library_selection":"cDNA","instrument_model":"Illumina HiSeq 2000","read_count":77737409,"base_count":11816086168,"first_public":"2022-04-01","experiment_title":"Illumina HiSeq 2000 sequencing: GSM5603586: 1107_v1_PBMC Homo sapiens RNA-Seq"},{"run_accession":"SRR16119538","experiment_accession":"SRX12405029","library_layout":"PAIRED","library_selection":"cDNA","instrument_model":"Illumina HiSeq 2000","read_count":17769539,"base_count":2700969928,"first_public":"2022-04-01","experiment_title":"Illumina HiSeq 2000 sequencing: GSM5603586: 1107_v1_PBMC Homo sapiens RNA-Seq"}],"labels":[],"single_cell":false},{"sample_accession":"SAMN21901994","study