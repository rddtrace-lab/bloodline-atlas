{"study_accession":"PRJNA1147260","secondary_study_accession":"SRP525924","title":"RNAseq analysis of human neutrophils from people with rheumatoid arthritis","description":"We report gene expression profiles of blood neutrophils from (1) people newly-diagnosed with rheumatoid arthritis (early RA) before commencement of disease-modifying anti-rheumatic drug therapy, (2) DMARD-refractory RA (severe RA) before commencement of anti-TNF therapy and (3) healthy controls. Overall design: Neutrophils (purity >97%) were isolated from peripheral blood by centrifugation through density-gradient reagent (Polymorphprep or Ficoll-Paque). RNA was isolated using Trizol:chloroform, cleaned up by Qiagen RNeasy kit including on-column DNase digest and sequenced on the Illumina HiSeq 2000 platform.","pubmed":"39969221;40590363","geo_series":"","n_samples":41,"samples":[{"sample_accession":"SAMN43153147","study_accession":"PRJNA1147260","blood_class":"blood_cells","class_from":"sample","title":"Blood neutrophil, 0h, ERA replicate 13","description":"Blood neutrophil, 0h, ERA replicate 13","sex":"","geo_sample":"GSM8453452","access":"open","dbgap":"","n_runs":1,"first_public":"2025-05-15","attributes":[["source_name","peripheral blood"],["tissue","peripheral blood"],["cell_type","Neutrophil"],["subject status","Early RA"],["geo_loc_name","missing"],["collection_date","missing"]],"runs":[{"run_accession":"SRR30217620","experiment_accession":"SRX25680595","library_layout":"SINGLE","library_selection":"cDNA","instrument_model":"Illumina HiSeq 2000","read_count":52680861,"base_count":2581362189,"first_public":"2025-05-15","experiment_title":"Illumina HiSeq 2000 sequencing: GSM8453452: Blood neutrophil, 0h, ERA replicate 13 Homo sapiens RNA-Seq"}],"labels":[],"single_cell":false},{"sample_accession":"SAMN43153148","study_accession":"PRJNA1147260","blood_class":"blood_cells","class_from":"sample","title":"Blood neutrophil, 0h, ERA replicate 12","description":"Blood neutrophil, 0h, ERA replicat