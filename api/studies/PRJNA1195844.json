{"study_accession":"PRJNA1195844","secondary_study_accession":"SRP550200","title":"Transcriptome sequencing of NKG2A-positive and negative Natural Killer cells","description":"This study explores the characteristics of NKG2A+ subsets within two distinct subpopulations of NK cells: the classical adaptive NK cells with the CD57+NKG2C+ phenotype and their less differentiated potential precursors, defined as CD56dimCD57-NKG2C+. Comparative transcriptomic analysis was performed to assess differences between these NKG2A+ subsets and their corresponding NKG2A-negative counterparts. The findings provide valuable insights into the molecular mechanisms underlying adaptive NK cell differentiation and the role of NKG2A expression in this process, contributing to a deeper understanding of adaptive NK cell development.","pubmed":"","geo_series":"","n_samples":48,"samples":[{"sample_accession":"SAMN45229888","study_accession":"PRJNA1195844","blood_class":"blood_cells","class_from":"sample","title":"Human sample from Homo sapiens","description":"Human sample from Homo sapiens","sex":"female","geo_sample":"","access":"open","dbgap":"","n_runs":1,"first_public":"2025-12-16","attributes":[["isolate","Donor1_CD57negNKG2CposNKG2Apos_rep1"],["age","59"],["biomaterial_provider","Laboratory of cell interactions, Russian Federation, Moscow, Ulitsa Miklukho-Maklaya, 16/10"],["collection_date","2024-03-07"],["geo_loc_name","Russia: Moscow"],["sex","female"],["tissue","periferial blood"],["cell_type","NK cells"],["health_state","healthy"]],"runs":[{"run_accession":"SRR31646762","experiment_accession":"SRX27009811","library_layout":"PAIRED","library_selection":"cDNA","instrument_model":"Illumina NovaSeq 6000","read_count":13305245,"base_count":3991573500,"first_public":"2025-12-16","experiment_title":"Illumina NovaSeq 6000 sequencing: RNA-Seq of homo sapiens: NK cells"}],"labels":[]},{"sample_accession":"SAMN45229889","study_accession":"PRJNA1195844","blood_class":"blood_cells","class_from":"sa