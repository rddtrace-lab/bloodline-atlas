{"study_accession":"PRJNA872344","secondary_study_accession":"SRP394221","title":"Transcriptomic differences in CCR10+ versus CCR10- regulatory T cells (Tregs)","description":"We identified decreases in circulating CCR10+ Tregs in human hypertension. In order to better determine the phenotype of these cells, we performed bulk RNA sequencing of flow sorted human CCR10+ versus CCR10- Tregs from healthy control individuals. Results revealed evidence of increased T cell activation in CCR10+ Tregs. Overall design: PMBCs from 3 healthy controls were isolated and flow sorted into distinct CCR10+ Treg and CCR10- Treg populations from each sample. Bulk RNA sequencing was performed on RNA extracted from each cell population from each donor.","pubmed":"37034287","geo_series":"","n_samples":6,"samples":[{"sample_accession":"SAMN30456125","study_accession":"PRJNA872344","blood_class":"pbmc","class_from":"sample","title":"CCR10- Tregs, biol rep 3","description":"CCR10- Tregs, biol rep 3","sex":"","geo_sample":"GSM6503231","access":"open","dbgap":"","n_runs":1,"first_public":"2023-06-05","attributes":[["source_name","flow sorted PBMCs"],["tissue","blood"],["cell_type","CCR10- Tregs"],["individual","donor 3"]],"runs":[{"run_accession":"SRR21227316","experiment_accession":"SRX17237696","library_layout":"PAIRED","library_selection":"cDNA","instrument_model":"Illumina NovaSeq 6000","read_count":41023426,"base_count":12389074652,"first_public":"2023-06-05","experiment_title":"Illumina NovaSeq 6000 sequencing: GSM6503231: CCR10- Tregs, biol rep 3 Homo sapiens RNA-Seq"}],"labels":[]},{"sample_accession":"SAMN30456126","study_accession":"PRJNA872344","blood_class":"pbmc","class_from":"sample","title":"CCR10- Tregs, biol rep 2","description":"CCR10- Tregs, biol rep 2","sex":"","geo_sample":"GSM6503230","access":"open","dbgap":"","n_runs":1,"first_public":"2023-06-05","attributes":[["source_name","flow sorted PBMCs"],["tissue","blood"],["cell_type","CCR10- Tregs"],["individual","donor 2"]],