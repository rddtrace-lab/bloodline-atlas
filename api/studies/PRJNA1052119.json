{"study_accession":"PRJNA1052119","secondary_study_accession":"SRP477867","title":"B cell activation gene signature in blood and liver of HBeAg+ immune active chronic hepatitis B patients","description":"In this study, we performed an unbiased characterization of total CD19+ B cells purified from peripheral blood of immune active chronic HBV patients and showed that HBV induced a B cell activation gene signature in blood but did not significantly induce interferon-stimulated genes (ISGs). Overall design: We conducted RNA-seq on FACS purified peripheral blood CD19+ B cells of healthy controls (CTRL), chronic HBV and HCV patients. Patients that did not receive antiviral treatment with relatively high viral load and/or liver inflammation were selected for this study.","pubmed":"38847286","geo_series":"","n_samples":21,"samples":[{"sample_accession":"SAMN38816107","study_accession":"PRJNA1052119","blood_class":"pbmc","class_from":"sample","title":"HCV-X780","description":"HCV-X780","sex":"","geo_sample":"GSM7974821","access":"open","dbgap":"","n_runs":1,"first_public":"2024-06-23","attributes":[["source_name","PBMCs"],["tissue","PBMCs"],["cell_type","CD19+ B cells"],["disease","chronic HCV"],["treatment","missing"],["geo_loc_name","missing"],["collection_date","missing"]],"runs":[{"run_accession":"SRR27202972","experiment_accession":"SRX22882756","library_layout":"PAIRED","library_selection":"cDNA","instrument_model":"Illumina NovaSeq 6000","read_count":30244553,"base_count":9133855006,"first_public":"2024-06-23","experiment_title":"Illumina NovaSeq 6000 sequencing: GSM7974821: HCV-X780 Homo sapiens RNA-Seq"}],"labels":[]},{"sample_accession":"SAMN38816108","study_accession":"PRJNA1052119","blood_class":"pbmc","class_from":"sample","title":"HCV-X406","description":"HCV-X406","sex":"","geo_sample":"GSM7974820","access":"open","dbgap":"","n_runs":1,"first_public":"2024-06-23","attributes":[["source_name","PBMCs"],["tissue","PBMCs"],["cell_type","CD19+ B cells"],["disease"