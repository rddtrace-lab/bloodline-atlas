{"study_accession":"PRJNA867560","secondary_study_accession":"SRP390672","title":"A Role for IFITM3 in Regulating Fibrinogen Endocytosis and Platelet Reactivity in Non-Viral Sepsis","description":"Platelets and megakaryocytes are critical players in immune responses. Recent reports suggest infection and inflammation alter the megakaryocyte and platelet transcriptome to induce altered platelet reactivity. We examined if non-viral sepsis induces differential platelet gene expression and reactivity. Non-viral sepsis significantly upregulated IFITM3, an interferon responsive gene that restricts viral replication Overall design: 6 healthy donors and 6 non-viral sepsis patients","pubmed":"36194487","geo_series":"","n_samples":12,"samples":[{"sample_accession":"SAMN30212999","study_accession":"PRJNA867560","blood_class":"platelet","class_from":"sample","title":"Donor 6","description":"Donor 6","sex":"","geo_sample":"GSM6437730","access":"open","dbgap":"","n_runs":1,"first_public":"2022-12-04","attributes":[["source_name","platelet"],["tissue","platelet"],["subject status","healthy donor"]],"runs":[{"run_accession":"SRR20983421","experiment_accession":"SRX17000894","library_layout":"PAIRED","library_selection":"cDNA","instrument_model":"Illumina NovaSeq 6000","read_count":118408236,"base_count":35759287272,"first_public":"2022-12-04","experiment_title":"Illumina NovaSeq 6000 sequencing: GSM6437730: Donor 6 Homo sapiens RNA-Seq"}],"labels":[],"single_cell":false},{"sample_accession":"SAMN30213000","study_accession":"PRJNA867560","blood_class":"platelet","class_from":"sample","title":"Donor 5","description":"Donor 5","sex":"","geo_sample":"GSM6437729","access":"open","dbgap":"","n_runs":1,"first_public":"2022-12-04","attributes":[["source_name","platelet"],["tissue","platelet"],["subject status","healthy donor"]],"runs":[{"run_accession":"SRR20983422","experiment_accession":"SRX17000893","library_layout":"PAIRED","library_selection":"cDNA","instrument_model":"Illumina NovaSeq