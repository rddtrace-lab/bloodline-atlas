{"study_accession":"PRJNA1177448","secondary_study_accession":"SRP540672","title":"Adenylyl cyclase 7 knock-down in human primary CD4+ T cells","description":"An amino acid substitution in adenylyl cyclase 7 (ADCY7) predisposes carriers to ulcerative colitis. We modeled this mutation in human primary CD4+ T cells using siRNA knock-down. T cells were isolated from four independent healthy human donors. Each donor has a pair of specimens, one with non-targeting (NT) siRNA and one with siADCY7 siRNA. These specimens underwent total RNA extraction and mRNA-sequencing on the NovaSeq 6000 (Illumina).","pubmed":"","geo_series":"","n_samples":7,"study_labels":[],"samples":[{"sample_accession":"SAMN44425148","study_accession":"PRJNA1177448","blood_class":"blood_cells","class_from":"sample","title":"Human sample from Homo sapiens","description":"Human sample from Homo sapiens","sex":"missing","geo_sample":"","access":"open","dbgap":"","n_runs":1,"first_public":"2024-10-27","attributes":[["isolate","Donor 1"],["age","21-60 y"],["biomaterial_provider","Center for Applied Genomics @ CHOP"],["collection_date","2024-05-16"],["geo_loc_name","USA: Philadelphia"],["sex","missing"],["tissue","Blood"],["cell_type","Primary CD4+ T cells"],["disease","Healthy"],["treatment","NT"]],"runs":[{"run_accession":"SRR31107523","experiment_accession":"SRX26490471","library_layout":"PAIRED","library_selection":"PolyA","instrument_model":"Illumina NovaSeq 6000","read_count":50291879,"base_count":10158959558,"first_public":"2024-10-27","experiment_title":"Illumina NovaSeq 6000 sequencing: RNA-seq of human primary CD4+ T cells"}],"labels":[],"single_cell":false},{"sample_accession":"SAMN44425149","study_accession":"PRJNA1177448","blood_class":"blood_cells","class_from":"sample","title":"Human sample from Homo sapiens","description":"Human sample from Homo sapiens","sex":"missing","geo_sample":"","access":"open","dbgap":"","n_runs":1,"first_public":"2024-10-27","attributes":[["isolate","Donor 1"],["ag