{"study_accession":"PRJNA542253","secondary_study_accession":"SRP197509","title":"Pathway-Level Information ExtractoR (PLIER) for gene expression data","description":"A major challenge in gene expression analysis is to accurately infer relevant biological insight, such as variation in cell type proportion or pathway activity, from global gene expression studies. We present a general solution for this problem that outperforms available cell proportion inference algorithms, and is more widely useful to automatically identify specific pathways that regulate gene expression. Our method improves replicability and biological insight when applied to trans-eQTL identification. Overall design: Make cell type predictions based on expression data and validate by flow cytometery","pubmed":"31249421","geo_series":"","n_samples":36,"samples":[{"sample_accession":"SAMN11618180","study_accession":"PRJNA542253","blood_class":"whole_blood","class_from":"sample","title":"BD-8034: RNA-seq subject 30","description":"BD-8034: RNA-seq subject 30","sex":"","geo_sample":"GSM3759255","access":"open","dbgap":"","n_runs":2,"first_public":"2019-11-01","attributes":[["source_name","whole blood"],["tissue","whole blood"]],"runs":[{"run_accession":"SRR9040044","experiment_accession":"SRX5817179","library_layout":"SINGLE","library_selection":"cDNA","instrument_model":"Illumina HiSeq 2500","read_count":11305684,"base_count":1141874084,"first_public":"2019-11-01","experiment_title":"Illumina HiSeq 2500 sequencing: GSM3759255: BD-8034: RNA-seq subject 30 Homo sapiens RNA-Seq"},{"run_accession":"SRR9040045","experiment_accession":"SRX5817179","library_layout":"SINGLE","library_selection":"cDNA","instrument_model":"Illumina HiSeq 2500","read_count":11289691,"base_count":1140258791,"first_public":"2019-11-01","experiment_title":"Illumina HiSeq 2500 sequencing: GSM3759255: BD-8034: RNA-seq subject 30 Homo sapiens RNA-Seq"}],"labels":[],"single_cell":false},{"sample_accession":"SAMN11618181","study_accessi