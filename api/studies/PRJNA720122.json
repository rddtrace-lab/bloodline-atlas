{"study_accession":"PRJNA720122","secondary_study_accession":"SRP313687","title":"Bulk RNA seq profile of CD8+ T cells in peripheral blood lymphocytes from 28 melanoma patients","description":"CD8+ T cells are the primary target of immune checkpoint inhibitor (ICI) therapy in the treatment of cancers. ICI therapy only benefits a subset of patients and complicating this issue is a reliable prediction method that does not require invasive biopsies. We built an ICI response prediction model using scRNA seq data, and for validation of the model here we profiled transcriptome of CD8+ T cells in peripheral blood lymphocytes of 28 melanoma patients that responded to ICI or not using bulk RNA sequencing. Overall design: CD8+ T cells in peripheral blood lymphocytes from 28 melanoma patients were sorted and profiled with RNA sequencing","pubmed":"34807232","geo_series":"","n_samples":28,"samples":[{"sample_accession":"SAMN18636493","study_accession":"PRJNA720122","blood_class":"pbmc","class_from":"sample","title":"T_cell_Pt_18","description":"T_cell_Pt_18","sex":"male","geo_sample":"GSM5221422","access":"open","dbgap":"","n_runs":2,"first_public":"2021-11-18","attributes":[["source_name","CD8+ T cell from PBMC of Patient 18"],["cell_type","CD8+ T cells"],["tissue","peripheral blood"],["io status","R"],["age","72"],["sex","male"]],"runs":[{"run_accession":"SRR14154400","experiment_accession":"SRX10523017","library_layout":"PAIRED","library_selection":"cDNA","instrument_model":"Illumina NovaSeq 6000","read_count":19152223,"base_count":3810011306,"first_public":"2021-11-18","experiment_title":"Illumina NovaSeq 6000 sequencing: GSM5221422: T_cell_Pt_18 Homo sapiens RNA-Seq"},{"run_accession":"SRR14154401","experiment_accession":"SRX10523017","library_layout":"PAIRED","library_selection":"cDNA","instrument_model":"Illumina NovaSeq 6000","read_count":18223849,"base_count":3625451255,"first_public":"2021-11-18","experiment_title":"Illumina NovaSeq 6000 sequencing: GSM5221422: T_cell