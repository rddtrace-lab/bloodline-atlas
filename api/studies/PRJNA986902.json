{"study_accession":"PRJNA986902","secondary_study_accession":"SRP445571","title":"Acute Myeloid Leukemia patient/ CD34+ healthy donor RNA-seq","description":"AML is an aggressive and heterogenous hematologic malignancy. Here, we performed bulk RNA sequencing of 16 AML patients and primary hematopoietic cell populations, CD34+ HSC and CD14+monocytes to understand transcriptional and post-transcriptional mechanisms that drive leukemogenesis and block AML differentiation. Our findings provide a better understanding of gene regulatory pathways in AML in comparison to normal hematopoietic cells, which may provide new therapeutic strategy to selectively target AML cells. Overall design: RNA-sequencing on bone marrow aspirates of AML patients and CD34+ cells","pubmed":"","geo_series":"","n_samples":17,"samples":[{"sample_accession":"SAMN35881520","study_accession":"PRJNA986902","blood_class":"bone_marrow","class_from":"sample","title":"Patient-rep09","description":"Patient-rep09","sex":"","geo_sample":"GSM7507904","access":"open","dbgap":"","n_runs":5,"first_public":"2026-06-02","attributes":[["source_name","bone marrow"],["tissue","bone marrow"],["cell_type","whole BM"],["geo_loc_name","missing"],["collection_date","missing"]],"runs":[{"run_accession":"SRR25009954","experiment_accession":"SRX20765275","library_layout":"PAIRED","library_selection":"cDNA","instrument_model":"Illumina NovaSeq 6000","read_count":23261163,"base_count":2326116300,"first_public":"2026-06-02","experiment_title":"Illumina NovaSeq 6000 sequencing: GSM7507904: Patient-rep09 Homo sapiens RNA-Seq"},{"run_accession":"SRR25009955","experiment_accession":"SRX20765275","library_layout":"PAIRED","library_selection":"cDNA","instrument_model":"Illumina NovaSeq 6000","read_count":23014297,"base_count":2301429700,"first_public":"2026-06-02","experiment_title":"Illumina NovaSeq 6000 sequencing: GSM7507904: Patient-rep09 Homo sapiens RNA-Seq"},{"run_accession":"SRR25009956","experiment_accession":"SRX20765275","