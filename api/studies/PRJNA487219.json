{"study_accession":"PRJNA487219","secondary_study_accession":"SRP158591","title":"Transcriptional analysis of whole blood and PBMCs from human HOIP deficiency patients","description":"LUBAC (linear ubiquitin assembly complex) consists of HOIP, HOIL1 and SHARPIN. HOIP deficiency has been characterized by immunodeficiency, autoinflammation and amylopectinosis. To explore the molecular mechanism of the autoinflammation, we performed a transcriptome-wide analysis using whole blood and unstimulated PBMCs of a HOIP deficiency patient. Overall design: RNAseq using the whole blood and PBMCs of the HOIP deficiency patient, healthy unrelated controls and the patient's parent (heterozygous carrier of a mutation in HOIP)","pubmed":"","geo_series":"","n_samples":11,"samples":[{"sample_accession":"SAMN09879957","study_accession":"PRJNA487219","blood_class":"pbmc","class_from":"sample","title":"PBMCs_HOIP_2","description":"PBMCs_HOIP_2","sex":"","geo_sample":"GSM3351135","access":"open","dbgap":"","n_runs":1,"first_public":"2018-09-26","attributes":[["source_name","PBMCs"],["tissue","PBMC"],["disease","HOIP deficiency"]],"runs":[{"run_accession":"SRR7739186","experiment_accession":"SRX4595544","library_layout":"SINGLE","library_selection":"cDNA","instrument_model":"Illumina HiSeq 2500","read_count":70278443,"base_count":3513922150,"first_public":"2018-09-26","experiment_title":"Illumina HiSeq 2500 sequencing: GSM3351135: PBMCs_HOIP_2 Homo sapiens RNA-Seq"}],"labels":[],"single_cell":false},{"sample_accession":"SAMN09879958","study_accession":"PRJNA487219","blood_class":"pbmc","class_from":"sample","title":"PBMCs_HOIP_1","description":"PBMCs_HOIP_1","sex":"","geo_sample":"GSM3351134","access":"open","dbgap":"","n_runs":1,"first_public":"2018-09-26","attributes":[["source_name","PBMCs"],["tissue","PBMC"],["disease","HOIP deficiency"]],"runs":[{"run_accession":"SRR7739185","experiment_accession":"SRX4595543","library_layout":"SINGLE","library_selection":"cDNA","instrument_model":"Ill