{"study_accession":"PRJNA810717","secondary_study_accession":"SRP361604","title":"Long RNA profiles of human brain extracellular vesicles in Alzheimer's disease","description":"Alzheimer's disease (AD) is the most common neurodegenerative disorder. Extracellular vesicles (EVs) are carriers of nucleic acids, lipids and proteins, and are known to play a significant role in neurodegenerative pathogenesis. The goals of this study are to compare long RNA (exLR) profiling of EVs in normal human brains with which in AD human brain. EVs were isolated from frontal cortex of normal control (n=10) and AD (n=8) donors. Overall design: Examination of long RNA (exLR) profiling in normal human brain-derived EVs and AD human brain-derived EVs.","pubmed":"36818567","geo_series":"","n_samples":18,"study_labels":[],"samples":[{"sample_accession":"SAMN26276643","study_accession":"PRJNA810717","blood_class":"plasma_serum_cfrna","class_from":"sample","title":"PTB108-EVs","description":"PTB108-EVs","sex":"","geo_sample":"GSM5918759","access":"open","dbgap":"","n_runs":1,"first_public":"2023-01-01","attributes":[["source_name","brain frontal cortex"],["tissue","brain frontal cortex"],["disease","Alzheimer's disease"],["fraction","extracellular vesicles (EVs)"]],"runs":[{"run_accession":"SRR18151152","experiment_accession":"SRX14298955","library_layout":"PAIRED","library_selection":"cDNA","instrument_model":"Illumina HiSeq 3000","read_count":32280996,"base_count":9684298800,"first_public":"2023-01-01","experiment_title":"Illumina HiSeq 3000 sequencing: GSM5918759: PTB108-EVs Homo sapiens RNA-Seq"}],"labels":[],"single_cell":false},{"sample_accession":"SAMN26276644","study_accession":"PRJNA810717","blood_class":"plasma_serum_cfrna","class_from":"sample","title":"PTB050-EVs","description":"PTB050-EVs","sex":"","geo_sample":"GSM5918758","access":"open","dbgap":"","n_runs":1,"first_public":"2023-01-01","attributes":[["source_name","brain frontal cortex"],["tissue","brain frontal cortex"],["dise