{"study_accession":"PRJNA777938","secondary_study_accession":"SRP350250","title":"Transcriptomic analysis of critically ill COVID-19 patients and other patients with AHRF in the ICU","description":"To identify differences in immune pathology among severe COVID-19 patients, we analyzed whole blood transcriptomes from individuals with COVID-19-induced acute hypoxic respiratory failure) AHRF, those with other viral and non-viral-induced AHRF, and controls, who were patients admitted to the intensive care unit (ICU) on mechanical ventilation but without evidence of AHRF. As a result, we identified gene signatures that differentiated COVID-19 patients from other cohorts and characterized 2 groups of COVID-19 patients with conserved and differential enrichment of immune cell and pathway gene signatures.","pubmed":"","geo_series":"","n_samples":48,"samples":[{"sample_accession":"SAMN22894607","study_accession":"PRJNA777938","blood_class":"whole_blood","class_from":"sample","title":"Human sample from Homo sapiens","description":"Homo sapiens","sex":"female","geo_sample":"","access":"open","dbgap":"","n_runs":1,"first_public":"2022-09-14","attributes":[["isolate","29A"],["age","69"],["biomaterial_provider","University of Virginia ICU Biorepository"],["sex","female"],["tissue","Whole Blood"]],"runs":[{"run_accession":"SRR17195509","experiment_accession":"SRX13375925","library_layout":"PAIRED","library_selection":"other","instrument_model":"Illumina HiSeq 4000","read_count":24392042,"base_count":7317612600,"first_public":"2022-09-14","experiment_title":"Illumina HiSeq 4000 sequencing: RNA-seq of homo sapiens: whole blood"}],"labels":[]},{"sample_accession":"SAMN22894611","study_accession":"PRJNA777938","blood_class":"whole_blood","class_from":"sample","title":"Human sample from Homo sapiens","description":"Homo sapiens","sex":"male","geo_sample":"","access":"open","dbgap":"","n_runs":1,"first_public":"2022-09-14","attributes":[["isolate","116A"],["age","44"],["biomaterial_prov