{"study_accession":"PRJNA646808","secondary_study_accession":"SRP272310","title":"Mammalian circRNA Atlas","description":"We developed a new pipeline for accurate circRNA detection. We build a new atlas for characterizing circRNA in human, monkey, mouse, rat and drosophila brain. Our approach allows full annotation of circRNAs with fewer false positives and negatives than any individual pipeline or combination of them. Moreover, our approach is more sensitive than any individual pipeline and allows more accurate quantification and larger number of differentially expressed circRNAs. Overall design: We obtained commercial purified RNA and performed rRNA depletion. Then we treated total RNA with RNAseR and prepared a library.","pubmed":"34556162","geo_series":"","n_samples":4,"samples":[{"sample_accession":"SAMN15566029","study_accession":"PRJNA646808","blood_class":"whole_blood","class_from":"sample","title":"Human-Blood-RNaseR","description":"Human-Blood-RNaseR","sex":"not provided","geo_sample":"GSM4675897","access":"open","dbgap":"","n_runs":1,"first_public":"2021-09-11","attributes":[["source_name","Human Blood Total RNA (HR-705) Zyagen"],["tissue","Blood"],["sex","not provided"],["age","not provided"],["treatment","Ribodepletion, RNaseR"]],"runs":[{"run_accession":"SRR12244942","experiment_accession":"SRX8753060","library_layout":"PAIRED","library_selection":"cDNA","instrument_model":"Illumina HiSeq 4000","read_count":6115015,"base_count":1785584380,"first_public":"2021-09-11","experiment_title":"Illumina HiSeq 4000 sequencing: GSM4675897: Human-Blood-RNaseR Homo sapiens RNA-Seq"}],"labels":[]},{"sample_accession":"SAMN15566032","study_accession":"PRJNA646808","blood_class":"whole_blood","class_from":"sample","title":"Human-Blood-Mock","description":"Human-Blood-Mock","sex":"not provided","geo_sample":"GSM4675896","access":"open","dbgap":"","n_runs":2,"first_public":"2021-09-11","attributes":[["source_name","Human Blood Total RNA (HR-705) Zyagen"],["tissue","Bloo