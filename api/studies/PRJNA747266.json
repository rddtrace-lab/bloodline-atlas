{"study_accession":"PRJNA747266","secondary_study_accession":"SRP328690","title":"microRNAs in Newborns with Low Birth Weight","description":"Children with low birth weight (LBW) are at increased risk for developing endocrinemetabolic disorders. Deregulation of specific microRNAs (miRNAs) could underscore the programming of those pathologies. Patients and methods: miRNA profile was assessed by RNA sequencing in serum samples of 12 selected mother-newborn pairs, including 6 LBW and 6 AGA newborns. Differentially expressed miRNAs were validated by RT-qPCR in a larger cohort [49 maternal samples and 49 umbilical cord serum samples (24 LBW, 25 AGA)].","pubmed":"","geo_series":"","n_samples":24,"samples":[{"sample_accession":"SAMN20283921","study_accession":"PRJNA747266","blood_class":"plasma_serum_cfrna","class_from":"sample","title":"75520414-Maternal serum-AGA","description":"75520414-Maternal serum-AGA","sex":"female","geo_sample":"","access":"open","dbgap":"","n_runs":1,"first_public":"2021-11-17","attributes":[["isolate","adult woman"],["age","34.41917808219178"],["biomaterial_provider","metabolic endocrinology lab IRSJD"],["sex","female"],["tissue","Maternal serum"],["Patient","P1"]],"runs":[{"run_accession":"SRR15176766","experiment_accession":"SRX11484001","library_layout":"SINGLE","library_selection":"cDNA","instrument_model":"NextSeq 550","read_count":15006889,"base_count":1140523564,"first_public":"2021-11-17","experiment_title":"NextSeq 550 sequencing: RNA-Seq of Homo sapiens: adult women serum sample"}],"labels":[]},{"sample_accession":"SAMN20283922","study_accession":"PRJNA747266","blood_class":"plasma_serum_cfrna","class_from":"sample","title":"75828413-Maternal serum-AGA","description":"75828413-Maternal serum-AGA","sex":"female","geo_sample":"","access":"open","dbgap":"","n_runs":1,"first_public":"2021-11-17","attributes":[["isolate","adult woman"],["age","34.465753424657535"],["biomaterial_provider","metabolic endocrinology lab IRSJD"],["sex","female"]