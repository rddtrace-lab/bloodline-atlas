{"study_accession":"PRJNA1417155","secondary_study_accession":"SRP672890","title":"Transcriptomic Analysis of Human MDMs Infected with Wild-type HIV-1 and ASP-deficient Mutants","description":"This study aims to investigate the regulatory role of the HIV-1 antisense protein (ASP) in host-virus interactions. We performed RNA-seq on human monocyte-derived macrophages (MDMs) infected with either wild-type HIV-1 (group A) or an ASP-deficient mutant (group B). By comparing the whole-transcriptome profiles, we identified specific host genes and immune pathways modulated by ASP, providing insights into its function in viral evasion and antiviral response regulation.","pubmed":"","geo_series":"","n_samples":6,"study_labels":[],"samples":[{"sample_accession":"SAMN54989909","study_accession":"PRJNA1417155","blood_class":"blood_cells","class_from":"sample","title":"Human sample from Homo sapiens","description":"Human sample from Homo sapiens","sex":"not collected","geo_sample":"","access":"open","dbgap":"","n_runs":1,"first_public":"2026-02-10","attributes":[["isolate","Human Monocyte-Derived Macrophages"],["age","not collected"],["biomaterial_provider","Shanghai Public Health Clinical Center"],["collection_date","2024-10-01"],["geo_loc_name","China"],["sex","not collected"],["tissue","Peripheral Blood"],["sample_type","Human Monocyte-Derived Macrophages"]],"runs":[{"run_accession":"SRR37061706","experiment_accession":"SRX32008077","library_layout":"PAIRED","library_selection":"PolyA","instrument_model":"Illumina HiSeq X","read_count":22660278,"base_count":6798083400,"first_public":"2026-02-10","experiment_title":"Illumina HiSeq X sequencing: RNA-Seq of Human Monocyte-Derived Macrophages"}],"labels":[],"single_cell":false},{"sample_accession":"SAMN54989910","study_accession":"PRJNA1417155","blood_class":"blood_cells","class_from":"sample","title":"Human sample from Homo sapiens","description":"Human sample from Homo sapiens","sex":"not collected","geo_sample":"","access":"open