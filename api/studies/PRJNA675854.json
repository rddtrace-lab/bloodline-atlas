{"study_accession":"PRJNA675854","secondary_study_accession":"SRP292009","title":"circRNA expression and characterization in multiple sclerosis patients and controls","description":"Circular RNAs (circRNAs) are a class of non-coding RNAs increasingly emerging as crucial actors in the pathogenesis and progression of human diseases, including autoimmune and neurological disorders as multiple sclerosis (MS). We performed RNA-seq experiments on circRNA-enriched samples, derived from peripheral blood mononuclear cells of 10 MS patients and 10 matched controls. We detected 5,663 circRNAs, and expression analysis revealed 166 differentially expressed circRNAs in MS patients. Overall design: circularRNA profile from 10 MS patients and 10 controls in peripheral blood mononuclear cells","pubmed":"","geo_series":"","n_samples":20,"study_labels":[],"samples":[{"sample_accession":"SAMN16725456","study_accession":"PRJNA675854","blood_class":"pbmc","class_from":"sample","title":"MS_7","description":"MS_7","sex":"","geo_sample":"GSM4891570","access":"open","dbgap":"","n_runs":1,"first_public":"2022-12-04","attributes":[["source_name","blood"],["tissue","blood"],["cell_type","peripheral blood mononuclear cells"],["disease","MS case"]],"runs":[{"run_accession":"SRR13019117","experiment_accession":"SRX9470040","library_layout":"PAIRED","library_selection":"cDNA","instrument_model":"NextSeq 500","read_count":19263242,"base_count":5317528068,"first_public":"2022-12-04","experiment_title":"NextSeq 500 sequencing: GSM4891570: MS_7 Homo sapiens RNA-Seq"}],"labels":[],"single_cell":false},{"sample_accession":"SAMN16725457","study_accession":"PRJNA675854","blood_class":"pbmc","class_from":"sample","title":"MS_6","description":"MS_6","sex":"","geo_sample":"GSM4891569","access":"open","dbgap":"","n_runs":1,"first_public":"2022-12-04","attributes":[["source_name","blood"],["tissue","blood"],["cell_type","peripheral blood mononuclear cells"],["disease","MS case"]],"runs":[{"run_accession":"SRR13