{"study_accession":"PRJNA1436811","secondary_study_accession":"SRP683314","title":"Single-Cell RNA Sequencing of PBMCs from Clinically Stable Connective Tissue Disease-associated Interstitial Lung Disease (CTD-ILD) Patients after Lung Transplantation","description":"Connective tissue disease-associated interstitial lung disease (CTD-ILD) is a major indication for lung transplantation in patients with advanced disease. Here, we performed single-cell RNA sequencing (scRNA-seq) of peripheral blood mononuclear cells (PBMCs) from two clinically stable CTD-ILD patients after lung transplantation to characterize circulating immune cell populations and their transcriptional profiles. This dataset provides a single-cell transcriptomic resource for investigating immune heterogeneity and systemic immune status in CTD-ILD patients following lung transplantation.","pubmed":"","geo_series":"","n_samples":2,"samples":[{"sample_accession":"SAMN56486414","study_accession":"PRJNA1436811","blood_class":"pbmc","class_from":"sample","title":"Human sample from Homo sapiens","description":"Human sample from Homo sapiens","sex":"female","geo_sample":"","access":"open","dbgap":"","n_runs":1,"first_public":"2026-03-17","attributes":[["isolate","Patient_CTD-ILD01"],["age","70"],["biomaterial_provider","Wenhui Chen"],["collection_date","2025-03"],["geo_loc_name","China"],["sex","female"],["tissue","Peripheral blood mononuclear cells"]],"runs":[{"run_accession":"SRR37603552","experiment_accession":"SRX32489388","library_layout":"PAIRED","library_selection":"cDNA","instrument_model":"Illumina NovaSeq 6000","read_count":339244710,"base_count":101773413000,"first_public":"2026-03-17","experiment_title":"Illumina NovaSeq 6000 sequencing: scRNA-seq_CTD-ILD01"}],"labels":[]},{"sample_accession":"SAMN56486415","study_accession":"PRJNA1436811","blood_class":"pbmc","class_from":"sample","title":"Human sample from Homo sapiens","description":"Human sample from Homo sapiens","sex":"female","geo_sample":""