{"study_accession":"PRJNA420735","secondary_study_accession":"SRP125988","title":"quanTIseq: quantifying immune contexture of human tumors","description":"We introduce quanTIseq, a method to quantify the tumor immune contexture, determined by the type and density of tumor-infiltrating immune cells. quanTIseq is based on a novel deconvolution algorithm for RNA sequencing data that was validated with independent data sets. Complementing the deconvolution output with image data from tissue slides enables in silico multiplexed immunodetection and provides an efficient method for the immunophenotyping of a large number of tumor samples. Overall design: Blood-derived immune-cell mixtures from 9 healthy donors","pubmed":"31126321","geo_series":"","n_samples":9,"samples":[{"sample_accession":"SAMN08117805","study_accession":"PRJNA420735","blood_class":"pbmc","class_from":"sample","title":"Blood-derived immune-cell mixture from donor 4","description":"Blood-derived immune-cell mixture from donor 4","sex":"","geo_sample":"GSM2871601","access":"open","dbgap":"","n_runs":1,"first_public":"2019-02-14","attributes":[["source_name","PBMC/PMN cell mixture derived from blood sample"],["subject status","healthy donor"],["subject id","donor 4"],["tissue","blood"],["cell_type","PBMC/PMN cell mixture"],["natural killer cells","0.1154"],["b cells","0.0384"],["myeloid dendritic cells","0.0357"],["tregs","0.0097"],["monocytes","0.1943"],["neutrophils","0.0367"]],"runs":[{"run_accession":"SRR6337115","experiment_accession":"SRX3436219","library_layout":"SINGLE","library_selection":"cDNA","instrument_model":"Illumina HiSeq 2500","read_count":93229029,"base_count":4754680479,"first_public":"2019-02-14","experiment_title":"Illumina HiSeq 2500 sequencing: GSM2871601: Blood-derived immune-cell mixture from donor 4 Homo sapiens RNA-Seq"}],"labels":[],"single_cell":false},{"sample_accession":"SAMN08117806","study_accession":"PRJNA420735","blood_class":"pbmc","class_from":"sample","title":"Blood-de