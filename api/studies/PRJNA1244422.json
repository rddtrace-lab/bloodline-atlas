{"study_accession":"PRJNA1244422","secondary_study_accession":"SRP575496","title":"Differential Expression and Correlation Analysis of Global Transcriptome for Obstructive Sleep Apnea Hypopnea Syndrome","description":"In order to investigate the gene expression patterns and molecular regulatory mechanisms of obstructive sleep apnea hypopnea syndrome (OSAHS), the global transcriptome expression profiles of OSAHS patients and healthy people were analyzed using transcriptome sequencing technology. Differential expression of circular RNA, microRNA, long noncoding RNA, and messenger RNA was investigated between the two groups. Overall design: RNA sequencing was performed on OSAHS patients and healthy individuals (n=5 per group) to identify differentially expressed genes and related pathways.","pubmed":"40264951","geo_series":"","n_samples":10,"samples":[{"sample_accession":"SAMN47652466","study_accession":"PRJNA1244422","blood_class":"pbmc","class_from":"sample","title":"PBMC, OSAHS S5","description":"PBMC, OSAHS S5","sex":"","geo_sample":"GSM8882000","access":"open","dbgap":"","n_runs":1,"first_public":"2025-04-27","attributes":[["source_name","peripheral blood mononuclear cell"],["cell_type","peripheral blood mononuclear cell"],["geo_loc_name","missing"],["collection_date","missing"]],"runs":[{"run_accession":"SRR32926706","experiment_accession":"SRX28201441","library_layout":"PAIRED","library_selection":"cDNA","instrument_model":"Illumina NovaSeq 6000","read_count":44445588,"base_count":13333676400,"first_public":"2025-04-27","experiment_title":"Illumina NovaSeq 6000 sequencing: GSM8882000: PBMC, OSAHS S5 Homo sapiens RNA-Seq"}],"labels":[]},{"sample_accession":"SAMN47652467","study_accession":"PRJNA1244422","blood_class":"pbmc","class_from":"sample","title":"PBMC, OSAHS S4","description":"PBMC, OSAHS S4","sex":"","geo_sample":"GSM8881999","access":"open","dbgap":"","n_runs":1,"first_public":"2025-04-27","attributes":[["source_name","peripheral blood mononuclear cell"