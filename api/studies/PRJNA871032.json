{"study_accession":"PRJNA871032","secondary_study_accession":"SRP392964","title":"Transcription profiling of PfSPZ Malaria Vaccine trial subjects receiving a 3-dose regimen in a malaria endemic region","description":"The Sanaria® PfSPZ Vaccine can confer sterilizing protection against liver stage infection by Plasmodium falciparum (Pf) in malaria naïve individuals. The vaccine consists of aseptically purified irradiated Pf sporozoites. Vaccinees received 3 doses of 1.8 X 106 irradiated sporozoites. Efficacy was measured by challenged by controlled human malaria infections (CHMI), and against naturally occurring Pf Infections in Malian adults during the malaria transmission season Overall design: 32 samples from 2 time points, pre-vaccination (Day -7) and post-vaccination (Day 116), for 16 Malian adult participants who all received 3 doses of the PfSPZ vaccine. All subjects remained uninfected after CHMI and 9 participants remained uninfected during the subsequent malaria season","pubmed":"","geo_series":"","n_samples":32,"samples":[{"sample_accession":"SAMN30399935","study_accession":"PRJNA871032","blood_class":"whole_blood","class_from":"sample","title":"MV049G_Dneg7","description":"MV049G_Dneg7","sex":"","geo_sample":"GSM6481322","access":"open","dbgap":"","n_runs":1,"first_public":"2022-08-21","attributes":[["source_name","Whole blood"],["tissue","Whole blood"],["day","Dneg7"],["outcome","Infected"],["time","PreVaccination"],["treatment","3 doses of 1.8M PfSPZ sporozoites"]],"runs":[{"run_accession":"SRR21133336","experiment_accession":"SRX17145717","library_layout":"PAIRED","library_selection":"cDNA","instrument_model":"Illumina HiSeq 2500","read_count":65620684,"base_count":9974343968,"first_public":"2022-08-21","experiment_title":"Illumina HiSeq 2500 sequencing: GSM6481322: MV049G_Dneg7 Homo sapiens RNA-Seq"}],"labels":[],"single_cell":false},{"sample_accession":"SAMN30399936","study_accession":"PRJNA871032","blood_class":"whole_blood","class_from":"sample","t