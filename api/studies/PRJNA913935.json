{"study_accession":"PRJNA913935","secondary_study_accession":"SRP413918","title":"Effect of ablation of PRDM1 on gene expression in human regulatory T cells","description":"To gain an insight into the contribution of BLIMP-1 in human Tregs, we ablated PRDM1 in ex-vivo expaned human Tregs by Crispr/Cas9. Tregs transfected with scramble gRNAs were used as controls. 7 days after transfection, Tregs were rested overnight in media, and were re-stimulated through the TCR and IL2R for 16 hr prior to isolation of RNA for genome-wide RNA-seq. Gene expression profiling analysis was performed using data obtained from RNA-seq of four replicates of PRDM1KO and control cells. Overall design: Comparative gene expression profiling analysis of RNA-seq data for PRDM1KO and control cells.","pubmed":"40773294","geo_series":"","n_samples":8,"samples":[{"sample_accession":"SAMN32313649","study_accession":"PRJNA913935","blood_class":"blood_cells","class_from":"sample","title":"Tregs, PRDM1 knockout, biol rep 4","description":"Tregs, PRDM1 knockout, biol rep 4","sex":"","geo_sample":"GSM6858893","access":"open","dbgap":"","n_runs":1,"first_public":"2025-07-24","attributes":[["source_name","blood"],["tissue","blood"],["cell_type","regulatory T cells"],["genotype","PRDM1 knockout"],["treatment","TCR and IL2R stimulation"]],"runs":[{"run_accession":"SRR22814640","experiment_accession":"SRX18774255","library_layout":"PAIRED","library_selection":"cDNA","instrument_model":"Illumina NovaSeq 6000","read_count":26986552,"base_count":8095965600,"first_public":"2025-07-24","experiment_title":"Illumina NovaSeq 6000 sequencing: GSM6858893: Tregs, PRDM1 knockout, biol rep 4 Homo sapiens RNA-Seq"}],"labels":[]},{"sample_accession":"SAMN32313650","study_accession":"PRJNA913935","blood_class":"blood_cells","class_from":"sample","title":"Tregs, PRDM1 knockout, biol rep 3","description":"Tregs, PRDM1 knockout, biol rep 3","sex":"","geo_sample":"GSM6858892","access":"open","dbgap":"","n_runs":1,"first_public"