{"study_accession":"PRJNA897869","secondary_study_accession":"SRP412958","title":"Distinct brain and lung endothelial miRNA/mRNA profiles after exposure to Plasmodium falciparum-infected red blood cells","description":"We analyzed the miRNA profiles of noninfected human RBCs (niRBCs), ring-infected RBCs (riRBCs), and trophozoite-infected RBCs (trRBCs), as well as those of extracellular vesicles (EVs) secreted from these cells.We found that Plasmodium falciparum infection affects the expression levels of several miRNAs in both human red blood cells and their secreted extracellular vesicles. We hypothesize that these miRNAs may act to modulate the host immune response and control the prognosis of malaria.","pubmed":"","geo_series":"","n_samples":23,"study_labels":[],"samples":[{"sample_accession":"SAMN31582469","study_accession":"PRJNA897869","blood_class":"whole_blood","class_from":"sample","title":"Human sample from Homo sapiens","description":"","sex":"not applicable","geo_sample":"","access":"open","dbgap":"","n_runs":1,"first_public":"2023-06-25","attributes":[["isolate","DY7Z-JS3K-9UY3-MKR2"],["age","not applicable"],["biomaterial_provider","Nahla Galal Metwally /BNITM"],["sex","not applicable"],["tissue","Blood"]],"runs":[{"run_accession":"SRR22728236","experiment_accession":"SRX18689752","library_layout":"SINGLE","library_selection":"RANDOM","instrument_model":"NextSeq 550","read_count":3725384,"base_count":566258368,"first_public":"2023-06-25","experiment_title":"NextSeq 550 sequencing: Human Non infected red blood cells#1"}],"labels":[],"single_cell":false},{"sample_accession":"SAMN31582470","study_accession":"PRJNA897869","blood_class":"whole_blood","class_from":"sample","title":"Human sample from Homo sapiens","description":"","sex":"not applicable","geo_sample":"","access":"open","dbgap":"","n_runs":1,"first_public":"2023-06-25","attributes":[["isolate","69T7-7K25-CY7P-LQY5"],["age","not applicable"],["biomaterial_provider","Nahla Galal Metwally /BNITM"],