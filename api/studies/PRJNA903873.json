{"study_accession":"PRJNA903873","secondary_study_accession":"SRP408939","title":"Single Cell Analysis Identifies Conserved Features of Immune Dysfunction in Simulated Microgravity and Spaceflight","description":"Microgravity is associated with immunological dysfunction, though the underlying mechanisms are poorly understood. Here, using single cell analysis of human peripheral blood mononuclear cells exposed to 25 hours short term simulated microgravity, we characterize altered genes and pathways across immune cells under basal and stimulated states with a Toll like Receptor-7/8 agonist. The results offer insight into maladaptation of the immune system in microgravity, and provide opportunities to develop countermeasures that maintain normal immunity in space.","pubmed":"","geo_series":"","n_samples":3,"samples":[{"sample_accession":"SAMN31816605","study_accession":"PRJNA903873","blood_class":"pbmc","class_from":"sample","title":"Human sample from Homo sapiens","description":"Human sample from Homo sapiens","sex":"male","geo_sample":"","access":"open","dbgap":"","n_runs":4,"first_public":"2023-06-05","attributes":[["isolate","buffy coat"],["age","22"],["biomaterial_provider","Stanford Blood Center"],["sex","male"],["tissue","PBMCs"]],"runs":[{"run_accession":"SRR22356856","experiment_accession":"SRX18327779","library_layout":"PAIRED","library_selection":"RT-PCR","instrument_model":"Illumina NovaSeq 6000","read_count":22790051,"base_count":6837015300,"first_public":"2023-06-05","experiment_title":"Illumina NovaSeq 6000 sequencing: Bulk_072022_uG"},{"run_accession":"SRR22356857","experiment_accession":"SRX18327778","library_layout":"PAIRED","library_selection":"RT-PCR","instrument_model":"Illumina NovaSeq 6000","read_count":20889707,"base_count":6266912100,"first_public":"2023-06-05","experiment_title":"Illumina NovaSeq 6000 sequencing: Bulk_072022_1G"},{"run_accession":"SRR22356872","experiment_accession":"SRX18327763","library_layout":"PAIRED","library_selection":"