{"study_accession":"PRJNA1026622","secondary_study_accession":"SRP465478","title":"Transcriptome of human primary macrophages from healthy controls after long-term myelin phagocytosis","description":"CD14+ monocytes were isolated from the blood of healthy human donors by Ficoll density-gradient centrifugation, magnetic cell sorting and LS column systems. CD14+ monocytes were in vitro differentiated to macrophages by culturing the cells for 7 days in RPMI medium containing 10% FCS, 1% penicillin/streptomycin, 1% glutamine, 1% Fungizone and supplemented with 50 ng/ml human macrophage-colony stimulating factor (M-CSF) in the presence or absence of myelin isolated from brain tissue of 6-8 week-old wild-type C57BL6/J mice. Overall design: Comparative gene expression profiling analysis of human monocyte-derived macrophages differentiated in the absence or presence of myelin from brain tissue of wild-type C57BL6/J mice","pubmed":"38136568","geo_series":"","n_samples":8,"samples":[{"sample_accession":"SAMN37754730","study_accession":"PRJNA1026622","blood_class":"blood_cells","class_from":"sample","title":"C_K9_18_wt_my_3_S61885","description":"C_K9_18_wt_my_3_S61885","sex":"","geo_sample":"GSM7834749","access":"open","dbgap":"","n_runs":1,"first_public":"2023-12-24","attributes":[["source_name","Blood"],["tissue","Blood"],["cell_type","Monocyte-derived macrophages"],["genotype","Control"],["treatment","Myelin wt"],["geo_loc_name","missing"],["collection_date","missing"]],"runs":[{"run_accession":"SRR26340543","experiment_accession":"SRX22048478","library_layout":"SINGLE","library_selection":"cDNA","instrument_model":"Illumina HiSeq 2000","read_count":24653811,"base_count":1602497715,"first_public":"2023-12-24","experiment_title":"Illumina HiSeq 2000 sequencing: GSM7834749: C_K9_18_wt_my_3_S61885 Homo sapiens RNA-Seq"}],"labels":[],"single_cell":false},{"sample_accession":"SAMN37754731","study_accession":"PRJNA1026622","blood_class":"blood_cells","class_from":"sample","title