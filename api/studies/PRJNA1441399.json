{"study_accession":"PRJNA1441399","secondary_study_accession":"SRP685874","title":"Transcriptomic profiling of NK cells in CHB and CHB-MASLD","description":"Clinical evidence suggests that coexistence of metabolic dysfunction-associated steatotic liver disease (MASLD) and chronic hepatitis B (CHB) is associated with more severe liver disease progression, but the underlying immune mechanisms remain incompletely understood. In this study, RNA sequencing was performed on peripheral natural killer (NK) cells isolated from patients with CHB and CHB-MASLD to characterize transcriptomic alterations associated with metabolic dysfunction. Differential expression and pathway analyses were used to identify immune activation programs and candidate signaling pathways linked to NK-cell remodeling in CHB-MASLD.","pubmed":"42733470","geo_series":"","n_samples":6,"study_labels":[],"samples":[{"sample_accession":"SAMN56654266","study_accession":"PRJNA1441399","blood_class":"blood_cells","class_from":"sample","title":"NK cells from CHB-MASLD patient 3","description":"NK cells from CHB-MASLD patient 3","sex":"","geo_sample":"GSM9610101","access":"open","dbgap":"","n_runs":1,"first_public":"2026-06-17","attributes":[["source_name","peripheral blood"],["tissue","peripheral blood"],["cell_type","NK cell"],["disease","CHB-MASLD"],["batch","Batch1"],["geo_loc_name","missing"],["collection_date","missing"]],"runs":[{"run_accession":"SRR37729066","experiment_accession":"SRX32606318","library_layout":"PAIRED","library_selection":"cDNA","instrument_model":"Illumina NovaSeq 6000","read_count":20115649,"base_count":6034694700,"first_public":"2026-06-17","experiment_title":"Illumina NovaSeq 6000 sequencing: GSM9610101: NK cells from CHB-MASLD patient 3 Homo sapiens RNA-Seq"}],"labels":[],"single_cell":false},{"sample_accession":"SAMN56654267","study_accession":"PRJNA1441399","blood_class":"blood_cells","class_from":"sample","title":"NK cells from CHB-MASLD patient 2","description":"NK cells from C