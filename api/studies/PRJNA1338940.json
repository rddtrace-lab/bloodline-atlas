{"study_accession":"PRJNA1338940","secondary_study_accession":"SRP635482","title":"Gene Expression Profiling Identifies Pathogenic Pathways in Kawasaki Disease Compared to Febrile Controls","description":"This study aims to investigate the molecular mechanisms underlying the pathogenesis of Kawasaki disease (KD), a systemic vasculitis that primarily affects children. By performing the whole transcriptome sequencing on peripheral blood samples from KD patients and febrile controls, we sought to identify key genes and pathways involved in oxidative stress and ferroptosis during the acute phase of the disease. Understanding these molecular signatures may provide novel diagnostic biomarkers and therapeutic targets for KD-related coronary artery lesions.","pubmed":"","geo_series":"","n_samples":20,"samples":[{"sample_accession":"SAMN51610442","study_accession":"PRJNA1338940","blood_class":"blood_cells","class_from":"sample","title":"RNA-Seq of organism：WBC","description":"Kawasaki disease","sex":"male","geo_sample":"","access":"open","dbgap":"","n_runs":1,"first_public":"2025-10-25","attributes":[["isolate","white blood cell"],["age","8.5"],["biomaterial_provider","not applicable"],["collection_date","2022-02"],["geo_loc_name","China"],["sex","male"],["tissue","blood"],["replicate","replicate = Acute phase of Kawasaki disease 1"]],"runs":[{"run_accession":"SRR35818206","experiment_accession":"SRX30867477","library_layout":"PAIRED","library_selection":"other","instrument_model":"Illumina NovaSeq 6000","read_count":53903594,"base_count":16171078200,"first_public":"2025-10-25","experiment_title":"Illumina NovaSeq 6000 sequencing: RNA-Seq of homo sapiens: children leukocyte"}],"labels":[]},{"sample_accession":"SAMN51610443","study_accession":"PRJNA1338940","blood_class":"blood_cells","class_from":"sample","title":"RNA-Seq of organism：WBC","description":"Kawasaki disease","sex":"female","geo_sample":"","access":"open","dbgap":"","n_runs":1,"first_public":"2025-10-25","attribu