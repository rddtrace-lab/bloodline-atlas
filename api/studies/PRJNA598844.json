{"study_accession":"PRJNA598844","secondary_study_accession":"SRP239396","title":"WTS of palbociclib-bortezomib clinical trial","description":"This project aims to determine the efficacy of our palbociclib-bortezomib clinical trial in mantle cell lymphoma, based on preclinical studies that have shown enhanced killing of MCL and myeloma cells by bortezomib following CDK4/6 inhibition. Through longitudinal WES and WTS analyses, we also aim to examine genomic data in the context of clinical responses, and identify driver genes that discriminate sensitivity from resistance in this combination treatment. This can deepen understanding of the role of CDK4/6 inhibition in cancer therapies, as well as shed light on mechanisms behind resistance.","pubmed":"","geo_series":"","n_samples":5,"study_labels":[],"samples":[{"sample_accession":"SAMN13718157","study_accession":"PRJNA598844","blood_class":"whole_blood","class_from":"sample","title":"Human sample from Homo sapiens","description":"","sex":"not collected","geo_sample":"","access":"open","dbgap":"","n_runs":1,"first_public":"2024-12-30","attributes":[["isolate","not collected"],["age","not collected"],["biomaterial_provider","Selina Chen-Kiang, WCM"],["sex","not collected"],["tissue","Peripheral blood"],["patient_id","PtB13"],["sample_id","PreIb"],["disease","Mantle cell lymphoma"]],"runs":[{"run_accession":"SRR10822738","experiment_accession":"SRX7496122","library_layout":"PAIRED","library_selection":"PCR","instrument_model":"Illumina HiSeq 4000","read_count":51015676,"base_count":5203598952,"first_public":"2024-12-30","experiment_title":"Illumina HiSeq 4000 sequencing: RNA-seq of human mantle cell lymphoma cells"}],"labels":[],"single_cell":false},{"sample_accession":"SAMN13718158","study_accession":"PRJNA598844","blood_class":"whole_blood","class_from":"sample","title":"Human sample from Homo sapiens","description":"","sex":"not collected","geo_sample":"","access":"open","dbgap":"","n_runs":1,"first_public":"2024-12-30"