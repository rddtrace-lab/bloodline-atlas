{"study_accession":"PRJNA902695","secondary_study_accession":"SRP408402","title":"Bulk RNA-seq analysis of primary CML CD34+ cells (n=3) treated with idasanutlin alone or in combination with nilotinib in vitro","description":"Bulk RNA-seq was performed on primary human CML CD34+ cells to understand the molecular consequences of treatment with the MDM2 inhibitor idasanutlin alone and in combination with the tyrosine kinase inhibitor nilotinib for 24 hrs and 72 hrs. Overall design: Primary CD34+ CML cells isolated from peripheral blood of 3 unrelated chronic phase CML patients were treated with nilotinib (3 µM), idasanutlin (166 nM), or a combination for 24 hrs or 72 hrs. RNA-seq analysis was performed at each time point for each drug treatment arm of each sample. CML CD34+ samples used in the study were randomly chosen without prior knowledge of age, sex, clinical outcome or response to tyrosine kinase inhibitors.","pubmed":"38246924","geo_series":"","n_samples":24,"samples":[{"sample_accession":"SAMN31769699","study_accession":"PRJNA902695","blood_class":"whole_blood","class_from":"sample","title":"CML 3 NIL+IDASA 72 HRS","description":"CML 3 NIL+IDASA 72 HRS","sex":"male","geo_sample":"GSM6736186","access":"open","dbgap":"","n_runs":1,"first_public":"2023-12-21","attributes":[["source_name","peripheral blood"],["tissue","peripheral blood"],["cell_type","CD34+ stem/progenitor cells"],["disease","CML chronic phase diagnosis"],["treatment","nilotinib + idasanutlin"],["time","72 hrs"],["age","46"],["sex","male"],["geo_loc_name","missing"],["collection_date","missing"]],"runs":[{"run_accession":"SRR22319634","experiment_accession":"SRX18292880","library_layout":"PAIRED","library_selection":"cDNA","instrument_model":"Illumina HiSeq 4000","read_count":70195273,"base_count":10602259603,"first_public":"2023-12-21","experiment_title":"Illumina HiSeq 4000 sequencing: GSM6736186: CML 3 NIL+IDASA 72 HRS Homo sapiens RNA-Seq"}],"labels":[]},{"sample_accession":"SAMN31769700","st