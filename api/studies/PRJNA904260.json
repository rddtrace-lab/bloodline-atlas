{"study_accession":"PRJNA904260","secondary_study_accession":"SRP409194","title":"Neutrophil activation by IL-4, IL-13 and IFN-g","description":"Interleukin (IL)-4 and IL-13 are related cytokines with well-known roles in type 2 immune response. However, their effects on neutrophils are less defined and existing research has provided somewhat contradictory results We measured IL-4-, IL-13- and IFN-g-stimulated gene expression in highly purified human neutrophils. Overall design: Human neutrophils purified with Percoll gradient and thereafter sorted from four healthy donors. The purified cells were subsequently stimulated with 100 ng/ml of IL-4 , IL-13 or IFN-γ for 1 hour and the mRNA was extracted and subjected to RNASeq analysis. The gene expression of cytokine-stimulated cells was compared to unstimulated counterparts.","pubmed":"36809715","geo_series":"","n_samples":16,"samples":[{"sample_accession":"SAMN31835867","study_accession":"PRJNA904260","blood_class":"blood_cells","class_from":"sample","title":"neutrophil, unstimulated, donor4","description":"neutrophil, unstimulated, donor4","sex":"","geo_sample":"GSM6751441","access":"open","dbgap":"","n_runs":1,"first_public":"2023-03-29","attributes":[["source_name","peripheral blood"],["tissue","peripheral blood"],["cell_type","neutrophil"],["treatment","unstimulated"]],"runs":[{"run_accession":"SRR22375779","experiment_accession":"SRX18346318","library_layout":"PAIRED","library_selection":"cDNA","instrument_model":"Illumina NovaSeq 6000","read_count":243,"base_count":47897,"first_public":"2023-03-29","experiment_title":"Illumina NovaSeq 6000 sequencing: GSM6751441: neutrophil, unstimulated, donor4 Homo sapiens RNA-Seq"}],"labels":[],"single_cell":false},{"sample_accession":"SAMN31835868","study_accession":"PRJNA904260","blood_class":"blood_cells","class_from":"sample","title":"neutrophil, unstimulated, donor3","description":"neutrophil, unstimulated, donor3","sex":"","geo_sample":"GSM6751440","access":"open","dbgap"