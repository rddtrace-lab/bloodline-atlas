{"study_accession":"PRJNA728070","secondary_study_accession":"SRP318898","title":"Increased Systemic HSP70B Levels in Spinal Muscular Atrophy Infants","description":"RNA sequencing in whole blood from spinal muscular atrophy patients and healthy control infants Overall design: Here, we performed whole-blood RNA sequencing and differential expression analyses in SMA type 1 subjects under 1 year old and age-matched healthy control subjects. Our analysis identified for the first time the Heat Shock Protein Family A Member 7 (HSPA7) as a novel candidate biomarker to track SMA progression in the first year of life, with its circulating protein levels associated with circulating neurofilaments levels in SMA newborns and infants.","pubmed":"33991176","geo_series":"","n_samples":10,"study_labels":[],"samples":[{"sample_accession":"SAMN19068059","study_accession":"PRJNA728070","blood_class":"whole_blood","class_from":"sample","title":"SMA244A","description":"SMA244A","sex":"","geo_sample":"GSM5285306","access":"open","dbgap":"","n_runs":1,"first_public":"2021-05-09","attributes":[["source_name","WholeBlood_SMA-2 CN"],["tissue","Whole Blood"],["smn2 copy number","2"],["disease","spinal muscular atrophy"]],"runs":[{"run_accession":"SRR14466052","experiment_accession":"SRX10815559","library_layout":"PAIRED","library_selection":"cDNA","instrument_model":"Illumina HiSeq 4000","read_count":94429329,"base_count":14075553504,"first_public":"2021-05-09","experiment_title":"Illumina HiSeq 4000 sequencing: GSM5285306: SMA244A Homo sapiens RNA-Seq"}],"labels":[],"single_cell":false},{"sample_accession":"SAMN19068060","study_accession":"PRJNA728070","blood_class":"whole_blood","class_from":"sample","title":"SMA220A","description":"SMA220A","sex":"","geo_sample":"GSM5285305","access":"open","dbgap":"","n_runs":1,"first_public":"2021-05-09","attributes":[["source_name","WholeBlood_SMA-2 CN"],["tissue","Whole Blood"],["smn2 copy number","2"],["disease","spinal muscular atrophy"]],"runs":[{"