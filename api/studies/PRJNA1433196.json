{"study_accession":"PRJNA1433196","secondary_study_accession":"SRP681662","title":"Gene Expression Profiling in Allergic Rhinitis: Findings from RNA Sequencing and Real-Time PCR Validation","description":"Allergic rhinitis (AR) is a highly prevalent allergic disease worldwide that significantly impairs quality of life, academic performance, and work productivity. Although Most gene expression studies in allergic rhinitis have focused on European, Chinese, and Middle Eastern populations, with limited data from Southeast Asia; to our knowledge, this study represents the first gene expression profiling investigation of allergic rhinitis conducted in Malaysia. Identifying population-specific gene expression profiles is essential for advancing precision medicine strategies for AR","pubmed":"","geo_series":"","n_samples":8,"samples":[{"sample_accession":"SAMN56358147","study_accession":"PRJNA1433196","blood_class":"pbmc","class_from":"sample","title":"Human sample from Homo sapiens","description":"PBMCS","sex":"female","geo_sample":"","access":"open","dbgap":"","n_runs":1,"first_public":"2026-03-23","attributes":[["isolate","PBMCS"],["age","30"],["biomaterial_provider","IPPT-USM"],["collection_date","not applicable"],["geo_loc_name","Malaysia"],["sex","female"],["tissue","not applicable"],["cell_line","not applicable"],["cell_subtype","not applicable"],["cell_type","PBMCS"],["culture_collection","not applicable"],["dev_stage","AR"],["disease","AR"],["disease_stage","AR"],["ethnicity","MALAYSIAN"],["health_state","NORMAL"],["karyotype","HUMAN"],["phenotype","HUMAN"],["population","MALAYSIAN"],["race","MALAYSIAN"],["sample_type","PBMCS"],["treatment","NOT YET"]],"runs":[{"run_accession":"SRR37502189","experiment_accession":"SRX32396587","library_layout":"PAIRED","library_selection":"PCR","instrument_model":"Illumina HiSeq 2000","read_count":47570781,"base_count":14271234300,"first_public":"2026-03-23","experiment_title":"Illumina HiSeq 2000 sequencing: RNA-SEQ"}],"labels":[