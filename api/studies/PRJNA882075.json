{"study_accession":"PRJNA882075","secondary_study_accession":"SRP398096","title":"RNA sequencing of human peripheral blood cDC1 treated with PGE2","description":"RNA sequencing was used to characterize PGE2-mediated changes in the gene expression profile of human conventional type 1 dendritic cells (cDC1) purified from PBMCs of healthy donors. Our analysis shows that treatment of cDC1 with PGE2 induces transcriptional changes in resting cDC1. cDC1 activated with a TLR3 ligand after PGE2 pre-treatment show alterations in the expression of activation induced genes. Overall design: cDC1 (CD370+CD141+CD3- cells) were sort purified from PBMCs of four healthy donors (A,B,C,D). cDC1 were treated or not with PGE2 (1µg/ml) for 24h. In some groups, the TLR3 ligand poly I:C was added to the culture for the last 4h of the experiment to induce cDC1 activation.","pubmed":"37315536","geo_series":"","n_samples":16,"samples":[{"sample_accession":"SAMN30926877","study_accession":"PRJNA882075","blood_class":"whole_blood","class_from":"sample","title":"PGE2TL_D","description":"PGE2TL_D","sex":"","geo_sample":"GSM6592094","access":"open","dbgap":"","n_runs":1,"first_public":"2023-06-21","attributes":[["source_name","peripheral blood cDC1"],["biological replicate","D"],["tissue","peripheral blood"],["treatment","PGE2 (1microg/ml) 24h + poly I:C (10microg/ml) 4h"],["biological replicate","D"],["geo_loc_name","missing"],["collection_date","missing"]],"runs":[{"run_accession":"SRR21629078","experiment_accession":"SRX17629719","library_layout":"PAIRED","library_selection":"cDNA","instrument_model":"Illumina NovaSeq 6000","read_count":42634069,"base_count":12790220700,"first_public":"2023-06-21","experiment_title":"Illumina NovaSeq 6000 sequencing: GSM6592094: PGE2TL_D Homo sapiens RNA-Seq"}],"labels":[],"single_cell":false},{"sample_accession":"SAMN30926878","study_accession":"PRJNA882075","blood_class":"whole_blood","class_from":"sample","title":"PGE2TL_C","description":"PGE2TL_C","sex":"",