{"study_accession":"PRJNA904243","secondary_study_accession":"SRP409185","title":"Long non-coding RNA and circular RNA and coding RNA profiling of plasma exosomes of osteosarcoma by RNA seq","description":"Research show that the plasma exosomes derived from osteosarcoma play a key role in the process of tumor metastasis. Here, we established RNA-seq dataset for lncRNAs, circRNAs and mRNAs in plasma exosomes from 10 OS patients and 5 healthy donors. This database provides a significant resource for relevant researchers to excavate dysregulated lncRNAs, circRNAs and mRNAs of plasma exosomes in OS versus normal conditions. Overall design: Extract plasma exosomes from osteosarcoma patients and normal volunteers, and sequence these exosomes to find differentially expressed RNA.","pubmed":"37349312","geo_series":"","n_samples":15,"samples":[{"sample_accession":"SAMN31833620","study_accession":"PRJNA904243","blood_class":"plasma_serum_cfrna","class_from":"sample","title":"plasma exosomes, control volunteer [A503-11]","description":"plasma exosomes, control volunteer [A503-11]","sex":"female","geo_sample":"GSM6751284","access":"open","dbgap":"","n_runs":1,"first_public":"2023-06-21","attributes":[["source_name","Peripheral blood"],["tissue","Peripheral blood"],["cell_type","plasma exosomes"],["genotype","control"],["patient","A503-11"],["group","control"],["sex","female"],["location","not applicable"],["grade","not applicable"],["geo_loc_name","missing"],["collection_date","missing"]],"runs":[{"run_accession":"SRR22373221","experiment_accession":"SRX18343760","library_layout":"PAIRED","library_selection":"cDNA","instrument_model":"Illumina NovaSeq 6000","read_count":76046196,"base_count":22813858800,"first_public":"2023-06-21","experiment_title":"Illumina NovaSeq 6000 sequencing: GSM6751284: plasma exosomes, control volunteer [A503-11] Homo sapiens RNA-Seq"}],"labels":[]},{"sample_accession":"SAMN31833621","study_accession":"PRJNA904243","blood_class":"plasma_serum_cfrna","