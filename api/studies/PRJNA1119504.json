{"study_accession":"PRJNA1119504","secondary_study_accession":"SRP511443","title":"Gene expression of B cell differentiation in Organoid Cultures","description":"To understand how different stimulation conditions impacted the maturation of B cells and formation of plasma cells in an ex vivo organoid culture, we preformed RNA-seq comparing the CD19+ B cells and CD138+ plasma cells at different time points during the organoid culture. Two stimulation conditions were used including influenza antigen alone or in combination with the TLR7 agonist R848. Finally, two B cell sources were compared to udnerstand if tissue of origin impacted organoid based B cell differentiation. Overall design: RNA-seq of 2-3 replicates of each sample group.","pubmed":"","geo_series":"","n_samples":18,"samples":[{"sample_accession":"SAMN41658531","study_accession":"PRJNA1119504","blood_class":"pbmc","class_from":"sample","title":"SMR060","description":"SMR060","sex":"","geo_sample":"GSM8303233","access":"open","dbgap":"","n_runs":1,"first_public":"2024-08-25","attributes":[["source_name","CD138"],["tissue","PBMC"],["subject id","902C"],["cell_type","CD138"],["stimulation","R848.Ag"],["timepoint","d24"],["geo_loc_name","missing"],["collection_date","missing"]],"runs":[{"run_accession":"SRR29268869","experiment_accession":"SRX24786488","library_layout":"PAIRED","library_selection":"cDNA","instrument_model":"Illumina NovaSeq 6000","read_count":4808298,"base_count":971276196,"first_public":"2024-08-25","experiment_title":"Illumina NovaSeq 6000 sequencing: GSM8303233: SMR060 Homo sapiens RNA-Seq"}],"labels":[]},{"sample_accession":"SAMN41658532","study_accession":"PRJNA1119504","blood_class":"pbmc","class_from":"sample","title":"SMR058","description":"SMR058","sex":"","geo_sample":"GSM8303232","access":"open","dbgap":"","n_runs":1,"first_public":"2024-08-25","attributes":[["source_name","CD138"],["tissue","PBMC"],["subject id","902C"],["cell_type","CD138"],["stimulation","Ag"],["timepoint","d24"],