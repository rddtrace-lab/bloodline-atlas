{"study_accession":"PRJNA1003811","secondary_study_accession":"SRP454207","title":"The molecular mechanism responsible for HbSC retinopathy may depend on the action of angiogenesis-related genes ROBO1 and SLC38A5.","description":"Purpose: HbSC disease, a less severe form of sickle cell disease, affects the retina more frequently and patients have higher rates of proliferative retinopathy that can progress to vision loss. This study aimed to identify differences in the expression of endothelial cell-derived molecules associated with pathophysiology of proliferative sickle cell retinopathy (PSCR). Overall design: mRNA sequencing (RNAseq) was used to compare the gene expression profile of circulating endothelial colony-forming cells from patients with SC hemoglobinopathy and proliferative retinopathy (n=5), versus SC patients without retinopathy (n=3).","pubmed":"39114443","geo_series":"","n_samples":8,"samples":[{"sample_accession":"SAMN36905562","study_accession":"PRJNA1003811","blood_class":"whole_blood","class_from":"sample","title":"F_SC_withoutPSCR","description":"F_SC_withoutPSCR","sex":"","geo_sample":"GSM7698099","access":"open","dbgap":"","n_runs":1,"first_public":"2024-08-25","attributes":[["source_name","peripheral blood"],["tissue","peripheral blood"],["cell_type","Endothelial colony-forming cells (ECFCs)"],["subject status","SC_withoutPSCR"],["geo_loc_name","missing"],["collection_date","missing"]],"runs":[{"run_accession":"SRR25582075","experiment_accession":"SRX21310634","library_layout":"PAIRED","library_selection":"cDNA","instrument_model":"Illumina HiSeq 2500","read_count":38469463,"base_count":7770831526,"first_public":"2024-08-25","experiment_title":"Illumina HiSeq 2500 sequencing: GSM7698099: F_SC_withoutPSCR Homo sapiens RNA-Seq"}],"labels":[]},{"sample_accession":"SAMN36905563","study_accession":"PRJNA1003811","blood_class":"whole_blood","class_from":"sample","title":"AP_SC_withoutPSCR","description":"AP_SC_withoutPSCR","sex":"","geo_sample":"GS