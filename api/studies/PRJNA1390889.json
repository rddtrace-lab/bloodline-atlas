{"study_accession":"PRJNA1390889","secondary_study_accession":"SRP656565","title":"High throughput sequencing of T cells from a patient undergoing immune checkpoint inhibitor therapy [P365-5]","description":"This is part of a prospective longitudinal study designed to identify biomarkers predictive of the onset of irAEs associated with ICI therapy and determine whether these biomarkers are further related to treatment efficacy. This experiment was a pilot study of CD8 T-cells from three visits of a single donor. Overall design: Cells were collected from a single donor across collected across three visits (pre-treatment, 20 days post therapy, and 62 days post therapy) for profiliing using 10X sequencing. Samples from the three visits were prepared across three 10X channels for a total of three gene expression sequencing libraries, 3 TCR libraries, and 3 feature barcode libraries.","pubmed":"","geo_series":"","n_samples":9,"samples":[{"sample_accession":"SAMN54208071","study_accession":"PRJNA1390889","blood_class":"pbmc","class_from":"sample","title":"FB visit 3","description":"FB visit 3","sex":"male","geo_sample":"GSM9396006","access":"open","dbgap":"","n_runs":1,"first_public":"2026-05-05","attributes":[["source_name","PBMC"],["cell_type","CD8 T cells"],["tissue","PBMC"],["treatment","cemiplimab"],["diagnosis","Head and neck cancer"],["visit","3"],["age","63"],["sex","male"],["geo_loc_name","missing"],["collection_date","missing"]],"runs":[{"run_accession":"SRR36514531","experiment_accession":"SRX31535002","library_layout":"PAIRED","library_selection":"cDNA","instrument_model":"NextSeq 2000","read_count":74516053,"base_count":6706444770,"first_public":"2026-05-05","experiment_title":"NextSeq 2000 sequencing: GSM9396006: FB visit 3 Homo sapiens RNA-Seq"}],"labels":[],"single_cell":false},{"sample_accession":"SAMN54208072","study_accession":"PRJNA1390889","blood_class":"pbmc","class_from":"sample","title":"FB visit 2","description":"FB visit 2","sex":"male","geo_samp