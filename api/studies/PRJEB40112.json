{"study_accession":"PRJEB40112","secondary_study_accession":"ERP123713","title":"Characterization of nucleic acids from extracellular vesicle-enriched human sweat","description":"Volunteers from Oulu University and Oulu area (Northern Finland) were asked to bike for 30-40 minutes wearing a plastic coat and gloves for sweat collection. Sweat was filtered on 0,8 micron filter, then EV enrichment was done using ultracentrifugation for DNA extraction. RNA extraction was done on concentrated samples using ExoRNeasy (Qiagen). Both DNA and RNA were used to make NGS libraries for sequencing. Bioinformatics analysis was performed to identify origin of reads (Human, metagenome) and types of sequences represented.","pubmed":"34103018","geo_series":"","n_samples":21,"samples":[{"sample_accession":"SAMEA7281909","study_accession":"PRJEB40112","blood_class":"plasma_serum_cfrna","class_from":"study","title":"RNA-seq","description":"Neb-Next single End library total RNA sequenced on Illumina NExtSeq550","sex":"male","geo_sample":"","access":"open","dbgap":"","n_runs":1,"first_public":"2021-05-06","attributes":[["ENA-CHECKLIST","ERC000011"],["ENA-FIRST-PUBLIC","2021-05-07T00:26:50Z"],["organism","Homo sapiens"],["ENA-LAST-UPDATE","2020-08-31T17:39:41Z"],["sex","Male"],["scientific_name","Homo sapiens"],["common name","human"],["type","individual"],["age","56"],["isolation_source","Indoor biking with plastic coat and gloves for sweat collection"],["ENA-FIRST-PUBLIC","2021-05-07"],["ENA-LAST-UPDATE","2020-08-31"]],"runs":[{"run_accession":"ERR4568391","experiment_accession":"ERX4504064","library_layout":"SINGLE","library_selection":"cDNA","instrument_model":"NextSeq 550","read_count":2743912,"base_count":130598534,"first_public":"2021-05-06","experiment_title":"NextSeq 550 sequencing"}],"labels":[]},{"sample_accession":"SAMEA7281910","study_accession":"PRJEB40112","blood_class":"plasma_serum_cfrna","class_from":"study","title":"RNA-seq","description":"Neb-Next single End library total