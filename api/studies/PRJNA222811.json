{"study_accession":"PRJNA222811","secondary_study_accession":"SRP031459","title":"MicroRNA profiling of primary cutaneous large B-cell lymphomas","description":"High-throughput sequencing of primary cutaneous follicle center lymphoma (PCFCL), primary cutaneous diffuse large B-cell lymphoma, leg type (PCLBCL-LT) and in vitro activated peripheral blood B-cells. We performed high-throughput sequencing analysis on frozen tumor biopsies from 19 cases of PCFCL and PCLBCL-LT to establish microRNA profiles. Cluster analysis of the complete microRNome could not distinguish between the two subtypes, but 16 single microRNAs were found to be differentially expressed. Overall design: Lymphoma miRNA profiles of were generated by deep sequencing, using Illumina Genome Analyzer II.","pubmed":"24358187","geo_series":"","n_samples":4,"study_labels":[{"level":"study","event_code":"MINOR_PROCEDURE","certainty":"confirmed","delta_days":0.0,"delta_bucket":"D0","time_precision":"day","stage":"teacher","confidence":1.0,"evidence":"We performed high-throughput sequencing analysis on frozen tumor biopsies from 19 cases of PCFCL and PCLBCL-LT to establish microRNA profiles.","model_version":"teacher:mlx:mlx-community/Qwen2.5-14B-Instruct-4bit"}],"samples":[{"sample_accession":"SAMN02376774","study_accession":"PRJNA222811","blood_class":"blood_cells","class_from":"sample","title":"Q88","description":"Q88","sex":"","geo_sample":"GSM1243307","access":"open","dbgap":"","n_runs":1,"first_public":"2013-11-13","attributes":[["source_name","activated B-cells 2"],["tissue","peripheral blood B-cells"]],"runs":[{"run_accession":"SRR1012334","experiment_accession":"SRX364654","library_layout":"SINGLE","library_selection":"size fractionation","instrument_model":"Illumina Genome Analyzer II","read_count":9931916,"base_count":526391548,"first_public":"2013-11-13","experiment_title":"Illumina Genome Analyzer II sequencing: GSM1243307: Q88 Homo sapiens RNA-Seq"}],"labels":[],"single_cell":false},{"sample_acce