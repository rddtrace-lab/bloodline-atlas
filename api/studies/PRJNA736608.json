{"study_accession":"PRJNA736608","secondary_study_accession":"SRP323522","title":"Generation of a unique, comprehensive and representative Acute Myeloid Leukemia (AML) patient-derived xenograft (PDX) resource.","description":"Randomized Phase II-like preclinical trials in patient-derived xenografts (PDX) provide an attractive option to define the efficacy of drugs that act via cell-intrinsic mechanisms, and to identify biomarkers of response and resistance across genetically diverse subtypes of leukemia. Here, we generated a unique, comprehensive and representative AML PDX resource that reflects the genetic abnormalities that are found in large clinical trials. Overall design: RNA profiles of AML patient samples that successfully engrafted in NSGS and NRGS recipients.","pubmed":"37904045","geo_series":"","n_samples":30,"samples":[{"sample_accession":"SAMN19654921","study_accession":"PRJNA736608","blood_class":"bone_marrow","class_from":"sample","title":"R64","description":"R64","sex":"","geo_sample":"GSM5368606","access":"open","dbgap":"","n_runs":1,"first_public":"2023-07-15","attributes":[["source_name","RBWH-64"],["cell_type","hCD3- hCD45+ bone marrow cells"],["tissue","bone marrow"],["treatment","no treatment"]],"runs":[{"run_accession":"SRR14777134","experiment_accession":"SRX11110469","library_layout":"SINGLE","library_selection":"cDNA","instrument_model":"NextSeq 500","read_count":45002054,"base_count":3393747513,"first_public":"2023-07-15","experiment_title":"NextSeq 500 sequencing: GSM5368606: R64 Homo sapiens RNA-Seq"}],"labels":[]},{"sample_accession":"SAMN19654922","study_accession":"PRJNA736608","blood_class":"bone_marrow","class_from":"sample","title":"R55","description":"R55","sex":"","geo_sample":"GSM5368605","access":"open","dbgap":"","n_runs":1,"first_public":"2023-07-15","attributes":[["source_name","RBWH-55"],["cell_type","hCD3- hCD45+ bone marrow cells"],["tissue","bone marrow"],["treatment","no treatment"]],"runs":[{"run_accession":"SRR14777133