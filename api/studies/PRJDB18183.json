{"study_accession":"PRJDB18183","secondary_study_accession":"DRP011697","title":"RNA sequencing and analysis of human eosinophils stimulated with IL-4 and IL-13","description":"Activated eosinophils is a major cell type to be involved in allergic diseases. Type 2 cytokines (IL-4, IL-5, and IL-13) are important to establish and augment its inflammatory process. IL-5 primarily activates eosinophils and prolongs their survival. However, the direct effects of IL-4 and IL-13 on human eosinophils remains fully uncovered. The aim of this study is to clarify the role of these cytokines as direct activators for human eosinophils.","pubmed":"39067484","geo_series":"","n_samples":15,"study_labels":[],"samples":[{"sample_accession":"SAMD00791083","study_accession":"PRJDB18183","blood_class":"blood_cells","class_from":"sample","title":"DK24042_01","description":"HP1 Human eosinophils, non-stimulated","sex":"not collected","geo_sample":"","access":"open","dbgap":"","n_runs":1,"first_public":"2024-06-30","attributes":[["collection_date","2024-06-05"],["health_state","healthy"],["INSDC secondary accession","DRS391806"],["aliquot","1"],["ethnicity","Japanese"],["organism","Homo sapiens"],["race","Asian"],["sex","not collected"],["tissue","blood"],["sample_type","primary cell"],["isolate","Keio University"],["NCBI submission package","Human.1.0"],["geo_loc_name","Japan:Tokyo, Shinjuku-ku, Shinanomachi"],["cell_subtype","white blood cell"],["cell_type","eosinophil"],["age","not collected"],["biomaterial_provider","Keio University"],["sample_name","AA-Medium-1"],["BioSampleModel","Human"],["ENA-FIRST-PUBLIC","2024-06-20"],["ENA-LAST-UPDATE","2024-06-23"]],"runs":[{"run_accession":"DRR570908","experiment_accession":"DRX554375","library_layout":"SINGLE","library_selection":"cDNA","instrument_model":"NextSeq 500","read_count":2250527,"base_count":171040052,"first_public":"2024-06-30","experiment_title":"NextSeq 500 sequencing: NextSeq 500 sequencing of SAMD00791083"}],"labels":[],"single_