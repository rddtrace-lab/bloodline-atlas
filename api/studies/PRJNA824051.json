{"study_accession":"PRJNA824051","secondary_study_accession":"SRP367873","title":"Transcriptional profiling of human hepatic NK cell subpopulations","description":"To identify potential functional roles of liver-resident NK cells we performed RNA sequencing on FACS sorted NK cell subpopulations from liver perfusates (n=5) and healthy blood controls (n=5). Full-length transcripts were sequenced from low-input samples using a modified version of the SMART-Seq2 protocol. Hepatic CD56brightCD16- and CD56brightCD16+ samples upregulate genes associated with tissue residency. Overall design: mRNA profiles of FACS sorted NK cell subpopulations from liver perfusates (n=5) and healthy blood controls (n=5).","pubmed":"35865550","geo_series":"","n_samples":8,"study_labels":[],"samples":[{"sample_accession":"SAMN27383783","study_accession":"PRJNA824051","blood_class":"pbmc","class_from":"sample","title":"PBMC_d5_CD56hiCD16- [000008514669_G05]","description":"PBMC_d5_CD56hiCD16- [000008514669_G05]","sex":"","geo_sample":"GSM6031087","access":"open","dbgap":"","n_runs":1,"first_public":"2022-04-10","attributes":[["source_name","PBMC"],["cell_type","CD56hiCD16-"],["tissue","PBMC"],["donor id","d5"]],"runs":[{"run_accession":"SRR18661616","experiment_accession":"SRX14764062","library_layout":"PAIRED","library_selection":"cDNA","instrument_model":"NextSeq 500","read_count":4215223,"base_count":210761150,"first_public":"2022-04-10","experiment_title":"NextSeq 500 sequencing: GSM6031087: PBMC_d5_CD56hiCD16- [000008514669_G05] Homo sapiens RNA-Seq"}],"labels":[],"single_cell":true},{"sample_accession":"SAMN27383784","study_accession":"PRJNA824051","blood_class":"pbmc","class_from":"sample","title":"PBMC_d5_CD56loCD16+ [000008514669_E05]","description":"PBMC_d5_CD56loCD16+ [000008514669_E05]","sex":"","geo_sample":"GSM6031086","access":"open","dbgap":"","n_runs":1,"first_public":"2022-04-10","attributes":[["source_name","PBMC"],["cell_type","CD56loCD16+"],["tissue","PBMC"],["donor id","d