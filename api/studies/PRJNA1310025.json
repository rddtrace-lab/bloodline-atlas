{"study_accession":"PRJNA1310025","secondary_study_accession":"SRP618187","title":"Transcriptome analysis of T cells for miRNA expression","description":"This BioProject presents small RNA sequencing data from healthy human T cells under various functional states. The study aims to comprehensively characterize miRNA expression profiles and identify key regulatory miRNAs involved in T cell activation, proliferation, differentiation, and effector functions. The dataset includes raw sequencing data and processed results from bioinformatics analyses comprising miRNA quantification, differential expression, target prediction, and pathway enrichment. These data provide valuable resources for understanding miRNA-mediated regulation in immune responses and support the development of miRNA-based immunotherapies, including enhancement of CAR-T cell therapy and anti-tumor immunity.","pubmed":"","geo_series":"","n_samples":11,"samples":[{"sample_accession":"SAMN50764456","study_accession":"PRJNA1310025","blood_class":"whole_blood","class_from":"sample","title":"Human sample from Homo sapiens","description":"Human sample from Homo sapiens","sex":"not collected","geo_sample":"","access":"open","dbgap":"","n_runs":1,"first_public":"2026-05-14","attributes":[["isolate","volunteer A"],["age","not collected"],["biomaterial_provider","volunteer"],["collection_date","2025-07-02"],["geo_loc_name","China"],["sex","not collected"],["tissue","blood"],["dev_stage","TSCM"]],"runs":[{"run_accession":"SRR35295298","experiment_accession":"SRX30397369","library_layout":"SINGLE","library_selection":"size fractionation","instrument_model":"Illumina NovaSeq X Plus","read_count":10852616,"base_count":1638745016,"first_public":"2026-05-14","experiment_title":"Illumina NovaSeq X Plus sequencing: TSCM_1"}],"labels":[]},{"sample_accession":"SAMN50764457","study_accession":"PRJNA1310025","blood_class":"whole_blood","class_from":"sample","title":"Human sample from Homo sapiens","description":"Human sample