{"study_accession":"PRJNA1062870","secondary_study_accession":"SRP482772","title":"Effects of orelabrutinib on antibody mediated platelet destruction in ITP","description":"Transcriptome sequencing was performed to explore the effects of BTK inhibitor orelabrutinib in primary immune thrombocytopenia (ITP). B cells were collected from the peripheral blood of 4 healthy donors and 4 newly diagnosed ITP patients. B cells from ITP patients were pre-treated with orelabrutinib or DMSO as a control for 1 hour before IgM activation. B cells from healthy donors were treated with DMSO and IgM. Cells were collected 24 hours later and dissolved in TRIzol reagent. Sequencing was performed using Illumina NovaSeq 6000.","pubmed":"","geo_series":"","n_samples":12,"samples":[{"sample_accession":"SAMN39324677","study_accession":"PRJNA1062870","blood_class":"whole_blood","class_from":"sample","title":"Human sample from Homo sapiens","description":"Human sample from Homo sapiens","sex":"female","geo_sample":"","access":"open","dbgap":"","n_runs":1,"first_public":"2024-01-11","attributes":[["isolate","ITP patient No.1"],["age","34 years"],["biomaterial_provider","Department of hematology,Qilu Hospital,Shandong university"],["collection_date","2022-03-25T10:23:00Z"],["geo_loc_name","China"],["sex","female"],["tissue","peripheral blood"]],"runs":[{"run_accession":"SRR27475057","experiment_accession":"SRX23146491","library_layout":"PAIRED","library_selection":"RT-PCR","instrument_model":"Illumina NovaSeq 6000","read_count":21482237,"base_count":6444671100,"first_public":"2024-01-11","experiment_title":"Illumina NovaSeq 6000 sequencing: RNA-seq of cultured human B cellsperipheral blood of ITP patient No.1"}],"labels":[],"single_cell":false},{"sample_accession":"SAMN39324678","study_accession":"PRJNA1062870","blood_class":"blood_cells","class_from":"sample","title":"Human sample from Homo sapiens","description":"Human sample from Homo sapiens","sex":"female","geo_sample":"","access":"open","d