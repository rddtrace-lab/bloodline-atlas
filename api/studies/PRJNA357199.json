{"study_accession":"PRJNA357199","secondary_study_accession":"SRP095007","title":"mRNA expression levels in splenic human mononuclear cells of mock- and HIV-1-infected humanized mice","description":"Through RNA sequencing and gene ontology analyses, we report that immune activation is elicited in the spleen of 4 HIV-1-infected humanized mice when compared to 4 mock-infected humanized mice. Overall design: mRNA expression profiles in the splenic human mononuclear cells of HIV-1-infected humanized mice at 6 weeks post-infection (n=4) and mock-infected humanized mice (n=4) were generated by RNA sequencing. RNA was extracted using QIAamp RNA Blood Mini kit (Qiagen). RNA sequencing was conducted in Medical & Biological Laboratories, co (Nagoya, Japan).","pubmed":"28475648","geo_series":"","n_samples":8,"samples":[{"sample_accession":"SAMN06134723","study_accession":"PRJNA357199","blood_class":"pbmc","class_from":"study","title":"s224M5","description":"s224M5","sex":"","geo_sample":"GSM2424740","access":"open","dbgap":"","n_runs":1,"first_public":"2017-04-29","attributes":[["source_name","Humanized mouse"],["cell_type","Splenic mononuclar cells"],["compound","HIV-1 infected"],["timepoint","6 weeks post-infection"]],"runs":[{"run_accession":"SRR5100656","experiment_accession":"SRX2417162","library_layout":"SINGLE","library_selection":"cDNA","instrument_model":"Illumina HiSeq 2000","read_count":57374837,"base_count":2926116687,"first_public":"2017-04-29","experiment_title":"Illumina HiSeq 2000 sequencing: GSM2424740: s224M5 Homo sapiens RNA-Seq"}],"labels":[]},{"sample_accession":"SAMN06134724","study_accession":"PRJNA357199","blood_class":"pbmc","class_from":"study","title":"s136M2","description":"s136M2","sex":"","geo_sample":"GSM2424739","access":"open","dbgap":"","n_runs":1,"first_public":"2017-04-29","attributes":[["source_name","Humanized mouse"],["cell_type","Splenic mononuclar cells"],["compound","HIV-1 infected"],["timepoint","6 weeks post-infection"]],"runs":[{"ru