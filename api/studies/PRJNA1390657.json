{"study_accession":"PRJNA1390657","secondary_study_accession":"SRP656377","title":"High throughput sequencing of T cells from a patient undergoing immune checkpoint inhibitor therapy","description":"This is part of a prospective longitudinal study designed to identify biomarkers predictive of the onset of irAEs associated with ICI therapy and determine whether these biomarkers are further related to treatment efficacy. This experiment was a pilot study of T-cells from three visits of a single donor. Overall design: Cells were collected from a single donor across collected across three visits (pre-treatment, 20 days post therapy, and 62 days post therapy) for profiliing using 10X sequencing. Samples from the three visits were hashtagged and pooled and prepared across three 10X channels for a total of three gene expression sequencing libraries, 3 TCR libraries, and 3 feature barcode libraries.","pubmed":"","geo_series":"","n_samples":9,"samples":[{"sample_accession":"SAMN54187605","study_accession":"PRJNA1390657","blood_class":"pbmc","class_from":"sample","title":"FB channel 3","description":"FB channel 3","sex":"female","geo_sample":"GSM9392311","access":"open","dbgap":"","n_runs":1,"first_public":"2026-05-05","attributes":[["source_name","PBMC"],["cell_type","T cells"],["tissue","PBMC"],["treatment","Pembrolizumab"],["diagnosis","Urinary tract cancer"],["age","86"],["sex","female"],["geo_loc_name","missing"],["collection_date","missing"]],"runs":[{"run_accession":"SRR36501261","experiment_accession":"SRX31522426","library_layout":"PAIRED","library_selection":"cDNA","instrument_model":"NextSeq 2000","read_count":143890805,"base_count":12950172450,"first_public":"2026-05-05","experiment_title":"NextSeq 2000 sequencing: GSM9392311: FB channel 3 Homo sapiens RNA-Seq"}],"labels":[]},{"sample_accession":"SAMN54187606","study_accession":"PRJNA1390657","blood_class":"pbmc","class_from":"sample","title":"FB channel 2","description":"FB channel 2","sex":"female","geo_sample":