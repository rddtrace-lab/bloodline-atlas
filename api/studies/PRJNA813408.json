{"study_accession":"PRJNA813408","secondary_study_accession":"SRP362909","title":"Comprehensive genomic analysis of myeloid/natural killer cell precursor acute leukemia (MNKPL)","description":"Whole exome sequencing and whole genome sequencing were performed using DNA isolated from MNKPL to identify genomic landscape. To investigate expression profiles of MNKPL, RNA sequencing (RNA-seq) was performed using RNA isolated from MNKPL. To clarify the origin and heterogeneity of MNKPL, single cell RNA-seq was conducted using leukemia cells of MNKPL and bone marrow mononuclear cells and CD34 positive bone marrow cells of a healthy donor. Overall design: WES was performed using 18 samples in 13 cases (6 tumor/germline pairs, 6 tumor only sample). Whole genome sequencing was conducted in 6 cases. RNA-seq was performed in 6 cases. Single cell RNA-seq was performed in 2 MNKPL cases and 1 healthy donor.","pubmed":"38091391","geo_series":"","n_samples":7,"samples":[{"sample_accession":"SAMN26508489","study_accession":"PRJNA813408","blood_class":"bone_marrow","class_from":"sample","title":"MNKPL10 tumor RNA-seq","description":"MNKPL10 tumor RNA-seq","sex":"male","geo_sample":"GSM5935896","access":"open","dbgap":"","n_runs":1,"first_public":"2022-05-19","attributes":[["source_name","Bone marrow"],["sex","male"],["tissue","Bone marrow"],["subgroup","ETV6-WT"]],"runs":[{"run_accession":"SRR18260065","experiment_accession":"SRX14400805","library_layout":"PAIRED","library_selection":"cDNA","instrument_model":"Illumina HiSeq 1500","read_count":30639661,"base_count":6157419207,"first_public":"2022-05-19","experiment_title":"Illumina HiSeq 1500 sequencing: GSM5935896: MNKPL10 tumor RNA-seq Homo sapiens RNA-Seq"}],"labels":[]},{"sample_accession":"SAMN26508492","study_accession":"PRJNA813408","blood_class":"bone_marrow","class_from":"sample","title":"MNKPL9 tumor RNA-seq","description":"MNKPL9 tumor RNA-seq","sex":"female","geo_sample":"GSM5935893","access":"open","dbgap":"","n_runs":1,"f