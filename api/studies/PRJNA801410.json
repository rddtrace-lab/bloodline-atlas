{"study_accession":"PRJNA801410","secondary_study_accession":"SRP357115","title":"Screening and verification of differentially expressed long non-coding RNAs in the peripheral blood of patients with asthma","description":"Purpose: The goals of this study are to explore the differentially expressed long non-coding RNAs in the peripheral blood of patients with asthma. Methods: lncRNA and mRNA profiles of peripheral blood (human) were generated by deep sequencing. Results: There were 1137 differentially expressed lncRNAs in the asthma patients compared to in the healthy controls, of which 485 were upregulated and 652 were downregulated. Overall design: Second-generation high-throughput sequencing was performed on 4 patients and 3 healthy subjects' peripheral blood samples.","pubmed":"","geo_series":"","n_samples":7,"study_labels":[],"samples":[{"sample_accession":"SAMN25343068","study_accession":"PRJNA801410","blood_class":"whole_blood","class_from":"sample","title":"Asthma_rep4 [X15]","description":"Asthma_rep4 [X15]","sex":"female","geo_sample":"GSM5841560","access":"open","dbgap":"","n_runs":1,"first_public":"2022-01-31","attributes":[["source_name","Peripheral whole blood"],["subject status","patient with asthma"],["sex","female"],["age","38"],["body_mass_index","20.07"],["tissue","Peripheral whole blood"]],"runs":[{"run_accession":"SRR17794308","experiment_accession":"SRX13956478","library_layout":"PAIRED","library_selection":"cDNA","instrument_model":"Illumina HiSeq 2500","read_count":38766554,"base_count":11629966200,"first_public":"2022-01-31","experiment_title":"Illumina HiSeq 2500 sequencing: GSM5841560: Asthma_rep4 [X15] Homo sapiens RNA-Seq"}],"labels":[],"single_cell":false},{"sample_accession":"SAMN25343069","study_accession":"PRJNA801410","blood_class":"whole_blood","class_from":"sample","title":"Asthma_rep3 [X13]","description":"Asthma_rep3 [X13]","sex":"male","geo_sample":"GSM5841559","access":"open","dbgap":"","n_runs":1,"first_public":"2022-01-31","a