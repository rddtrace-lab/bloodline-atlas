{"study_accession":"PRJNA633893","secondary_study_accession":"SRP271113","title":"Human primary macrophages infected with Leishmania and exposed to pentavalent antimonials","description":"In the context of a study aimed at investigating whether macrophage mechanisms of xenobiotic detoxification contribute to drug-dependent elimination of intracellular Leishmania, we have carried out transcriptome profiling (RNA-Seq) of primary macrophages collected from American cutaneous leishmaniasis (CL) patients and subsequently infected with Leishmania and exposed to pentavalent antimonials (SbV) in vitro. The results from this study highlight the participation of macrophage metallothioneins in Sb-dependent parasite killing, revealing novel strategies for host-targeted optimization of antileishmanial drugs.","pubmed":"","geo_series":"","n_samples":12,"samples":[{"sample_accession":"SAMN15482222","study_accession":"PRJNA633893","blood_class":"whole_blood","class_from":"sample","title":"d202_none_24h","description":"d202_none_24h","sex":"male","geo_sample":"","access":"open","dbgap":"","n_runs":1,"first_public":"2020-07-10","attributes":[["isolate","d202"],["age","60"],["biomaterial_provider","Centro Internacional de Entrenamiento e Investigaciones Medicas (CIDEIM), Cali, Colombia"],["sex","male"],["tissue","Whole blood"],["cell_type","Macrophage"],["sample_type","Cell culture"],["treatment","Control"],["unique identifier","HPGL0315"]],"runs":[{"run_accession":"SRR12185387","experiment_accession":"SRX8699922","library_layout":"PAIRED","library_selection":"RANDOM","instrument_model":"Illumina HiSeq 1500","read_count":47981577,"base_count":9614279020,"first_public":"2020-07-10","experiment_title":"Illumina HiSeq 1500 sequencing: HPGL0315"}],"labels":[],"single_cell":false},{"sample_accession":"SAMN15482223","study_accession":"PRJNA633893","blood_class":"whole_blood","class_from":"sample","title":"d202_Lp_SbV_24h","description":"d202_Lp_SbV_24h","sex":"male","geo_sample":"","access"