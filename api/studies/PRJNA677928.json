{"study_accession":"PRJNA677928","secondary_study_accession":"SRP292321","title":"Single-cell RNA sequencing analysis of blood B cells from human allogeneic hematopoietic transplant patients","description":"Single cell analysis of gene expression in blood B cells from allogeneic hematopoietic stem cell transpant (HCT) patients that either developed chronic GVHD, or never developed chronic GVHD. Overall design: B cells were purified from viably cryopreserved PBMC samples of de-identified HCT patients by magnetic bead negative sorting (Miltenyi Human B Cell Isolation Kit II). Following an 18h culture period as resting B cells or ATRA-treated B cells, dead cells were eliminated (STEMCELL Technologies Dead Cell Removal Kit) and the samples immediately submitted for single-cell RNA-Seq library preparation (Duke Molecular Genomics Core).","pubmed":"37129971","geo_series":"","n_samples":16,"samples":[{"sample_accession":"SAMN16779416","study_accession":"PRJNA677928","blood_class":"blood_cells","class_from":"sample","title":"No chronic GVHD patient 2, Untreated","description":"No chronic GVHD patient 2, Untreated","sex":"","geo_sample":"GSM4905092","access":"open","dbgap":"","n_runs":4,"first_public":"2023-06-05","attributes":[["source_name","Peripheral blood B cells"],["cell_type","Peripheral blood B cells"],["treatment","untreated"],["disease","No chronic GVHD"]],"runs":[{"run_accession":"SRR13041645","experiment_accession":"SRX9491572","library_layout":"PAIRED","library_selection":"cDNA","instrument_model":"Illumina NovaSeq 6000","read_count":177545025,"base_count":17399412450,"first_public":"2023-06-05","experiment_title":"Illumina NovaSeq 6000 sequencing: GSM4905092: No chronic GVHD patient 2, Untreated Homo sapiens RNA-Seq"},{"run_accession":"SRR13041646","experiment_accession":"SRX9491572","library_layout":"PAIRED","library_selection":"cDNA","instrument_model":"Illumina NovaSeq 6000","read_count":176017341,"base_count":17249699418,"first_public":"2023-06-05","experim