{"study_accession":"PRJNA735729","secondary_study_accession":"SRP323042","title":"RNA sequencing of blood monocyte subsets in COVID patients","description":"We report mRNA expression profiles of blood monocyte subsets in COVID patients with comparison to non-COVD samples. COVID patients were grouped into mild without hospitalization and ICU without ventilation. Monocytes were FACS sorted based on CD14 and CD16 expression, generating classical CD14+CD16- monocytes and CD16+CD14+/++ nonclassical monocytes. The mRNA expression comparison demonstrates a strong response to viral infection and suggests a defect in nonclassical monocytes maturation. It also provides several biomarkers for prognosis purposes, including CD55 and CD81. Overall design: Examination of mRNA expression profiles in blood monocyte subsets in COVID patients.","pubmed":"34032853","geo_series":"","n_samples":30,"samples":[{"sample_accession":"SAMN19594754","study_accession":"PRJNA735729","blood_class":"pbmc","class_from":"sample","title":"CD14 monocytes [28]","description":"CD14 monocytes [28]","sex":"","geo_sample":"GSM5362287","access":"open","dbgap":"","n_runs":1,"first_public":"2021-06-26","attributes":[["source_name","Peripheral blood mononuclear cells"],["diagnosis","Non-COVID"],["cell_type","CD14 monocytes"]],"runs":[{"run_accession":"SRR14749987","experiment_accession":"SRX11083686","library_layout":"PAIRED","library_selection":"cDNA","instrument_model":"Illumina NovaSeq 6000","read_count":35701682,"base_count":10781907964,"first_public":"2021-06-26","experiment_title":"Illumina NovaSeq 6000 sequencing: GSM5362287: CD14 monocytes [28] Homo sapiens RNA-Seq"}],"labels":[]},{"sample_accession":"SAMN19594755","study_accession":"PRJNA735729","blood_class":"pbmc","class_from":"sample","title":"CD14 monocytes [27]","description":"CD14 monocytes [27]","sex":"","geo_sample":"GSM5362286","access":"open","dbgap":"","n_runs":1,"first_public":"2021-06-26","attributes":[["source_name","Peripheral blood mono