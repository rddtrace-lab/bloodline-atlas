{"study_accession":"PRJNA183943","secondary_study_accession":"SRP017580","title":"The effect of nicotinamide on dysregulated genes associated with frataxin deficiency in FRDA.","description":"To investigate the efficacy of nicotinamide treatment using our ex-vivo primary lymphocyte model, we performed high-throughput RNA sequencing on libraries generated from untreated and nicotinamide treated samples. Overall design: PBMC isolated from FRDA affected individuals were cultured to prepare the primary lymphocyte cell lines. The primary cultured cells were either treated with 10mM nicotinamide or without the addition of drug during the 3-days treatment. RNA was extracted after the treatment and then RNA-seq libraries were generated by standard protocols.","pubmed":"23474817","geo_series":"","n_samples":4,"samples":[{"sample_accession":"SAMN01831455","study_accession":"PRJNA183943","blood_class":"pbmc","class_from":"sample","title":"GSM1054021: FRDA05-UT","description":"source: primary cultured lymphocytes","sex":"","geo_sample":"GSM1054021","access":"open","dbgap":"","n_runs":1,"first_public":"2013-05-05","attributes":[["GEO Accession","GSM1054021"],["tissue","PBMC"],["treatment","Un-treated control"]],"runs":[{"run_accession":"SRR633901","experiment_accession":"SRX210736","library_layout":"PAIRED","library_selection":"cDNA","instrument_model":"Illumina HiSeq 2000","read_count":22419833,"base_count":4483966600,"first_public":"2013-05-05","experiment_title":"Illumina HiSeq 2000 sequencing: GSM1054021: FRDA05-UT Homo sapiens RNA-Seq"}],"labels":[],"single_cell":false},{"sample_accession":"SAMN01831456","study_accession":"PRJNA183943","blood_class":"pbmc","class_from":"sample","title":"GSM1054022: FRDA05-Nico","description":"source: primary cultured lymphocytes","sex":"","geo_sample":"GSM1054022","access":"open","dbgap":"","n_runs":1,"first_public":"2013-05-05","attributes":[["GEO Accession","GSM1054022"],["tissue","PBMC"],["treatment","10mM nicotinamide"]],"runs":[{"run_a