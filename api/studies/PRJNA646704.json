{"study_accession":"PRJNA646704","secondary_study_accession":"SRP272244","title":"Single cell RNAseq reveal covid19 patient immune response","description":"Eighteen patients admitted to CSMC and diagnosed with COVID19 by RT-PCR were stratified into COVID19 mild/moderate, severe, and recovery groups (n=5-6/group). Venous blood was collected into EDTA coated tubes and centrifuged to separate plasma and buffy coat. Plasma was collected and frozen at -80C, and the buffy coat was collected into cryo-preservation media and frozen at -80C. Recovered cells are sorted for live-dead staining, then fixed with methanol. Fixed single cells were further captured using 10x chromium Next GEM 3 prime v3.1 kit. Two patients samples from the same group were mixed, captured and sequenced together. Overall design: single-cell RNA-seq of blood buffy coat from COVID-19 patients.","pubmed":"32743611;33357411","geo_series":"","n_samples":9,"samples":[{"sample_accession":"SAMN15557074","study_accession":"PRJNA646704","blood_class":"blood_cells","class_from":"sample","title":"CR17_CR18","description":"CR17_CR18","sex":"","geo_sample":"GSM4674669","access":"open","dbgap":"","n_runs":1,"first_public":"2020-09-30","attributes":[["source_name","Recovered COVID19 Patient"],["tissue","Blood Buffy coat"],["patient diagnosis","COVID-19"],["group","Recover"],["type of library","expression"],["subject id","sample contains cells from two patients: CR17, CR18"]],"runs":[{"run_accession":"SRR12236943","experiment_accession":"SRX8745282","library_layout":"PAIRED","library_selection":"cDNA","instrument_model":"Illumina NovaSeq 6000","read_count":293902807,"base_count":26745155437,"first_public":"2020-09-30","experiment_title":"Illumina NovaSeq 6000 sequencing: GSM4674669: CR17_CR18 Homo sapiens RNA-Seq"}],"labels":[]},{"sample_accession":"SAMN15557075","study_accession":"PRJNA646704","blood_class":"blood_cells","class_from":"sample","title":"CR15_CR16","description":"CR15_CR16","sex":"","geo_sample":"GSM467