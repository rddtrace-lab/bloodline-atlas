{"study_accession":"PRJEB97080","secondary_study_accession":"ERP179669","title":"scRNAseq profiling of severe vs moderate MS patient","description":"To better understand MS immune mechanisms, the research team performed single-cell RNA sequencing (scRNA-seq) on peripheral blood mononuclear cells (PBMC) from RRMS patients. Samples were taken during the first inflammatory relapse, before treatment. Patients were followed for two years and classified into severe MS (S-MS) or moderate MS (M-MS) based on clinical management criteria, particularly the use of HET for S-MS, versus no treatment or MET for M-MS. The main objective of this study is to identify early prognostic markers detectable from the first demyelinating event, with the aim of guiding personalized therapeutic strategies and limiting the accumulation of irreversible lesions. ","pubmed":"","geo_series":"","n_samples":12,"study_labels":[],"samples":[{"sample_accession":"SAMEA120122163","study_accession":"PRJEB97080","blood_class":"pbmc","class_from":"sample","title":"DL007_scRNA1_S1.fastq.gz","description":"PBMC sample","sex":"","geo_sample":"","access":"open","dbgap":"","n_runs":2,"first_public":"2025-09-13","attributes":[["ENA-CHECKLIST","ERC000011"],["organism","Homo sapiens"],["collection date","2017-11-27/2020-09-20"],["scientific_name","Homo sapiens"],["common name","human"],["geographic location (country and/or sea)","France"]],"runs":[{"run_accession":"ERR15564226","experiment_accession":"ERX14967764","library_layout":"PAIRED","library_selection":"cDNA","instrument_model":"Illumina NovaSeq 6000","read_count":451067164,"base_count":27515097004,"first_public":"2025-09-13","experiment_title":"Illumina NovaSeq 6000 sequencing"},{"run_accession":"ERR15564227","experiment_accession":"ERX14967765","library_layout":"PAIRED","library_selection":"cDNA","instrument_model":"Illumina NovaSeq 6000","read_count":446258252,"base_count":27221753372,"first_public":"2025-09-13","experiment_title":"Illumina NovaSeq 6000 s