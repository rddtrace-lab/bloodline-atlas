{"study_accession":"PRJNA1024653","secondary_study_accession":"SRP464854","title":"Plasma cell-free mRNA profiling of Vietnamese Alzheimer's patients","description":"Circulating cell-free RNA (cfRNA) is a potential hallmark for early diagnosis of Alzheimer's Disease (AD) as it construes the genetic expression level, giving insights into the pathological progress at the outset. Profiles of cfRNA in Caucasian AD patients have been investigated thoroughly, yet there was no report inspecting changes in the ASEAN groups. This study examined the gap, expecting to support the development of point-of-care AD diagnosis.","pubmed":"","geo_series":"","n_samples":20,"study_labels":[],"samples":[{"sample_accession":"SAMN37701975","study_accession":"PRJNA1024653","blood_class":"plasma_serum_cfrna","class_from":"sample","title":"Human sample from Homo sapiens","description":"Human sample from Homo sapiens","sex":"male","geo_sample":"","access":"open","dbgap":"","n_runs":1,"first_public":"2023-12-24","attributes":[["isolate","C01"],["age","60"],["biomaterial_provider","University Medical Center, Ho Chi Minh City"],["collection_date","2022-07-01"],["geo_loc_name","Viet Nam"],["sex","male"],["tissue","plasma"]],"runs":[{"run_accession":"SRR26301717","experiment_accession":"SRX22010197","library_layout":"PAIRED","library_selection":"other","instrument_model":"DNBSEQ-G400","read_count":32360429,"base_count":6148481510,"first_public":"2023-12-24","experiment_title":"DNBSEQ-G400 sequencing: RNA-Seq of homo sapiens: plasma"}],"labels":[],"single_cell":false},{"sample_accession":"SAMN37701976","study_accession":"PRJNA1024653","blood_class":"plasma_serum_cfrna","class_from":"sample","title":"Human sample from Homo sapiens","description":"Human sample from Homo sapiens","sex":"female","geo_sample":"","access":"open","dbgap":"","n_runs":1,"first_public":"2023-12-24","attributes":[["isolate","C02"],["age","61"],["biomaterial_provider","University Medical Center, Ho Chi Minh City"],["collection