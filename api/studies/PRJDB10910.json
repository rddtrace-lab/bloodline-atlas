{"study_accession":"PRJDB10910","secondary_study_accession":"DRP006807","title":"TCR clonality analysis of intra-articular CD4 T cells in patients with rheumatoid arthritis","description":"Recently, a subset of CD4 T cells that express high levels of programmed death-1 (PD-1) have been specifically identified in the joints of patients with rheumatoid arthritis and named peripheral helper T cells (Tph). Since PD-1 is expressed on T cells chronically stimulated with the antigens, we compared the sequences of TCR Vb chains of PD-1 high CD4T cells, PD-1 low/neg CD4T cells in the synovial fluid and peripheral blood memory CD4T cells of patients with rheumatoid arthritis.","pubmed":"","geo_series":"","n_samples":3,"samples":[{"sample_accession":"SAMD00261452","study_accession":"PRJDB10910","blood_class":"blood_cells","class_from":"sample","title":"patient 1 PB CD45RA-CD4Tcell","description":"patient 1 PB CD45RA-CD4Tcell","sex":"female","geo_sample":"","access":"open","dbgap":"","n_runs":1,"first_public":"2021-01-04","attributes":[["isolate","patient 1 KSS013b"],["INSDC secondary accession","DRS165968"],["NCBI submission package","Generic.1.0"],["organism","Homo sapiens"],["sex","female"],["tissue","blood"],["cell_type","human T cells"],["age","65"],["biomaterial_provider","kyushu university hospital"],["sample_name","patient 1 KSS013b"],["BioSampleModel","Generic"],["ENA-FIRST-PUBLIC","2020-12-16"],["ENA-LAST-UPDATE","2020-12-16"]],"runs":[{"run_accession":"DRR258773","experiment_accession":"DRX248488","library_layout":"PAIRED","library_selection":"PCR","instrument_model":"Illumina MiSeq","read_count":402597,"base_count":242363394,"first_public":"2021-01-04","experiment_title":"Illumina MiSeq paired end sequencing: Illumina MiSeq paired end sequencing of SAMD00261452"}],"labels":[],"single_cell":false},{"sample_accession":"SAMD00261455","study_accession":"PRJDB10910","blood_class":"blood_cells","class_from":"sample","title":"patient 2 PB CD45RA-CD4Tcell","description":"pa