{"study_accession":"PRJNA1526233","secondary_study_accession":"SRP735089","title":"Bulk RNA sequencing of CD8+ STAR-T cells with p52 overexpression before and after antigen stimulation","description":"This project contains bulk RNA sequencing data from human CD8+ T cells engineered with an EGFR-targeting synthetic T cell receptor and antigen receptor (STAR), with or without co-expression of the non-canonical NF-kB transcription factor p52. STAR-T and p52-STAR-T cells were analyzed before and after antigen stimulation by coculture with target tumor cells. The study was designed to characterize transcriptional changes associated with p52-mediated enhancement of non-canonical NF-kB signaling and to investigate molecular programs related to T cell persistence, survival, exhaustion, and antitumor function.","pubmed":"","geo_series":"","n_samples":10,"samples":[{"sample_accession":"SAMN63034568","study_accession":"PRJNA1526233","blood_class":"whole_blood","class_from":"sample","title":"Human sample from Homo sapiens","description":"Human sample from Homo sapiens","sex":"not collected","geo_sample":"","access":"open","dbgap":"","n_runs":1,"first_public":"2026-10-03","attributes":[["isolate","Donor 1"],["age","not collected"],["biomaterial_provider","Department of Hematology, Peking University People's Hospital"],["collection_date","not collected"],["geo_loc_name","China: Beijing"],["sex","not collected"],["tissue","Blood"],["treatment","Resting"],["construct","STAR"]],"runs":[{"run_accession":"SRR40584298","experiment_accession":"SRX35170942","library_layout":"PAIRED","library_selection":"PolyA","instrument_model":"Illumina HiSeq 2500","read_count":0,"base_count":0,"first_public":"2026-10-03","experiment_title":"Illumina HiSeq 2500 sequencing: Resting STAR Donor 1"}],"labels":[],"single_cell":false},{"sample_accession":"SAMN63034569","study_accession":"PRJNA1526233","blood_class":"whole_blood","class_from":"sample","title":"Human sample from Homo sapiens","description":"Hu