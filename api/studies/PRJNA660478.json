{"study_accession":"PRJNA660478","secondary_study_accession":"SRP279502","title":"BMPR2 Regulates Hypoxic Exosome Signaling to Maintain Vascular Homeostasis","description":"Endothelial cells (EC) sense stimuli in the circulation and release responsive signaling molecules to coordinate the multicellular adaptations required to maintain vascular homeostasis. The goal of this study were to analyze the transcriptional changes induced by hypoxia in control donor pulmonary arterial endothelial cells and the effect of loss of BMPR2 that is associated with pulmonary arterial hypertension. Overall design: 24 samples analyzed, 2 biolgoical and 2 technical replicates, siBMPR2 or siControl treated, 3 timepoints of hypoxia treatment (0, 6, 24 hours).","pubmed":"","geo_series":"","n_samples":24,"samples":[{"sample_accession":"SAMN15950569","study_accession":"PRJNA660478","blood_class":"plasma_serum_cfrna","class_from":"study","title":"siCNTRL_6h_hypoxia_patient_2_replicate_2","description":"siCNTRL_6h_hypoxia_patient_2_replicate_2","sex":"","geo_sample":"GSM4759547","access":"open","dbgap":"","n_runs":1,"first_public":"2020-09-02","attributes":[["source_name","Pulmonary Artery"],["cell_type","Endothelial Cell"],["treatment 1","siCNTRL"],["treatment 2","6h Hypoxia"]],"runs":[{"run_accession":"SRR12558758","experiment_accession":"SRX9047230","library_layout":"PAIRED","library_selection":"cDNA","instrument_model":"Illumina HiSeq 2000","read_count":4939751,"base_count":997829702,"first_public":"2020-09-02","experiment_title":"Illumina HiSeq 2000 sequencing: GSM4759547: siCNTRL_6h_hypoxia_patient_2_replicate_2 Homo sapiens RNA-Seq"}],"labels":[]},{"sample_accession":"SAMN15950570","study_accession":"PRJNA660478","blood_class":"plasma_serum_cfrna","class_from":"study","title":"siCNTRL_6h_hypoxia_patient_2_replicate_1","description":"siCNTRL_6h_hypoxia_patient_2_replicate_1","sex":"","geo_sample":"GSM4759546","access":"open","dbgap":"","n_runs":1,"first_public":"2020-09-02","attributes"