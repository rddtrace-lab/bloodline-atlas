{"study_accession":"PRJNA1040192","secondary_study_accession":"SRP471822","title":"Label-free single-cell RNA Multiplexing leveraging genetic variability [bulk RNA-seq]","description":"Single cell RNA sequencing has enabled unprecedented insights into the molecular cues and cellular heterogeneity underlying human disease. However, the high costs and complexity of single cell methods remain a major obstacle for generating large scale human cohorts. Here we compare current state-of-the-art single cell multiplexing technologies, and provide a new widely applicable demultiplexing method, SNP-Fishing, that enables simple, robust high-throughput multiplexing leveraging genetic variability of patients. Overall design: Matching RNA-seq of the pooled single-cell RNA-seq experiments","pubmed":"39638798","geo_series":"","n_samples":5,"samples":[{"sample_accession":"SAMN38252458","study_accession":"PRJNA1040192","blood_class":"pbmc","class_from":"sample","title":"PBMC_bulkRNA-seq Patient_5","description":"PBMC_bulkRNA-seq Patient_5","sex":"","geo_sample":"GSM7899147","access":"open","dbgap":"","n_runs":1,"first_public":"2024-09-29","attributes":[["source_name","PBMC"],["tissue","PBMC"],["subject id","Patient_5"],["geo_loc_name","missing"],["collection_date","missing"]],"runs":[{"run_accession":"SRR26826524","experiment_accession":"SRX22523174","library_layout":"PAIRED","library_selection":"cDNA","instrument_model":"Illumina NovaSeq 6000","read_count":25239148,"base_count":2574393096,"first_public":"2024-09-29","experiment_title":"Illumina NovaSeq 6000 sequencing: GSM7899147: PBMC_bulkRNA-seq Patient_5 Homo sapiens RNA-Seq"}],"labels":[],"single_cell":true},{"sample_accession":"SAMN38252459","study_accession":"PRJNA1040192","blood_class":"pbmc","class_from":"sample","title":"PBMC_bulkRNA-seq Patient_4","description":"PBMC_bulkRNA-seq Patient_4","sex":"","geo_sample":"GSM7899146","access":"open","dbgap":"","n_runs":1,"first_public":"2024-09-29","attributes":[["source_name","PBMC"