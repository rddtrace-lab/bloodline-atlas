{"study_accession":"PRJNA967339","secondary_study_accession":"SRP435972","title":"Directional endothelial communication by polarized extracellular vesicle release","description":"EVs were isolated from primary human aortic endothelial cells (ECs) (+/- IL-1b activation), quantified, and analysed by miRNA transcriptomics and proteomics. Compared to quiescent ECs, activated ECs increased EV release, with miRNA and protein cargo that were related to atherosclerosis pathways. RNA sequencing of EV-treated monocytes and vascular smooth muscle cells (VSMCs) revealed that EVs from activated ECs altered pathways that were pro-inflammatory and atherogenic. Overall design: We performed gene expression profiling analysis on CD14 monocytes and HASMCs treated with media only, quiescent, or activated endothelial extracellular vesicles.","pubmed":"28585919;38174557","geo_series":"","n_samples":9,"samples":[{"sample_accession":"SAMN34588778","study_accession":"PRJNA967339","blood_class":"plasma_serum_cfrna","class_from":"study","title":"HASMC_ActivatedEVs_3","description":"HASMC_ActivatedEVs_3","sex":"","geo_sample":"GSM7297245","access":"open","dbgap":"","n_runs":1,"first_public":"2024-01-04","attributes":[["source_name","primary cells"],["tissue","primary cells"],["cell_type","Human Aortic Smooth Muscle Cells (HASMCs)"],["treatment","Activated endothelial EVs"],["geo_loc_name","missing"],["collection_date","missing"]],"runs":[{"run_accession":"SRR24437607","experiment_accession":"SRX20225056","library_layout":"PAIRED","library_selection":"cDNA","instrument_model":"Illumina NovaSeq 6000","read_count":31128632,"base_count":9338589600,"first_public":"2024-01-04","experiment_title":"Illumina NovaSeq 6000 sequencing: GSM7297245: HASMC_ActivatedEVs_3 Homo sapiens RNA-Seq"}],"labels":[]},{"sample_accession":"SAMN34588779","study_accession":"PRJNA967339","blood_class":"plasma_serum_cfrna","class_from":"study","title":"HASMC_ActivatedEVs_2","description":"HASMC_ActivatedEVs_2","sex":"","geo